<dropdown-list
  focus-only
  list-title="{{ 'localization.language_label' | t }}"
  class="{{ class }}"
  offset="16"
  offset-cross="{{ offsetCross | default: "-24" }}"
  placement="{{ placement | default: "bottom-start" }}"
>
  <details class="relative">
    <summary class="flex items-center" data-dropdown-activator>
      <div class="header-icon-btn language-selector-trigger" aria-hidden="true">
        <svg
          class="icon-globe"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
        >
          <circle
            cx="12"
            cy="12"
            r="9"
            stroke="currentColor"
            stroke-width="var(--icon-stroke-width, 2)"
            vector-effect="non-scaling-stroke"
          />
          <path
            d="M3 12H21"
            stroke="currentColor"
            stroke-width="var(--icon-stroke-width, 2)"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />
          <path
            d="M12 3C14.5 5.5 16 8.6 16 12C16 15.4 14.5 18.5 12 21"
            stroke="currentColor"
            stroke-width="var(--icon-stroke-width, 2)"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />
          <path
            d="M12 3C9.5 5.5 8 8.6 8 12C8 15.4 9.5 18.5 12 21"
            stroke="currentColor"
            stroke-width="var(--icon-stroke-width, 2)"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />
        </svg>
      </div>

      <div class="collapse-chevron w-3 {{ collapse_spacing_class | default: 'ml-2' }}">
        {% render 'icon-chevron' %}
      </div>
    </summary>

    <div class="dropdown-menu py-2 locale-selector-dropdown locale-selector-dropdown--language">
      <div class="dropdown-list dropdown-list--small">
        {% render 'language-selector', label: false %}
      </div>
    </div>
  </details>
</dropdown-list>