{%- comment -%}
  Product detail accordions

  Benötigte Parameter:
  - product
  - section
  - delivery_content
{%- endcomment -%}

<div class="pda-accordions">

  {%- comment -%}
    1. Highlights / USPs
    Standardmäßig geöffnet
  {%- endcomment -%}

  {%- if product.metafields.custom.kurzinfo != blank -%}
    <details class="pda-accordion pda-accordion--highlights" open>
      <summary class="pda-accordion__summary">
        <span class="pda-accordion__title">
          Highlights
        </span>

        <span class="pda-accordion__icon" aria-hidden="true">
          <svg
            viewBox="0 0 12 8"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            focusable="false"
          >
            <path
              d="M1 1.25L6 6.25L11 1.25"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </summary>

      <div class="pda-accordion__content pda-accordion__content--highlights">
        {{ product.metafields.custom.kurzinfo | metafield_tag }}
      </div>
    </details>
  {%- endif -%}


  {%- comment -%}
    2. Produktempfehlungen

    Quelle:
    Shopify Search & Discovery – komplementäre Produkte.
    Diese werden als Standard-Metafeld gespeichert:
    shopify--discovery--product_recommendation.complementary_products

    Wichtig:
    Wir lesen das Metafeld direkt aus, statt die Product Recommendations API
    zu verwenden. Dadurch bleiben auch aktuell nicht verfügbare / ausverkaufte
    Produkte in der gepflegten Liste erhalten.
  {%- endcomment -%}

  {%- assign pda_complementary_metafield = product.metafields['shopify--discovery--product_recommendation']['complementary_products'] -%}
  {%- assign pda_complementary_products = pda_complementary_metafield.value -%}

  <details class="pda-accordion pda-accordion--recommendations">
    <summary class="pda-accordion__summary">
      <span class="pda-accordion__title">
        Produktempfehlungen
      </span>

      <span class="pda-accordion__icon" aria-hidden="true">
        <svg
          viewBox="0 0 12 8"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          focusable="false"
        >
          <path
            d="M1 1.25L6 6.25L11 1.25"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
    </summary>

    <div class="pda-accordion__content pda-accordion__content--recommendations">
      <div class="pda-product-recommendations">

        {%- if pda_complementary_products != blank -%}

          {%- capture pda_recommendation_items -%}
            {%- assign pda_rendered_products = 0 -%}

            {%- for recommendation in pda_complementary_products limit: 10 -%}
              {%- unless recommendation.tags contains 'globo-product-options' -%}
                <div class="pda-recommendation-card{% unless recommendation.available %} pda-recommendation-card--sold-out{% endunless %}">
                  {% render 'product-card',
  card_product: recommendation,
  sizes: '(max-width: 749px) 50vw, 180px',
  pda_price: true
%}
                </div>

                {%- assign pda_rendered_products = pda_rendered_products | plus: 1 -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endcapture -%}

          {%- if pda_rendered_products > 0 -%}
            <div
              class="pda-recommendations-slider"
              data-pda-slider
              data-product-count="{{ pda_rendered_products }}"
            >
              {%- if pda_rendered_products > 2 -%}
                <button
                  type="button"
                  class="pda-slider-arrow pda-slider-arrow--prev"
                  aria-label="Vorherige Produktempfehlungen"
                  data-pda-slider-prev
                  disabled
                >
                  <svg
                    viewBox="0 0 12 20"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <path
                      d="M10 2L2 10L10 18"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
              {%- endif -%}

              <div class="pda-recommendations-viewport" data-pda-slider-viewport>
                <div class="pda-recommendations-track">
                  {{ pda_recommendation_items }}
                </div>
              </div>

              {%- if pda_rendered_products > 2 -%}
                <button
                  type="button"
                  class="pda-slider-arrow pda-slider-arrow--next"
                  aria-label="Weitere Produktempfehlungen"
                  data-pda-slider-next
                >
                  <svg
                    viewBox="0 0 12 20"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <path
                      d="M2 2L10 10L2 18"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
              {%- endif -%}
            </div>
          {%- else -%}
            <p class="pda-recommendations-empty">
              Für dieses Produkt sind derzeit keine Empfehlungen vorhanden.
            </p>
          {%- endif -%}

        {%- else -%}
          <p class="pda-recommendations-empty">
            Für dieses Produkt sind derzeit keine Empfehlungen vorhanden.
          </p>
        {%- endif -%}

      </div>
    </div>
  </details>


  {%- comment -%}
    3. Lieferzeitpunkt
    delivery_content wird beim Rendern des Snippets übergeben.
  {%- endcomment -%}

  {%- if delivery_content != blank -%}
    <details class="pda-accordion pda-accordion--delivery">
      <summary class="pda-accordion__summary">
        <span class="pda-accordion__title">
          Lieferung voraussichtlich bis
          <strong>{{ delivery_content }}</strong>
        </span>

        <span class="pda-accordion__icon" aria-hidden="true">
          <svg
            viewBox="0 0 12 8"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            focusable="false"
          >
            <path
              d="M1 1.25L6 6.25L11 1.25"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </summary>

      <div class="pda-accordion__content pda-accordion__content--delivery">
        <p>
          Die Lieferung erfolgt voraussichtlich bis
          <strong>{{ delivery_content }}</strong>.
        </p>
      </div>
    </details>
  {%- endif -%}


  {%- comment -%}
    4. TARGOBANK Ratenkauf – Konditionen analog Checkout-Erweiterung
  {%- endcomment -%}
  <details class="pda-accordion pda-accordion--targobank">
    <summary class="pda-accordion__summary">
      <span class="pda-accordion__title pda-targo__summary-title">
        <span class="pda-targo__wordmark" aria-label="TARGOBANK"><span>TARGO</span><span>BANK</span></span>
        <span class="pda-targo__summary-subtitle" data-pda-targo-rate="{{ product.id }}">Ratenkauf ab 99 € Warenkorb</span>
      </span>
      <span class="pda-accordion__icon" aria-hidden="true">
        <svg viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <path d="M1 1.25L6 6.25L11 1.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </summary>
    <div class="pda-accordion__content pda-targo__content">
      <h3 class="pda-targo__heading">Erfülle dir deinen Wunsch – ganz einfach finanzieren</h3>
      <p>Gemeinsam mit unserem Finanzierungspartner TARGOBANK ermöglichen wir dir eine bequeme Finanzierung in monatlichen Raten – für Warenkörbe ab 99,00 €.</p>
      <h4 class="pda-targo__subheading">Unsere Finanzierungskonditionen</h4>
      <div class="pda-targo__table-scroll">
        <table class="pda-targo__table">
          <thead><tr><th scope="col">Laufzeit</th><th scope="col">Effektiver Jahreszins</th></tr></thead>
          <tbody>
            <tr><td>6–12 Monate</td><td>5,90 %</td></tr>
            <tr><td>15–21 Monate</td><td>6,90 %</td></tr>
            <tr><td>24–30 Monate</td><td>7,90 %</td></tr>
            <tr><td>33–36 Monate</td><td>8,90 %</td></tr>
          </tbody>
        </table>
      </div>
      <p class="pda-targo__de-only"><strong>Nur innerhalb Deutschlands verfügbar.</strong> Finanzierung ab 99,00 € Warenkorbwert und vorbehaltlich der Prüfung durch die TARGOBANK.</p>
      <h4 class="pda-targo__subheading">Deine Vorteile</h4>
      <ul class="pda-targo__benefits">
        <li>Flexible Laufzeiten von 6 bis 36 Monaten</li>
        <li>Übersichtliche monatliche Raten</li>
        <li>Finanzierungsantrag online abschließen</li>
      </ul>
      <div class="pda-targo__howto">
        <strong>So einfach funktioniert die Finanzierung</strong>
        <p>Wähle an der Kasse einfach die Zahlungsart <strong>TARGOBANK Finanzierung</strong> und folge den weiteren Schritten. Nach Abschluss deiner Bestellung gelangst du zum Finanzierungsantrag der TARGOBANK.</p>
      </div>
      <p class="pda-targo__legal">Die Finanzierung erfolgt vorbehaltlich der Prüfung und Genehmigung durch die TARGOBANK. Die Angaben sind unverbindlich; maßgeblich sind die Konditionen im individuellen Finanzierungsangebot. Eine monatliche Mindestrate kann gelten.</p>
    </div>
  </details>

</div>
<style>

  /* Einheitliche kleine Schrift in allen vier Accordion-Kopfzeilen */
  .pda-accordions .pda-accordion > .pda-accordion__summary .pda-accordion__title,
  .pda-accordions .pda-accordion > .pda-accordion__summary .pda-accordion__title strong {
    font-size: 12px !important;
    line-height: 1.4 !important;
  }
  /* Einheitliche Typografie fuer Highlights-Listen und Lieferzeit */
  .pda-accordions .pda-accordion--highlights .pda-accordion__content--highlights,
  .pda-accordions .pda-accordion--highlights .pda-accordion__content--highlights ul,
  .pda-accordions .pda-accordion--highlights .pda-accordion__content--highlights ol,
  .pda-accordions .pda-accordion--highlights .pda-accordion__content--highlights li,
  .pda-accordions .pda-accordion--highlights .pda-accordion__content--highlights li *,
  .pda-accordions .pda-accordion--delivery > .pda-accordion__summary,
  .pda-accordions .pda-accordion--delivery > .pda-accordion__summary .pda-accordion__title,
  .pda-accordions .pda-accordion--delivery > .pda-accordion__summary .pda-accordion__title *,
  .pda-accordions .pda-accordion--delivery .pda-accordion__content--delivery,
