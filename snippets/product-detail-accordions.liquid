  .pda-product-recommendations,
  .pda-recommendations-slider {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden !important;
  }

  .pda-recommendations-viewport {
    width: 100%;
    max-width: 100%;
    overflow-x: auto !important;
