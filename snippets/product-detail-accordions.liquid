  .pda-accordion--targobank .pda-targo__wordmark span:first-child { color: #003b70; }
  .pda-accordion--targobank .pda-targo__wordmark span:last-child { color: #c61c48; }
  .pda-accordion--targobank .pda-targo__summary-subtitle {
