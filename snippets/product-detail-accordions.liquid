</style>

<script>
  (function () {
    var productId = {{ product.id | json }};
    var priceCents = {{ product.selected_or_first_available_variant.price | json }};
    var variants = {{ product.variants | json }};
    var rateElement = document.querySelector('[data-pda-targo-rate="' + productId + '"]');
    if (!rateElement) return;

    var cartTotalCents = null;
    var cartRequest = 0;
    var refreshTimer = null;
    var euroFormatter = new Intl.NumberFormat('de-DE', {
      style: 'currency', currency: 'EUR'
    });

    function readSelectedVariant() {
      var params = new URLSearchParams(window.location.search);
      var variantId = params.get('variant');
      var productForm = rateElement.closest('.product') || document;
      var variantInput = productForm.querySelector('form[action*="/cart/add"] [name="id"]');
      if (variantInput && variantInput.value) variantId = variantInput.value;
      var selected = variants.find(function (variant) {
        return String(variant.id) === String(variantId);
      });
      return selected ? selected.price : priceCents;
    }

    function updateRate() {
      var amount = Number(readSelectedVariant()) / 100;
      var cartAmount = Number(cartTotalCents) / 100;
      var cartEmpty = cartTotalCents === 0;
      var eligible = cartTotalCents !== null && (
        cartAmount >= 99 || (cartEmpty && amount >= 99)
      );

      if (!eligible || !Number.isFinite(amount) || amount <= 0) {
        rateElement.textContent = 'Ratenkauf ab 99 € Warenkorb';
        return;
      }

      var yearlyRate = 0.089;
      var monthlyRate = Math.pow(1 + yearlyRate, 1 / 12) - 1;
      var payment = amount * monthlyRate / (1 - Math.pow(1 + monthlyRate, -36));
      if (!Number.isFinite(payment)) {
        rateElement.textContent = 'Ratenkauf ab 99 € Warenkorb';
        return;
      }
      rateElement.textContent = 'ab ' +
        euroFormatter.format(payment) + ' mtl. finanzieren';
    }

    function refreshCart() {
      var requestId = ++cartRequest;
      var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      fetch(root + 'cart.js', {
        credentials: 'same-origin',
        cache: 'no-store',
        headers: {Accept: 'application/json'}
      }).then(function (response) {
        if (!response.ok) throw new Error('Warenkorb nicht erreichbar');
        return response.json();
      }).then(function (cart) {
        if (requestId !== cartRequest) return;
        cartTotalCents = Number(cart.total_price);
        if (!Number.isFinite(cartTotalCents)) cartTotalCents = null;
        updateRate();
      }).catch(function () {
        if (requestId !== cartRequest) return;
        cartTotalCents = null;
        updateRate();
      });
    }

    function scheduleCartRefresh() {
      window.clearTimeout(refreshTimer);
      refreshTimer = window.setTimeout(refreshCart, 250);
    }

    updateRate();
    refreshCart();
    document.addEventListener('change', function () {
      window.setTimeout(updateRate, 0);
    });
    window.addEventListener('popstate', updateRate);
    document.addEventListener('variant:change', function (event) {
      var variant = event.detail && event.detail.variant;
      if (variant && variant.price != null) {
        priceCents = variant.price;
      }
      updateRate();
    });
    ['cart:updated', 'cart:refresh', 'cart:change', 'cart:added', 'cart:removed'].forEach(function (name) {
      document.addEventListener(name, scheduleCartRefresh);
      window.addEventListener(name, scheduleCartRefresh);
    });
    window.addEventListener('pageshow', refreshCart);
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) refreshCart();
    });
  })();
</script>

<script>
  (function () {
    function getPdaMaximumScroll(slider) {
      var viewport = slider.querySelector(
        '[data-pda-slider-viewport]'
      );

      var cards = slider.querySelectorAll(
        '.pda-recommendation-card'
      );

      if (!viewport || !cards.length) {
        return 0;
      }

      var lastCard = cards[cards.length - 1];
      var viewportRect = viewport.getBoundingClientRect();
      var lastCardRect = lastCard.getBoundingClientRect();

      /*
       * Tatsächliches Ende der letzten Produktkarte relativ zum
       * scrollbaren Viewport. Dadurch ignorieren wir leere Breite,
       * die durch Track-/Theme-CSS entstehen kann.
       */
      var contentEnd =
        viewport.scrollLeft +
        (lastCardRect.right - viewportRect.left);

      return Math.max(
        0,
        Math.ceil(contentEnd - viewport.clientWidth)
      );
    }

    function clampPdaScroll(slider) {
      var viewport = slider.querySelector(
        '[data-pda-slider-viewport]'
      );

      if (!viewport) {
        return;
      }

      var maximumScroll = getPdaMaximumScroll(slider);

      if (viewport.scrollLeft > maximumScroll + 1) {
        viewport.scrollLeft = maximumScroll;
      }
    }

    function updatePdaSliderButtons(slider) {
      var viewport = slider.querySelector(
        '[data-pda-slider-viewport]'
      );

      var previousButton = slider.querySelector(
        '[data-pda-slider-prev]'
      );

      var nextButton = slider.querySelector(
        '[data-pda-slider-next]'
      );

      if (!viewport) {
        return;
      }

      var maximumScroll = getPdaMaximumScroll(slider);

      if (previousButton) {
        previousButton.disabled =
          viewport.scrollLeft <= 2;
      }

      if (nextButton) {
        nextButton.disabled =
          maximumScroll <= 2 ||
          viewport.scrollLeft >= maximumScroll - 2;
      }
    }

    function getPdaScrollDistance(slider) {
      var card = slider.querySelector(
        '.pda-recommendation-card'
      );

      var track = slider.querySelector(
        '.pda-recommendations-track'
      );

      if (!card || !track) {
        return 0;
      }

      var styles = window.getComputedStyle(track);

      var gap =
        parseFloat(styles.columnGap) ||
        parseFloat(styles.gap) ||
        0;

      var visibleCards =
  window.matchMedia('(max-width: 749px)').matches
    ? 2
    : 3;

return (
  card.getBoundingClientRect().width + gap
) * visibleCards;
    }

    function bindPdaSlider(slider) {
      if (
        !slider ||
        slider.dataset.pdaSliderBound === 'true'
      ) {
        return;
      }

      var viewport = slider.querySelector(
        '[data-pda-slider-viewport]'
      );

      var previousButton = slider.querySelector(
        '[data-pda-slider-prev]'
      );

      var nextButton = slider.querySelector(
        '[data-pda-slider-next]'
      );

      if (!viewport) {
        return;
      }

      slider.dataset.pdaSliderBound = 'true';

      if (previousButton) {
        previousButton.addEventListener(
          'click',
          function (event) {
            event.preventDefault();
            event.stopPropagation();

            var distance =
              getPdaScrollDistance(slider);

            viewport.scrollTo({
              left: Math.max(
                0,
                viewport.scrollLeft - distance
              ),
              behavior: 'smooth'
            });
          }
        );
      }

      if (nextButton) {
        nextButton.addEventListener(
          'click',
          function (event) {
            event.preventDefault();
            event.stopPropagation();

            var distance =
              getPdaScrollDistance(slider);

            var maximumScroll =
              getPdaMaximumScroll(slider);

            viewport.scrollTo({
              left: Math.min(
                maximumScroll,
                viewport.scrollLeft + distance
              ),
              behavior: 'smooth'
            });
          }
        );
      }

      viewport.addEventListener(
        'scroll',
        function () {
          clampPdaScroll(slider);
          updatePdaSliderButtons(slider);
        },
        { passive: true }
      );

      clampPdaScroll(slider);
      updatePdaSliderButtons(slider);
    }

    function initializePdaSliders(root) {
      var context = root || document;

      /*
       * Root kann selbst ein Slider sein.
       */
      if (
        context.matches &&
        context.matches('[data-pda-slider]')
      ) {
        bindPdaSlider(context);
      }

      /*
       * Alle enthaltenen Slider initialisieren.
       */
      if (context.querySelectorAll) {
        context
          .querySelectorAll('[data-pda-slider]')
          .forEach(function (slider) {
            bindPdaSlider(slider);
          });
      }
    }

    /*
     * Bereits vorhandene Slider initialisieren.
     */
    initializePdaSliders(document);

    /*
     * Shopify lädt Produktempfehlungen nachträglich.
     * Der Observer initialisiert die Buttons, sobald
     * der Slider tatsächlich im DOM vorhanden ist.
     */
    var pdaObserver = new MutationObserver(
      function (mutations) {
        mutations.forEach(function (mutation) {
          mutation.addedNodes.forEach(function (node) {
            if (node.nodeType !== 1) {
              return;
            }

            initializePdaSliders(node);
          });
        });
      }
    );

    pdaObserver.observe(document.documentElement, {
      childList: true,
      subtree: true
    });

    /*
     * Shopify Theme-Editor.
     */
    document.addEventListener(
      'shopify:section:load',
      function (event) {
        initializePdaSliders(event.target);
      }
    );

    /*
     * Buttonzustände nach Größenänderungen aktualisieren.
     */
    window.addEventListener('resize', function () {
      document
        .querySelectorAll('[data-pda-slider]')
        .forEach(function (slider) {
          updatePdaSliderButtons(slider);
        });
    });
  })();
</script>
<script>
  (function () {
    if (window.pdaCartModalRefreshBound) {
      return;
    }

    window.pdaCartModalRefreshBound = true;

    function getCartModalSectionId() {
      var cartModal = document.querySelector('#cart-modal');

      if (!cartModal) {
        return null;
      }

      var sectionWrapper = cartModal.closest(
        '[id^="shopify-section-"]'
      );

      if (!sectionWrapper) {
        return null;
      }

      return sectionWrapper.id.replace(
        'shopify-section-',
        ''
      );
    }

    function refreshCartModal() {
      /*
       * Bevorzugt die theme-eigene In-Place-Aktualisierung: <cart-modal>
       * tauscht dabei nur seinen Inhalt aus und behaelt den Oeffnungszustand.
       * Ein replaceWith() der ganzen Section wuerfe den Drawer, den das Theme
       * nach dem Quick-Add gerade geoeffnet hat, aus dem DOM (Drawer
       * verschwindet, body bleibt per .no-scroll gesperrt). Der Section-Tausch
       * unten bleibt nur als Fallback, falls <cart-modal> nicht definiert ist.
       */
      var liveCartModal = document.querySelector('cart-modal');

      if (
        liveCartModal &&
        typeof liveCartModal.reloadContent === 'function'
      ) {
        return liveCartModal.reloadContent();
      }

      var sectionId = getCartModalSectionId();

      if (!sectionId) {
        return Promise.resolve();
      }

      var root =
        window.Shopify &&
        window.Shopify.routes &&
        window.Shopify.routes.root
          ? window.Shopify.routes.root
          : '/';

      var url =
        root +
        '?sections=' +
        encodeURIComponent(sectionId);

      return fetch(url, {
        headers: {
          Accept: 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
        .then(function (response) {
          if (!response.ok) {
            throw new Error(
              'Cart-Modal konnte nicht aktualisiert werden.'
            );
          }

          return response.json();
        })
        .then(function (sections) {
          var html = sections[sectionId];

          if (!html) {
            return;
          }

          var parser = new DOMParser();
          var parsedDocument = parser.parseFromString(
            html,
            'text/html'
          );

          var newSection =
            parsedDocument.querySelector(
              '#shopify-section-' + CSS.escape(sectionId)
            );

          var currentSection =
            document.getElementById(
              'shopify-section-' + sectionId
            );

          if (newSection && currentSection) {
            currentSection.replaceWith(newSection);
            return;
          }

          /*
           * Fallback, falls Shopify nur den
           * inneren Section-Inhalt zurückgibt.
           */
          var newCartModal =
            parsedDocument.querySelector('#cart-modal');

          var currentCartModal =
            document.querySelector('#cart-modal');

          if (newCartModal && currentCartModal) {
            currentCartModal.replaceWith(newCartModal);
          }
        });
    }

    function waitForCartChange(previousItemCount) {
      var attempts = 0;
      var maximumAttempts = 20;

      function checkCart(resolve) {
        attempts++;

        var root =
          window.Shopify &&
          window.Shopify.routes &&
          window.Shopify.routes.root
            ? window.Shopify.routes.root
            : '/';

        fetch(root + 'cart.js', {
          headers: {
            Accept: 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          }
        })
          .then(function (response) {
            return response.json();
          })
          .then(function (cart) {
            if (
              cart.item_count !== previousItemCount ||
              attempts >= maximumAttempts
            ) {
              resolve(cart);
              return;
            }

            window.setTimeout(function () {
              checkCart(resolve);
            }, 150);
          })
          .catch(function () {
            resolve(null);
          });
      }

      return new Promise(function (resolve) {
        checkCart(resolve);
      });
    }

    document.addEventListener(
      'click',
      function (event) {
        var button = event.target.closest(
          '.pda-product-recommendations quick-add-button button'
        );

        if (!button) {
          return;
        }

        /*
         * Wir greifen nicht in den bestehenden
         * Quick-Add-Vorgang ein. Wir warten nur,
         * bis sich der Warenkorb auf dem Server
         * tatsächlich geändert hat.
         */
        var root =
          window.Shopify &&
          window.Shopify.routes &&
          window.Shopify.routes.root
            ? window.Shopify.routes.root
            : '/';

        fetch(root + 'cart.js', {
          headers: {
            Accept: 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          }
        })
          .then(function (response) {
            return response.json();
          })
          .then(function (cartBefore) {
            return waitForCartChange(
              cartBefore.item_count
            );
          })
          .then(function () {
            return refreshCartModal();
          })
          .then(function () {
            document.dispatchEvent(
              new CustomEvent('cart:updated', {
                bubbles: true
              })
            );

            document.dispatchEvent(
              new CustomEvent('cart:refresh', {
                bubbles: true
              })
            );
          })
          .catch(function (error) {
            console.error(
              'PDA Cart-Modal Refresh:',
              error
            );
          });
      },
      true
    );
  })();
</script>

