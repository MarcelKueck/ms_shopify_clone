{% doc %}
  @prompt
    Ich wünsche mir einen stets verfügbaren Block namens "Heading Special" ...er soll genau so aussehen.
    
    Die Elemente sollen heißen 
    Toptitle
    Heading
    Stripe (yes/no)
    
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-heading-special-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    text-align: {{ block.settings.text_alignment }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-heading-special__toptitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.toptitle_size }}px;
    color: {{ block.settings.toptitle_color }};
    margin: 0 0 {{ block.settings.toptitle_spacing }}px 0;
    font-weight: {{ block.settings.toptitle_weight }};
    text-transform: {{ block.settings.toptitle_transform }};
    letter-spacing: {{ block.settings.toptitle_letter_spacing }}px;
  }

  .ai-heading-special__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: {{ block.settings.heading_weight }};
    text-transform: {{ block.settings.heading_transform }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    line-height: {{ block.settings.heading_line_height }};
  }

  .ai-heading-special__stripe-{{ ai_gen_id }} {
    width: {{ block.settings.stripe_width }}px;
    height: {{ block.settings.stripe_height }}px;
    background-color: {{ block.settings.stripe_color }};
    margin-top: {{ block.settings.stripe_spacing }}px;
    {% if block.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif block.settings.text_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-heading-special__toptitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.toptitle_size }}px * 0.8);
    }

    .ai-heading-special__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<div class="ai-heading-special-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.toptitle != blank %}
    <div class="ai-heading-special__toptitle-{{ ai_gen_id }}">
      {{ block.settings.toptitle }}
    </div>
  {% endif %}

  {% if block.settings.heading != blank %}
    <h2 class="ai-heading-special__heading-{{ ai_gen_id }}">
      {{ block.settings.heading }}
    </h2>
  {% endif %}

  {% if block.settings.show_stripe %}
    <div class="ai-heading-special__stripe-{{ ai_gen_id }}"></div>
  {% endif %}
</div>

