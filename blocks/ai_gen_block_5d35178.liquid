{% doc %}
  @prompt
    wir benötigen ein modul in welchem wir auf dem desktop eine vergleichstabelle erstellen können mit belieg vielen zeilen und spalten. Mobil müssen eine Zeile mit Überschriften zu einer Vergleichs Card - die man dann mobil durchsliden kann. Die Elemente sollen sehr stilvoll sein und modern. es sollen alle Elemente in Farbe, Effekten, Abstand und mehr zu stylen sein. Das Gesamtmodul soll wieder auf die gesamte breite sein. Die Tabelle und das Cards sollen individuell in der breite zu justieren sein. , bitte noch einbauen, dass man eine H3 überschrift über dem element hat, die section breite soll in px einzustellen sein, mobil muss sowohl die spaltenüberschrift sowie die zeileantwort angezeigt werden. sonst macht das card keinen sinn , in den mobilen cards müssen die zellen mit label und column zusammen ausgegeben werden  , du musst im mobilen card unter das label direkt die antwort aus dem column plaztieren, sonst machen die cards keinen sinn. , mobil werden die columns nicht ausgegeben, finde eine passende lösung
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-table-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    background-color: {{ block.settings.section_background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-comparison-table-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.desktop_width_px }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-comparison-table-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    font-weight: {{ block.settings.heading_font_weight }};
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
  }

  .ai-comparison-table-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.table_background_color }};
    box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
  }

  .ai-comparison-table-desktop-{{ ai_gen_id }} {
    width: {{ block.settings.table_width_percent }}%;
    margin: 0 auto;
    border-collapse: collapse;
    display: table;
  }

  .ai-comparison-table-desktop-{{ ai_gen_id }} thead {
    background-color: {{ block.settings.header_background_color }};
  }

  .ai-comparison-table-desktop-{{ ai_gen_id }} th {
    padding: {{ block.settings.cell_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    font-size: {{ block.settings.header_font_size }}px;
    font-weight: {{ block.settings.header_font_weight }};
    color: {{ block.settings.header_text_color }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-comparison-table-desktop-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    font-size: {{ block.settings.cell_font_size }}px;
    color: {{ block.settings.cell_text_color }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    vertical-align: middle;
  }

  .ai-comparison-table-desktop-{{ ai_gen_id }} tbody tr:hover {
    background-color: {{ block.settings.row_hover_color }};
    transition: background-color {{ block.settings.hover_transition_duration }}s ease;
  }

  .ai-comparison-table-desktop-{{ ai_gen_id }} tbody tr:nth-child(even) {
    background-color: {{ block.settings.row_alternate_color }};
  }

  .ai-comparison-table-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-comparison-cards-{{ ai_gen_id }} {
    display: flex;
    overflow-x: auto;
    gap: {{ block.settings.card_gap }}px;
    scroll-snap-type: x mandatory;
    padding: {{ block.settings.card_padding }}px;
    -webkit-overflow-scrolling: touch;
  }

  .ai-comparison-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width_percent }}%;
    scroll-snap-align: start;
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
  }

  .ai-comparison-card-header-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_header_font_size }}px;
    font-weight: {{ block.settings.card_header_font_weight }};
    color: {{ block.settings.card_header_color }};
    margin-bottom: {{ block.settings.card_header_spacing }}px;
    padding-bottom: {{ block.settings.card_header_spacing }}px;
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    text-align: center;
  }

  .ai-comparison-card-row-{{ ai_gen_id }} {
    padding: {{ block.settings.card_row_padding }}px 0;
    border-bottom: {{ block.settings.card_row_border_width }}px solid {{ block.settings.card_row_border_color }};
  }

  .ai-comparison-card-row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-comparison-card-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_label_font_size }}px;
    font-weight: {{ block.settings.card_label_font_weight }};
    color: {{ block.settings.card_label_color }};
    margin-bottom: {{ block.settings.card_label_spacing }}px;
  }

  .ai-comparison-card-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_value_font_size }}px;
    font-weight: {{ block.settings.card_value_font_weight }};
    color: {{ block.settings.card_value_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-table-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-comparison-table-mobile-{{ ai_gen_id }} {
      display: block;
    }
  }
{% endstyle %}

<comparison-table-{{ ai_gen_id }} class="ai-comparison-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-table-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h3 class="ai-comparison-table-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
    {% endif %}

    <div class="ai-comparison-table-wrapper-{{ ai_gen_id }}">
      <table class="ai-comparison-table-desktop-{{ ai_gen_id }}">
        <thead>
          <tr>
            {% if block.settings.header_col_1 != blank %}
              <th>{{ block.settings.header_col_1 }}</th>
            {% endif %}
            {% if block.settings.header_col_2 != blank %}
              <th>{{ block.settings.header_col_2 }}</th>
            {% endif %}
            {% if block.settings.header_col_3 != blank %}
              <th>{{ block.settings.header_col_3 }}</th>
            {% endif %}
            {% if block.settings.header_col_4 != blank %}
              <th>{{ block.settings.header_col_4 }}</th>
            {% endif %}
            {% if block.settings.header_col_5 != blank %}
              <th>{{ block.settings.header_col_5 }}</th>
            {% endif %}
            {% if block.settings.header_col_6 != blank %}
              <th>{{ block.settings.header_col_6 }}</th>
            {% endif %}
          </tr>
        </thead>
        <tbody>
          {% for i in (1..20) %}
            {% liquid
              assign row_label_key = 'row_' | append: i | append: '_label'
              assign row_col_1_key = 'row_' | append: i | append: '_col_1'
              assign row_col_2_key = 'row_' | append: i | append: '_col_2'
              assign row_col_3_key = 'row_' | append: i | append: '_col_3'
              assign row_col_4_key = 'row_' | append: i | append: '_col_4'
              assign row_col_5_key = 'row_' | append: i | append: '_col_5'

              assign row_label = block.settings[row_label_key]
              assign row_col_1 = block.settings[row_col_1_key]
              assign row_col_2 = block.settings[row_col_2_key]
              assign row_col_3 = block.settings[row_col_3_key]
              assign row_col_4 = block.settings[row_col_4_key]
              assign row_col_5 = block.settings[row_col_5_key]
            %}

            {% if row_label != blank %}
              <tr>
                <td>{{ row_label }}</td>
                {% if block.settings.header_col_2 != blank %}
                  <td>{{ row_col_1 }}</td>
                {% endif %}
                {% if block.settings.header_col_3 != blank %}
                  <td>{{ row_col_2 }}</td>
                {% endif %}
                {% if block.settings.header_col_4 != blank %}
                  <td>{{ row_col_3 }}</td>
                {% endif %}
                {% if block.settings.header_col_5 != blank %}
                  <td>{{ row_col_4 }}</td>
                {% endif %}
                {% if block.settings.header_col_6 != blank %}
                  <td>{{ row_col_5 }}</td>
                {% endif %}
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="ai-comparison-table-mobile-{{ ai_gen_id }}">
      <div class="ai-comparison-cards-{{ ai_gen_id }}">
        {% if block.settings.header_col_2 != blank %}
          <div class="ai-comparison-card-{{ ai_gen_id }}">
            <div class="ai-comparison-card-header-{{ ai_gen_id }}">
              {{ block.settings.header_col_2 }}
            </div>
            {% for row_index in (1..20) %}
              {% liquid
                assign row_label_key = 'row_' | append: row_index | append: '_label'
                assign row_value_key = 'row_' | append: row_index | append: '_col_1'
                assign row_label = block.settings[row_label_key]
                assign row_value = block.settings[row_value_key]
              %}
              {% if row_label != blank %}
                <div class="ai-comparison-card-row-{{ ai_gen_id }}">
                  <div class="ai-comparison-card-label-{{ ai_gen_id }}">
                    {{ row_label }}
                  </div>
                  <div class="ai-comparison-card-value-{{ ai_gen_id }}">
                    {{ row_value }}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if block.settings.header_col_3 != blank %}
          <div class="ai-comparison-card-{{ ai_gen_id }}">
            <div class="ai-comparison-card-header-{{ ai_gen_id }}">
              {{ block.settings.header_col_3 }}
            </div>
            {% for row_index in (1..20) %}
              {% liquid
                assign row_label_key = 'row_' | append: row_index | append: '_label'
                assign row_value_key = 'row_' | append: row_index | append: '_col_2'
                assign row_label = block.settings[row_label_key]
                assign row_value = block.settings[row_value_key]
              %}
              {% if row_label != blank %}
                <div class="ai-comparison-card-row-{{ ai_gen_id }}">
                  <div class="ai-comparison-card-label-{{ ai_gen_id }}">
                    {{ row_label }}
                  </div>
                  <div class="ai-comparison-card-value-{{ ai_gen_id }}">
                    {{ row_value }}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if block.settings.header_col_4 != blank %}
          <div class="ai-comparison-card-{{ ai_gen_id }}">
            <div class="ai-comparison-card-header-{{ ai_gen_id }}">
              {{ block.settings.header_col_4 }}
            </div>
            {% for row_index in (1..20) %}
              {% liquid
                assign row_label_key = 'row_' | append: row_index | append: '_label'
                assign row_value_key = 'row_' | append: row_index | append: '_col_3'
                assign row_label = block.settings[row_label_key]
                assign row_value = block.settings[row_value_key]
              %}
              {% if row_label != blank %}
                <div class="ai-comparison-card-row-{{ ai_gen_id }}">
                  <div class="ai-comparison-card-label-{{ ai_gen_id }}">
                    {{ row_label }}
                  </div>
                  <div class="ai-comparison-card-value-{{ ai_gen_id }}">
                    {{ row_value }}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if block.settings.header_col_5 != blank %}
          <div class="ai-comparison-card-{{ ai_gen_id }}">
            <div class="ai-comparison-card-header-{{ ai_gen_id }}">
              {{ block.settings.header_col_5 }}
            </div>
            {% for row_index in (1..20) %}
              {% liquid
                assign row_label_key = 'row_' | append: row_index | append: '_label'
                assign row_value_key = 'row_' | append: row_index | append: '_col_4'
                assign row_label = block.settings[row_label_key]
                assign row_value = block.settings[row_value_key]
              %}
              {% if row_label != blank %}
                <div class="ai-comparison-card-row-{{ ai_gen_id }}">
                  <div class="ai-comparison-card-label-{{ ai_gen_id }}">
                    {{ row_label }}
                  </div>
                  <div class="ai-comparison-card-value-{{ ai_gen_id }}">
                    {{ row_value }}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if block.settings.header_col_6 != blank %}
          <div class="ai-comparison-card-{{ ai_gen_id }}">
            <div class="ai-comparison-card-header-{{ ai_gen_id }}">
              {{ block.settings.header_col_6 }}
            </div>
            {% for row_index in (1..20) %}
              {% liquid
                assign row_label_key = 'row_' | append: row_index | append: '_label'
                assign row_value_key = 'row_' | append: row_index | append: '_col_5'
                assign row_label = block.settings[row_label_key]
                assign row_value = block.settings[row_value_key]
              %}
              {% if row_label != blank %}
                <div class="ai-comparison-card-row-{{ ai_gen_id }}">
                  <div class="ai-comparison-card-label-{{ ai_gen_id }}">
                    {{ row_label }}
                  </div>
                  <div class="ai-comparison-card-value-{{ ai_gen_id }}">
                    {{ row_value }}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</comparison-table-{{ ai_gen_id }}>

<script>
  (function() {
    class ComparisonTable{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('comparison-table-{{ ai_gen_id }}', ComparisonTable{{ ai_gen_id }});
  })();
</script>

