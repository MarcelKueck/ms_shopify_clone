{% doc %}
  @prompt
    kopiere das image with text overlay und gebe viel mehr möglichkeiten um einstellungen vorzunehmen für abstand, farbe, buttons, überschriften etc. , bitte dazu noch die möglichkeit einbauen für desktip und mobil anderen bilder einzubazuen, zusätzlich noch einbauen, wie das bild positioniert werden kann, also links,zentriert oder rechtsbündig, die position ist zwar als center eingestellt aber ich glaub nur in dem rahmen von dem bild, ich benötige die positionierung des bilds in dem abschnitt
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-overlay-container-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    {% if block.settings.block_alignment == 'left' %}
      justify-content: flex-start;
    {% elsif block.settings.block_alignment == 'center' %}
      justify-content: center;
    {% else %}
      justify-content: flex-end;
    {% endif %}
  }

  .ai-image-text-overlay-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    overflow: hidden;
    border-radius: {{ block.settings.container_border_radius }}px;
  }

  .ai-image-text-overlay-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    display: block;
  }

  .ai-image-text-overlay-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position_desktop }};
    display: block;
  }

  .ai-image-text-overlay-image-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-image-text-overlay-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-text-overlay-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-image-text-overlay-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-text-overlay-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    pointer-events: none;
  }

  .ai-image-text-overlay-content-{{ ai_gen_id }} {
    position: absolute;
    {% if block.settings.content_vertical_position == 'top' %}
      top: {{ block.settings.content_padding_vertical }}px;
    {% elsif block.settings.content_vertical_position == 'center' %}
      top: 50%;
      transform: translateY(-50%);
    {% else %}
      bottom: {{ block.settings.content_padding_vertical }}px;
    {% endif %}
    {% if block.settings.content_horizontal_position == 'left' %}
      left: {{ block.settings.content_padding_horizontal }}px;
      text-align: left;
    {% elsif block.settings.content_horizontal_position == 'center' %}
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
    {% else %}
      right: {{ block.settings.content_padding_horizontal }}px;
      text-align: right;
    {% endif %}
    {% if block.settings.content_vertical_position == 'center' and block.settings.content_horizontal_position == 'center' %}
      transform: translate(-50%, -50%);
    {% endif %}
    max-width: {{ block.settings.content_max_width }}%;
    z-index: 2;
  }

  .ai-image-text-overlay-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px 0;
    font-weight: {{ block.settings.subheading_weight }};
    text-transform: {{ block.settings.subheading_transform }};
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
  }

  .ai-image-text-overlay-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    font-weight: {{ block.settings.heading_weight }};
    text-transform: {{ block.settings.heading_transform }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    line-height: {{ block.settings.heading_line_height }};
  }

  .ai-image-text-overlay-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    line-height: {{ block.settings.text_line_height }};
  }

  .ai-image-text-overlay-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_gap }}px;
    margin-top: {{ block.settings.buttons_spacing }}px;
    {% if block.settings.content_horizontal_position == 'left' %}
      justify-content: flex-start;
    {% elsif block.settings.content_horizontal_position == 'center' %}
      justify-content: center;
    {% else %}
      justify-content: flex-end;
    {% endif %}
    flex-wrap: wrap;
  }

  .ai-image-text-overlay-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-transform: {{ block.settings.button_text_transform }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid;
  }

  .ai-image-text-overlay-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_primary_bg }};
    color: {{ block.settings.button_primary_color }};
    border-color: {{ block.settings.button_primary_border }};
  }

  .ai-image-text-overlay-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_primary_bg_hover }};
    color: {{ block.settings.button_primary_color_hover }};
    border-color: {{ block.settings.button_primary_border_hover }};
  }

  .ai-image-text-overlay-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_secondary_bg }};
    color: {{ block.settings.button_secondary_color }};
    border-color: {{ block.settings.button_secondary_border }};
  }

  .ai-image-text-overlay-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_secondary_bg_hover }};
    color: {{ block.settings.button_secondary_color_hover }};
    border-color: {{ block.settings.button_secondary_border_hover }};
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-overlay-container-{{ ai_gen_id }} {
      {% if block.settings.block_alignment_mobile == 'left' %}
        justify-content: flex-start;
      {% elsif block.settings.block_alignment_mobile == 'center' %}
        justify-content: center;
      {% else %}
        justify-content: flex-end;
      {% endif %}
    }

    .ai-image-text-overlay-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.image_height_mobile }}px;
    }

    .ai-image-text-overlay-image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-image-text-overlay-image-mobile-{{ ai_gen_id }} {
      display: block;
      object-position: {{ block.settings.image_position_mobile }};
    }

    .ai-image-text-overlay-content-{{ ai_gen_id }} {
      {% if block.settings.content_vertical_position == 'top' %}
        top: {{ block.settings.content_padding_vertical_mobile }}px;
      {% elsif block.settings.content_vertical_position == 'bottom' %}
        bottom: {{ block.settings.content_padding_vertical_mobile }}px;
      {% endif %}
      {% if block.settings.content_horizontal_position == 'left' %}
        left: {{ block.settings.content_padding_horizontal_mobile }}px;
      {% elsif block.settings.content_horizontal_position == 'right' %}
        right: {{ block.settings.content_padding_horizontal_mobile }}px;
      {% endif %}
      max-width: {{ block.settings.content_max_width_mobile }}%;
    }

    .ai-image-text-overlay-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }

    .ai-image-text-overlay-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-image-text-overlay-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    .ai-image-text-overlay-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size_mobile }}px;
      padding: {{ block.settings.button_padding_vertical_mobile }}px {{ block.settings.button_padding_horizontal_mobile }}px;
    }
  }
{% endstyle %}

<div
  class="ai-image-text-overlay-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-image-text-overlay-{{ ai_gen_id }}">
    <div class="ai-image-text-overlay-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image_desktop %}
        <img
          src="{{ block.settings.image_desktop | image_url: width: 2000 }}"
          alt="{{ block.settings.image_desktop.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_desktop.width }}"
          height="{{ block.settings.image_desktop.height }}"
          class="ai-image-text-overlay-image-{{ ai_gen_id }} ai-image-text-overlay-image-desktop-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-text-overlay-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-image-text-overlay-empty-state-{{ ai_gen_id }}">
            Next, add a desktop image
          </div>
        </div>
      {% endif %}

      {% if block.settings.image_mobile %}
        <img
          src="{{ block.settings.image_mobile | image_url: width: 1000 }}"
          alt="{{ block.settings.image_mobile.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_mobile.width }}"
          height="{{ block.settings.image_mobile.height }}"
          class="ai-image-text-overlay-image-{{ ai_gen_id }} ai-image-text-overlay-image-mobile-{{ ai_gen_id }}"
        >
      {% elsif block.settings.image_desktop %}
        <img
          src="{{ block.settings.image_desktop | image_url: width: 1000 }}"
          alt="{{ block.settings.image_desktop.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_desktop.width }}"
          height="{{ block.settings.image_desktop.height }}"
          class="ai-image-text-overlay-image-{{ ai_gen_id }} ai-image-text-overlay-image-mobile-{{ ai_gen_id }}"
        >
      {% endif %}

      {% if block.settings.show_overlay %}
        <div class="ai-image-text-overlay-overlay-{{ ai_gen_id }}"></div>
      {% endif %}

      <div class="ai-image-text-overlay-content-{{ ai_gen_id }}">
        {% if block.settings.subheading != blank %}
          <div class="ai-image-text-overlay-subheading-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="ai-image-text-overlay-heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="ai-image-text-overlay-text-{{ ai_gen_id }}">
            {{ block.settings.text }}
          </div>
        {% endif %}

        {% if block.settings.show_buttons %}
          <div class="ai-image-text-overlay-buttons-{{ ai_gen_id }}">
            {% if block.settings.button_primary_label != blank %}
              <a
                href="{{ block.settings.button_primary_link }}"
                class="ai-image-text-overlay-button-{{ ai_gen_id }} ai-image-text-overlay-button-primary-{{ ai_gen_id }}"
              >
                {{ block.settings.button_primary_label }}
              </a>
            {% endif %}

            {% if block.settings.button_secondary_label != blank %}
              <a
                href="{{ block.settings.button_secondary_link }}"
                class="ai-image-text-overlay-button-{{ ai_gen_id }} ai-image-text-overlay-button-secondary-{{ ai_gen_id }}"
              >
                {{ block.settings.button_secondary_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

