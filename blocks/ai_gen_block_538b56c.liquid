{% doc %}
  @prompt
    genau das Heading Special nochmal generieren aber mit der Möglichkeit die Hintergrundfarbe zu ändern, bitte den stripe noch hinzufügen, der stripe ist viel zu groß - wie hier bitte, der stripe ist über den ganzen bildschirm bitte auf 10% reduzieren und die psoitionierung unter heading und subtitle. den subtitle bitte über dem heading positionieren
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-special-heading-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    text-align: {{ block.settings.text_alignment }};
    position: relative;
  }

  .ai-special-heading__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.text_alignment }};
  }

  .ai-special-heading__subtitle-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.subtitle_spacing }}px;
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    font-weight: {{ block.settings.subtitle_font_weight }};
    line-height: 1.5;
    order: 1;
  }

  .ai-special-heading__title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: {{ block.settings.font_weight }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    line-height: {{ block.settings.line_height }};
    text-transform: {{ block.settings.text_transform }};
    order: 2;
  }

  {% if block.settings.show_stripe %}
    .ai-special-heading__stripe-{{ ai_gen_id }} {
      width: {{ block.settings.stripe_width }}%;
      height: {{ block.settings.stripe_height }}px;
      background-color: {{ block.settings.stripe_color }};
      margin-top: {{ block.settings.stripe_spacing }}px;
      order: 3;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-special-heading__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-special-heading__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.85);
    }
  }
{% endstyle %}

<div class="ai-special-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-special-heading__content-{{ ai_gen_id }}">
    {% if block.settings.subtitle != blank %}
      <div class="ai-special-heading__subtitle-{{ ai_gen_id }}">
        {{ block.settings.subtitle }}
      </div>
    {% endif %}

    {% if block.settings.heading != blank %}
      <h2 class="ai-special-heading__title-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.show_stripe %}
      <div class="ai-special-heading__stripe-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</div>

