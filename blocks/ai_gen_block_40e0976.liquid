    {
      "type": "header",
      "content": "Button Effekte"
    },
    {
      "type": "range",
      "id": "button_hover_lift",
      "label": "Hover-Anhebung",
      "min": -5,
      "max": 0,
      "step": 1,
      "unit": "px",
      "default": -2
