    {
      "type": "range",
      "id": "button_shadow_x",
      "label": "Schatten X-Versatz",
      "min": -10,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_shadow_y",
      "label": "Schatten Y-Versatz",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "button_shadow_blur",
      "label": "Schatten Unschärfe",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "button_shadow_color",
      "label": "Schattenfarbe",
      "default": "rgba(0, 0, 0, 0.2)"
