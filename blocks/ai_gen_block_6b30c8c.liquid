    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Image effects"
    },
    {
      "type": "checkbox",
      "id": "enable_image_filter",
      "label": "Enable image filters",
      "default": false
    },
    {
      "type": "range",
      "id": "image_brightness",
      "label": "Brightness",
      "min": 0.5,
      "max": 1.5,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "range",
      "id": "image_contrast",
      "label": "Contrast",
      "min": 0.5,
      "max": 1.5,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "range",
      "id": "image_saturation",
      "label": "Saturation",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "enable_image_overlay",
      "label": "Enable image overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "image_overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.3
    },
    {
      "type": "range",
      "id": "image_overlay_hover_opacity",
      "label": "Overlay hover opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "enable_image_shadow",
      "label": "Enable image shadow",
      "default": true
    },
    {
      "type": "range",
      "id": "image_shadow_x",
      "label": "Shadow X offset",
      "min": -20,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
