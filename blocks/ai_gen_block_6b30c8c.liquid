{% doc %}
  @prompt
    Kannst du mir bitte ein modernes Image with Text Modul bauen. Es sollen sämtliche Einstellungsmöglichkeiten vorgenommen werden können, wie Farben, Überschriften, Größe, Abstand etc. - sei kreativ und erstelle ein einzigartiges Modul, kannst du das modul noch etwas exklusiver bauen mit mehr wow moment
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-image-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.section_background_color }};
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  {% if block.settings.enable_gradient_overlay %}
    .ai-premium-image-text-{{ ai_gen_id }}::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(
        {{ block.settings.gradient_angle }}deg,
        {{ block.settings.gradient_color_1 }} 0%,
        {{ block.settings.gradient_color_2 }} 100%
      );
      opacity: {{ block.settings.gradient_opacity }};
      pointer-events: none;
      z-index: 0;
    }
  {% endif %}

  .ai-premium-image-text-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    gap: {{ block.settings.content_gap }}px;
    position: relative;
    z-index: 1;
    {% if block.settings.layout == 'image_left' %}
      flex-direction: row;
    {% elsif block.settings.layout == 'image_right' %}
      flex-direction: row-reverse;
    {% elsif block.settings.layout == 'image_top' %}
      flex-direction: column;
    {% else %}
      flex-direction: column-reverse;
    {% endif %}
  }

  .ai-premium-image-text-image-wrapper-{{ ai_gen_id }} {
    {% if block.settings.layout == 'image_left' or block.settings.layout == 'image_right' %}
      flex: 0 0 {{ block.settings.image_width_percent }}%;
    {% else %}
      width: 100%;
    {% endif %}
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    {% if block.settings.enable_image_shadow %}
      box-shadow: {{ block.settings.image_shadow_x }}px {{ block.settings.image_shadow_y }}px {{ block.settings.image_shadow_blur }}px {{ block.settings.image_shadow_spread }}px {{ block.settings.image_shadow_color }};
    {% endif %}
  }

  {% if block.settings.enable_image_overlay %}
    .ai-premium-image-text-image-wrapper-{{ ai_gen_id }}::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: {{ block.settings.image_overlay_color }};
      opacity: {{ block.settings.image_overlay_opacity }};
      transition: opacity 0.5s ease;
      pointer-events: none;
    }

    .ai-premium-image-text-image-wrapper-{{ ai_gen_id }}:hover::after {
      opacity: {{ block.settings.image_overlay_hover_opacity }};
    }
  {% endif %}

  .ai-premium-image-text-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    {% if block.settings.image_aspect_ratio != 'natural' %}
      aspect-ratio: {{ block.settings.image_aspect_ratio }};
    {% endif %}
    transition: transform {{ block.settings.image_hover_zoom_duration }}s ease, filter 0.5s ease;
    {% if block.settings.enable_image_filter %}
      filter: brightness({{ block.settings.image_brightness }}) contrast({{ block.settings.image_contrast }}) saturate({{ block.settings.image_saturation }});
    {% endif %}
  }

  {% if block.settings.image_hover_zoom %}
    .ai-premium-image-text-image-wrapper-{{ ai_gen_id }}:hover .ai-premium-image-text-image-{{ ai_gen_id }} {
      transform: scale({{ block.settings.image_hover_zoom_scale }}) rotate({{ block.settings.image_hover_rotate }}deg);
    }
  {% endif %}

  .ai-premium-image-text-placeholder-{{ ai_gen_id }} {
    width: 100%;
    {% if block.settings.image_aspect_ratio != 'natural' %}
      aspect-ratio: {{ block.settings.image_aspect_ratio }};
    {% else %}
      min-height: 400px;
    {% endif %}
    background: linear-gradient(135deg, #f4f4f4 0%, #e8e8e8 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-premium-image-text-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }

  .ai-premium-image-text-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
  }

  .ai-premium-image-text-content-{{ ai_gen_id }} {
    {% if block.settings.layout == 'image_left' or block.settings.layout == 'image_right' %}
      flex: 1;
    {% else %}
      width: 100%;
    {% endif %}
    padding: {{ block.settings.content_padding }}px;
    background: {{ block.settings.content_background_color }};
    border-radius: {{ block.settings.content_border_radius }}px;
    text-align: {{ block.settings.text_alignment }};
    position: relative;
    {% if block.settings.enable_content_shadow %}
      box-shadow: {{ block.settings.content_shadow_x }}px {{ block.settings.content_shadow_y }}px {{ block.settings.content_shadow_blur }}px {{ block.settings.content_shadow_spread }}px {{ block.settings.content_shadow_color }};
    {% endif %}
    {% if block.settings.enable_content_border %}
      border: {{ block.settings.content_border_width }}px solid {{ block.settings.content_border_color }};
    {% endif %}
  }

  .ai-premium-image-text-decorative-line-{{ ai_gen_id }} {
    width: {{ block.settings.decorative_line_width }}px;
    height: {{ block.settings.decorative_line_height }}px;
    background: {{ block.settings.decorative_line_color }};
    margin: 0 {% if block.settings.text_alignment == 'center' %}auto{% elsif block.settings.text_alignment == 'right' %}0 0 auto{% else %}0 auto 0 0{% endif %};
    margin-bottom: {{ block.settings.decorative_line_margin }}px;
    border-radius: {{ block.settings.decorative_line_radius }}px;
  }

  .ai-premium-image-text-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_font_size }}px;
    color: {{ block.settings.eyebrow_color }};
    text-transform: {{ block.settings.eyebrow_text_transform }};
    letter-spacing: {{ block.settings.eyebrow_letter_spacing }}px;
    margin-bottom: {{ block.settings.eyebrow_margin_bottom }}px;
    font-weight: {{ block.settings.eyebrow_font_weight }};
    {% if block.settings.enable_eyebrow_background %}
      display: inline-block;
      padding: {{ block.settings.eyebrow_padding_vertical }}px {{ block.settings.eyebrow_padding_horizontal }}px;
      background: {{ block.settings.eyebrow_background_color }};
      border-radius: {{ block.settings.eyebrow_border_radius }}px;
    {% endif %}
  }

  .ai-premium-image-text-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    line-height: {{ block.settings.heading_line_height }};
    font-weight: {{ block.settings.heading_font_weight }};
    {% if block.settings.enable_heading_gradient %}
      background: linear-gradient(
        {{ block.settings.heading_gradient_angle }}deg,
        {{ block.settings.heading_gradient_color_1 }},
        {{ block.settings.heading_gradient_color_2 }}
      );
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    {% endif %}
  }

  .ai-premium-image-text-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_font_size }}px;
    color: {{ block.settings.text_color }};
    line-height: {{ block.settings.text_line_height }};
    margin: 0 0 {{ block.settings.text_margin_bottom }}px;
  }

  .ai-premium-image-text-text-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px;
  }

  .ai-premium-image-text-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-premium-image-text-button-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_gap }}px;
    {% if block.settings.text_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
    flex-wrap: wrap;
  }

  .ai-premium-image-text-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    text-transform: {{ block.settings.button_text_transform }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    transition: all {{ block.settings.button_hover_transition }}s ease;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    {% if block.settings.enable_button_shadow %}
      box-shadow: {{ block.settings.button_shadow_x }}px {{ block.settings.button_shadow_y }}px {{ block.settings.button_shadow_blur }}px {{ block.settings.button_shadow_color }};
    {% endif %}
  }

  {% if block.settings.enable_button_shine %}
    .ai-premium-image-text-button-{{ ai_gen_id }}::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.5s ease;
    }

    .ai-premium-image-text-button-{{ ai_gen_id }}:hover::before {
      left: 100%;
    }
  {% endif %}

  .ai-premium-image-text-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY({{ block.settings.button_hover_translate_y }}px) scale({{ block.settings.button_hover_scale }});
    {% if block.settings.enable_button_shadow %}
      box-shadow: {{ block.settings.button_hover_shadow_x }}px {{ block.settings.button_hover_shadow_y }}px {{ block.settings.button_hover_shadow_blur }}px {{ block.settings.button_hover_shadow_color }};
    {% endif %}
  }

  .ai-premium-image-text-button-secondary-{{ ai_gen_id }} {
    background: {{ block.settings.button_secondary_background_color }};
    color: {{ block.settings.button_secondary_text_color }};
    border-color: {{ block.settings.button_secondary_border_color }};
  }

  .ai-premium-image-text-button-secondary-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_secondary_hover_background_color }};
    color: {{ block.settings.button_secondary_hover_text_color }};
    border-color: {{ block.settings.button_secondary_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-premium-image-text-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.mobile_content_gap }}px;
    }

    .ai-premium-image-text-image-wrapper-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-premium-image-text-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_padding }}px {{ block.settings.section_padding_horizontal }}px;
    }

    .ai-premium-image-text-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_font_size }}px;
    }

    .ai-premium-image-text-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_font_size }}px;
    }

    .ai-premium-image-text-button-wrapper-{{ ai_gen_id }} {
      {% if block.settings.mobile_buttons_full_width %}
        flex-direction: column;
      {% endif %}
    }

    {% if block.settings.mobile_buttons_full_width %}
      .ai-premium-image-text-button-{{ ai_gen_id }} {
        width: 100%;
      }
    {% endif %}
  }
{% endstyle %}

<premium-image-text-{{ ai_gen_id }}
  class="ai-premium-image-text-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-premium-image-text-container-{{ ai_gen_id }}">
    <div class="ai-premium-image-text-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 2000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-premium-image-text-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-premium-image-text-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-premium-image-text-empty-state-{{ ai_gen_id }}">
            Add an image to get started
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-premium-image-text-content-{{ ai_gen_id }}">
      {% if block.settings.enable_decorative_line %}
        <div class="ai-premium-image-text-decorative-line-{{ ai_gen_id }}"></div>
      {% endif %}

      {% if block.settings.eyebrow != blank %}
        <div class="ai-premium-image-text-eyebrow-{{ ai_gen_id }}">
          {{ block.settings.eyebrow }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-premium-image-text-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-premium-image-text-text-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </div>
      {% endif %}

      {% if block.settings.button_label != blank or block.settings.button_secondary_label != blank %}
        <div class="ai-premium-image-text-button-wrapper-{{ ai_gen_id }}">
          {% if block.settings.button_label != blank %}
            <a
              href="{{ block.settings.button_link }}"
              class="ai-premium-image-text-button-{{ ai_gen_id }}"
            >
              {{ block.settings.button_label }}
            </a>
          {% endif %}

          {% if block.settings.button_secondary_label != blank %}
            <a
              href="{{ block.settings.button_secondary_link }}"
              class="ai-premium-image-text-button-{{ ai_gen_id }} ai-premium-image-text-button-secondary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_secondary_label }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</premium-image-text-{{ ai_gen_id }}>

<script>
  (function() {
    class PremiumImageText{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.parallaxEnabled = {{ block.settings.enable_parallax | json }};
        this.parallaxSpeed = {{ block.settings.parallax_speed }};
      }

      connectedCallback() {
        this.init();
        if (this.parallaxEnabled) {
          this.setupParallax();
        }
      }

      init() {
        const imageWrapper = this.querySelector('.ai-premium-image-text-image-wrapper-{{ ai_gen_id }}');
        if (imageWrapper) {
          imageWrapper.addEventListener('mouseenter', this.handleMouseEnter.bind(this));
          imageWrapper.addEventListener('mouseleave', this.handleMouseLeave.bind(this));
        }
      }

      setupParallax() {
        const image = this.querySelector('.ai-premium-image-text-image-{{ ai_gen_id }}');
        if (!image) return;

        const handleScroll = () => {
          const rect = this.getBoundingClientRect();
          const scrolled = window.pageYOffset;
          const rate = scrolled * this.parallaxSpeed;

          if (rect.top <= window.innerHeight && rect.bottom >= 0) {
            image.style.transform = `translateY(${rate}px)`;
          }
        };

        window.addEventListener('scroll', handleScroll, { passive: true });
      }

      handleMouseEnter() {
      }

      handleMouseLeave() {
      }
    }

    customElements.define('premium-image-text-{{ ai_gen_id }}', PremiumImageText{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Premium image with text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        {
          "value": "image_left",
          "label": "Left"
        },
        {
          "value": "image_right",
          "label": "Right"
        },
        {
          "value": "image_top",
          "label": "Top"
        },
        {
          "value": "image_bottom",
          "label": "Bottom"
        }
      ],
      "default": "image_left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Container max width",
      "min": 800,
      "max": 1800,
      "step": 100,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Gap between image and text",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_content_gap",
      "label": "Mobile gap",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Section background"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "enable_gradient_overlay",
      "label": "Enable gradient overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "gradient_color_1",
      "label": "Gradient color 1",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Gradient color 2",
      "default": "#f4f4f4"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Gradient angle",
      "min": 0,
      "max": 360,
      "step": 5,
      "unit": "deg",
      "default": 135
    },
    {
      "type": "range",
      "id": "gradient_opacity",
      "label": "Gradient opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.5
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "label": "Padding horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_section_padding",
      "label": "Mobile padding vertical",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_width_percent",
      "label": "Image width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "value": "natural",
          "label": "Natural"
        },
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "16 / 9",
          "label": "Wide (16:9)"
        },
        {
          "value": "3 / 4",
