
{% doc %}
  @prompt
    MOTION SPORTS – Editorial Search Header
    Version 2.0

    Eigenständige Suche ohne Suggestions.
    Direkte Navigation zur Shopify-Suchseite.
    Rapid Search übernimmt anschließend die Ergebnisse.

    Design:
    - Editorial Search Header
    - Shiny Hover Button
    - Responsive
    - Individuelle Einstellungen
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}

.ai-search-header-{{ ai_gen_id }} {
  display: block;
  width: {{ block.settings.desktop_width_percent }}%;
  max-width: 100%;
  margin: 0 auto;
  padding: {{ block.settings.vertical_spacing }}px 24px;
  color: #0a0b0c;
  background: {{ block.settings.background_color }};
}

.ai-search-header-{{ ai_gen_id }}__content {
  width: 100%;
  max-width: 860px;
  margin: 0 auto;
  text-align: center;
}

.ai-search-header-{{ ai_gen_id }}__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin: 0 0 16px;
  color: #4b4b4b;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.2em;
  line-height: 1.4;
  text-transform: uppercase;
}

.ai-search-header-{{ ai_gen_id }}__eyebrow::before,
.ai-search-header-{{ ai_gen_id }}__eyebrow::after {
  display: block;
  width: 24px;
  height: 1px;
  background: #a9a9a4;
  content: '';
}

.ai-search-header-{{ ai_gen_id }}__title {
  margin: 0;
  color: #0a0b0c;
  font-size: clamp(
    32px,
    5vw,
    {{ block.settings.title_size }}px
  );
  font-weight: 400;
  letter-spacing: -0.045em;
  line-height: 1.08;
}

.ai-search-header-{{ ai_gen_id }}__text {
  max-width: 560px;
  margin: 14px auto 0;
  color: #424242;
  font-size: 14px;
  line-height: 1.7;
}

/* =========================================
   SEARCH WRAPPER
   ========================================= */

.ai-search-header-{{ ai_gen_id }}__search {
  display: flex;
  width: 100%;
  max-width: 680px;
  min-height: 64px;
  margin: 32px auto 0;
  padding: 5px;
  border: 1px solid #d2d2ce;
  border-radius: 4px;
  background: #fff;
  text-align: left;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.ai-search-header-{{ ai_gen_id }}__search:focus-within {
  border-color: #777;
  box-shadow: 0 0 0 3px rgba(10, 11, 12, 0.08);
}

/* =========================================
   INPUT
   ========================================= */

.ai-search-header-{{ ai_gen_id }}__input {
  flex: 1 1 auto;
  width: 100%;
  min-width: 0;
  padding: 0 20px;
  border: 0;
  border-radius: 2px 0 0 2px;
  outline: none;
  background: transparent;
  color: #0a0b0c;
  font: inherit;
  font-size: 15px;
  box-shadow: none;
  appearance: none;
  -webkit-appearance: none;
}

.ai-search-header-{{ ai_gen_id }}__input::placeholder {
  color: #595959;
  opacity: 1;
}

.ai-search-header-{{ ai_gen_id }}__input:focus {
  outline: none;
  box-shadow: none;
}

/* =========================================
   BUTTON
   ========================================= */

.ai-search-header-{{ ai_gen_id }}__button {
  position: relative;
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-width: 148px;
  padding: 0 22px;
  overflow: hidden;
  isolation: isolate;

  border: 1px solid {{ block.settings.button_color }};
  border-radius: 2px;

  background: {{ block.settings.button_color }};
  color: {{ block.settings.button_text_color }};

  cursor: pointer;
  font: inherit;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;

  transition:
    background-color 0.22s ease,
    border-color 0.22s ease,
    color 0.22s ease,
    transform 0.22s ease;
}

/* =========================================
   SHINY EFFECT
   ========================================= */

.ai-search-header-{{ ai_gen_id }}__button::before {
  position: absolute;
  z-index: -1;
  top: -60%;
  left: -75%;
  width: 48%;
  height: 220%;

  background: linear-gradient(
    105deg,
    transparent 0%,
    rgba(255,255,255,0.12) 25%,
    rgba(255,255,255,0.78) 50%,
    rgba(255,255,255,0.12) 75%,
    transparent 100%
  );

  content: '';
  opacity: 0;
  transform: skewX(-20deg);

  transition:
    left 0.65s ease,
    opacity 0.18s ease;
}

.ai-search-header-{{ ai_gen_id }}__button:hover {
  border-color: #008ccb;
  background: #008ccb;
  color: #fff;
  transform: translateY(-1px);
}

.ai-search-header-{{ ai_gen_id }}__button:hover::before {
  left: 130%;
  opacity: 1;
}

.ai-search-header-{{ ai_gen_id }}__button:focus-visible {
  outline: 2px solid #0a0b0c;
  outline-offset: 3px;
}

.ai-search-header-{{ ai_gen_id }}__icon {
  display: block;
  width: 18px;
  height: 18px;
  flex: 0 0 auto;
}

/* =========================================
   DECORATIVE RULE
   ========================================= */

.ai-search-header-{{ ai_gen_id }}__rule {
  width: 44px;
  height: 1px;
  margin: 28px auto 0;
  border: 0;
  background: #aaa9a4;
}

/* =========================================
   MOBILE
   ========================================= */

@media screen and (max-width: 600px) {

  .ai-search-header-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.mobile_spacing }}px 18px;
  }

  .ai-search-header-{{ ai_gen_id }}__search {
    min-height: 56px;
    margin-top: 24px;
  }

  .ai-search-header-{{ ai_gen_id }}__input {
    padding: 0 12px;
    font-size: 14px;
  }

  .ai-search-header-{{ ai_gen_id }}__button {
    min-width: 52px;
    width: 52px;
    padding: 0;
  }

  .ai-search-header-{{ ai_gen_id }}__button-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

}

/* =========================================
   REDUCED MOTION
   ========================================= */

@media (prefers-reduced-motion: reduce) {

  .ai-search-header-{{ ai_gen_id }}__search,
  .ai-search-header-{{ ai_gen_id }}__button,
  .ai-search-header-{{ ai_gen_id }}__button::before {
    transition: none;
  }

}

{% endstyle %}

<section
  class="ai-search-header-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>

  <div class="ai-search-header-{{ ai_gen_id }}__content">

    {% if block.settings.eyebrow != blank %}
      <p class="ai-search-header-{{ ai_gen_id }}__eyebrow">
        {{ block.settings.eyebrow | escape }}
      </p>
    {% endif %}

    <h1 class="ai-search-header-{{ ai_gen_id }}__title">
      {{ block.settings.heading | escape }}
    </h1>

    {% if block.settings.description != blank %}
      <p class="ai-search-header-{{ ai_gen_id }}__text">
        {{ block.settings.description | escape }}
      </p>
    {% endif %}

    {% comment %}
      Eigenständiges Suchfeld.

      Kein HTML-Suchformular.
      Keine Predictive-Search-Integration.
      Direkte Navigation zur Shopify-Suche.
    {% endcomment %}

    <div
      class="ai-search-header-{{ ai_gen_id }}__search"
      role="search"
    >

      <label
        class="visually-hidden"
        for="ai-search-input-{{ ai_gen_id }}"
      >
        {{ block.settings.input_label | escape }}
      </label>

      <input
        class="ai-search-header-{{ ai_gen_id }}__input"
        id="ai-search-input-{{ ai_gen_id }}"
        type="text"
        value="{{ search.terms | escape }}"
        placeholder="{{ block.settings.placeholder | escape }}"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        data-fh-search-input
      >

      <button
        class="ai-search-header-{{ ai_gen_id }}__button"
        type="button"
        aria-label="{{ block.settings.button_label | escape }}"
        data-fh-search-button
      >

        <svg
          class="ai-search-header-{{ ai_gen_id }}__icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <circle
            cx="10.8"
            cy="10.8"
            r="6.8"
            stroke="currentColor"
            stroke-width="1.7"
          ></circle>

          <path
            d="m16 16 4.3 4.3"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          ></path>
        </svg>

        <span class="ai-search-header-{{ ai_gen_id }}__button-label">
          {{ block.settings.button_label | escape }}
        </span>

      </button>

    </div>

    {% if block.settings.show_rule %}
      <hr class="ai-search-header-{{ ai_gen_id }}__rule">
    {% endif %}

  </div>

</section>

<script>
(function () {
  const blockId = {{ ai_gen_id | json }};
  const searchUrl = {{ routes.search_url | json }};

  const rootSelector = '.ai-search-header-' + blockId;

  function initializeSearch() {
    const root = document.querySelector(rootSelector);

    if (!root) return;

    const input = root.querySelector('[data-fh-search-input]');
    const button = root.querySelector('[data-fh-search-button]');

    if (!input || !button) return;

    if (root.dataset.fhSearchInitialized === 'true') return;

    root.dataset.fhSearchInitialized = 'true';

    function performSearch() {
      const query = input.value.trim();

      if (!query) {
        input.focus();
        return;
      }

      const url = new URL(searchUrl, window.location.origin);

      url.searchParams.set('q', query);
      url.searchParams.set('options[prefix]', 'last');

      window.location.assign(url.toString());
    }

    // Enter startet die Suche
    input.addEventListener('keydown', function (event) {
      if (event.key === 'Enter' && !event.isComposing) {
        event.preventDefault();
        event.stopPropagation();
        performSearch();
      }
    });

    // Klick auf den Suchbutton
    button.addEventListener('click', function (event) {
      event.preventDefault();
      performSearch();
    });
  }

  // Normale Seitenladung
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeSearch);
  } else {
    initializeSearch();
  }

  // Shopify Theme Editor
  document.addEventListener('shopify:section:load', initializeSearch);
  document.addEventListener('shopify:block:select', initializeSearch);

})();
</script>

{% schema %}
{
  "name": "Suchkopf",
  "settings": [
    {
      "type": "header",
      "content": "Text und Suche"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Unterzeile",
      "default": "MOTION SPORTS · EQUIPMENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Was suchst du?"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Beschreibung",
      "default": "Entdecke hochwertiges Equipment für dein Training."
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Barrierefreier Feldname",
      "default": "Suchbegriff"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Platzhalter im Suchfeld",
      "default": "Produkte, Marken oder Kategorien suchen"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Buttonbeschriftung",
      "default": "Suchen"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop-Breite",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Überschriftgröße",
      "min": 36,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "vertical_spacing",
      "label": "Abstand oben und unten",
      "min": 24,
      "max": 96,
      "step": 8,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_spacing",
      "label": "Abstand mobil",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 35
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrund",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button-Hintergrund",
      "default": "#0a0b0c"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button-Text",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Dezente Linie anzeigen",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Suchkopf"
    }
  ],
  "tag": null,
  "class": "editorial-search-header"
}
{% endschema %}
