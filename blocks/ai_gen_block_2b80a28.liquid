{% doc %}
  @prompt
    ich benötige ein neues Featured blog slider in welchem wir unsere verschiedenen blogs vorstellen können. Diese sollen dann verlinkt sein. Der Slider soll voll einstellbar sein, Farbe, Größe, Abstand, Hintergrund, Button, Überschrift etc. Das Desing soll modern und schlicht sein. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-slider-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    display: block;
  }

  .ai-blog-slider-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-blog-slider-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-blog-slider-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-blog-slider-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 8px 0 0;
  }

  .ai-blog-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-blog-slider-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    transition: transform 0.4s ease;
  }

  .ai-blog-slider-card-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - {{ block.settings.card_gap }}px * ({{ block.settings.slides_per_view }} - 1)) / {{ block.settings.slides_per_view }});
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }

  .ai-blog-slider-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .ai-blog-slider-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-blog-slider-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ai-blog-slider-card-{{ ai_gen_id }}:hover .ai-blog-slider-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-blog-slider-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-blog-slider-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-blog-slider-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-blog-slider-blog-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.blog_title_size }}px;
    color: {{ block.settings.card_text_color }};
    margin: 0 0 8px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-blog-slider-blog-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.blog_description_size }}px;
    color: {{ block.settings.card_text_color }};
    margin: 0 0 16px;
    line-height: 1.5;
    opacity: 0.8;
  }

  .ai-blog-slider-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: background-color 0.3s ease, transform 0.2s ease;
    border: none;
    cursor: pointer;
  }

  .ai-blog-slider-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    transform: translateY(-2px);
  }

  .ai-blog-slider-nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: {{ block.settings.navigation_spacing }}px;
  }

  .ai-blog-slider-nav-button-{{ ai_gen_id }} {
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_background }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .ai-blog-slider-nav-button-{{ ai_gen_id }}:hover:not(:disabled) {
    background-color: {{ block.settings.nav_button_hover_background }};
    transform: scale(1.1);
  }

  .ai-blog-slider-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-blog-slider-nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-blog-slider-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-blog-slider-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    padding: 0;
  }

  .ai-blog-slider-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  .ai-blog-slider-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-size: 16px;
  }

  @media screen and (max-width: 989px) {
    .ai-blog-slider-card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.card_gap }}px) / 2);
    }

    .ai-blog-slider-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-blog-slider-card-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-blog-slider-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-blog-slider-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }
  }
{% endstyle %}

<blog-slider-{{ ai_gen_id }} class="ai-blog-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-slider-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-blog-slider-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-blog-slider-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-blog-slider-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% assign has_blogs = false %}
    {% for i in (1..6) %}
      {% assign blog_key = 'blog_' | append: i %}
      {% if block.settings[blog_key] != blank %}
        {% assign has_blogs = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_blogs %}
      <div class="ai-blog-slider-wrapper-{{ ai_gen_id }}">
        <div class="ai-blog-slider-track-{{ ai_gen_id }}" data-slider-track>
          {% for i in (1..6) %}
            {% assign blog_key = 'blog_' | append: i %}
            {% assign blog = block.settings[blog_key] %}
            
            {% if blog != blank %}
              <div class="ai-blog-slider-card-{{ ai_gen_id }}" data-blog-url="{{ blog.url }}">
                <div class="ai-blog-slider-image-wrapper-{{ ai_gen_id }}">
                  {% if blog.articles.first.image %}
                    <img
                      src="{{ blog.articles.first.image | image_url: width: 800 }}"
                      alt="{{ blog.articles.first.image.alt | escape }}"
                      class="ai-blog-slider-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="800"
                      height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                    >
                  {% else %}
                    <div class="ai-blog-slider-image-placeholder-{{ ai_gen_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <div class="ai-blog-slider-content-{{ ai_gen_id }}">
                  <h3 class="ai-blog-slider-blog-title-{{ ai_gen_id }}">{{ blog.title }}</h3>
                  {% if blog.articles.first.excerpt != blank %}
                    <p class="ai-blog-slider-blog-description-{{ ai_gen_id }}">
                      {{ blog.articles.first.excerpt | strip_html | truncate: 120 }}
                    </p>
                  {% endif %}
                  <a href="{{ blog.url }}" class="ai-blog-slider-button-{{ ai_gen_id }}">
                    {{ block.settings.button_text }}
                  </a>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      {% if block.settings.show_navigation %}
        <div class="ai-blog-slider-nav-{{ ai_gen_id }}">
          <button
            class="ai-blog-slider-nav-button-{{ ai_gen_id }}"
            data-slider-prev
            aria-label="Vorheriger Slide"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          {% if block.settings.show_dots %}
            <div class="ai-blog-slider-dots-{{ ai_gen_id }}" data-slider-dots></div>
          {% endif %}

          <button
            class="ai-blog-slider-nav-button-{{ ai_gen_id }}"
            data-slider-next
            aria-label="Nächster Slide"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-blog-slider-empty-state-{{ ai_gen_id }}">
        Fügen Sie Blogs hinzu, um den Slider anzuzeigen
      </div>
    {% endif %}
  </div>
</blog-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class BlogSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.slidesPerView = {{ block.settings.slides_per_view }};
        this.autoplay = {{ block.settings.autoplay }};
        this.autoplayDelay = {{ block.settings.autoplay_delay }} * 1000;
        this.autoplayTimer = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-slider-track]');
        this.prevButton = this.querySelector('[data-slider-prev]');
        this.nextButton = this.querySelector('[data-slider-next]');
        this.dotsContainer = this.querySelector('[data-slider-dots]');
        this.cards = this.querySelectorAll('.ai-blog-slider-card-{{ ai_gen_id }}');

        if (!this.track || this.cards.length === 0) return;

        this.totalSlides = this.cards.length;
        this.updateSlidesPerView();
        this.setupEventListeners();
        this.createDots();
        this.updateSlider();

        if (this.autoplay) {
          this.startAutoplay();
        }

        window.addEventListener('resize', () => this.handleResize());
      }

      updateSlidesPerView() {
        const width = window.innerWidth;
        if (width <= 749) {
          this.slidesPerView = 1;
        } else if (width <= 989) {
          this.slidesPerView = 2;
        } else {
          this.slidesPerView = {{ block.settings.slides_per_view }};
        }
        this.maxIndex = Math.max(0, this.totalSlides - this.slidesPerView);
      }

      handleResize() {
        this.updateSlidesPerView();
        this.currentIndex = Math.min(this.currentIndex, this.maxIndex);
        this.updateSlider();
        this.createDots();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }

        this.cards.forEach((card) => {
          card.addEventListener('click', (e) => {
            if (!e.target.closest('.ai-blog-slider-button-{{ ai_gen_id }}')) {
              const url = card.dataset.blogUrl;
              if (url) {
                window.location.href = url;
              }
            }
          });
        });

        if (this.autoplay) {
          this.addEventListener('mouseenter', () => this.stopAutoplay());
          this.addEventListener('mouseleave', () => this.startAutoplay());
        }
      }

      createDots() {
        if (!this.dotsContainer) return;

        this.dotsContainer.innerHTML = '';
        const dotsCount = this.maxIndex + 1;

        for (let i = 0; i < dotsCount; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-blog-slider-dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Gehe zu Slide ${i + 1}`);
          if (i === this.currentIndex) {
            dot.classList.add('active');
          }
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      updateSlider() {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = {{ block.settings.card_gap }};
        const offset = -(this.currentIndex * (cardWidth + gap));
        this.track.style.transform = `translateX(${offset}px)`;

        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex >= this.maxIndex;
        }

        this.updateDots();
      }

      updateDots() {
        if (!this.dotsContainer) return;

        const dots = this.dotsContainer.querySelectorAll('.ai-blog-slider-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateSlider();
          this.resetAutoplay();
        }
      }

      next() {
        if (this.currentIndex < this.maxIndex) {
          this.currentIndex++;
          this.updateSlider();
          this.resetAutoplay();
        } else if ({{ block.settings.loop }}) {
          this.currentIndex = 0;
          this.updateSlider();
          this.resetAutoplay();
        }
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateSlider();
        this.resetAutoplay();
      }

      startAutoplay() {
        if (!this.autoplay) return;
        this.stopAutoplay();
        this.autoplayTimer = setInterval(() => {
          if (this.currentIndex < this.maxIndex) {
            this.next();
          } else if ({{ block.settings.loop }}) {
            this.currentIndex = 0;
            this.updateSlider();
          } else {
            this.stopAutoplay();
          }
        }, this.autoplayDelay);
      }

      stopAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
          this.autoplayTimer = null;
        }
      }

      resetAutoplay() {
        if (this.autoplay) {
          this.stopAutoplay();
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
        window.removeEventListener('resize', () => this.handleResize());
      }
    }

    customElements.define('blog-slider-{{ ai_gen_id }}', BlogSlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
