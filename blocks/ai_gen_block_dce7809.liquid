{% doc %}
  @prompt
    baue das premium image with text genauso nach. Wir benötigen zusätzlich die option den abschnitt mobil zu optimiren und ansprechend zu desgingen lets go, das bild soll in einem edlen 3d format dargstellt werden können und der text soll auch mit hintergrund, farbe sowie der button mit effekten gestaltet werden, es muss noch einzustellen sein, wie viel von dem abschnitt das bild und der text einnimmt. als 70 30 oder anders, okay wir bekommen unser rechteckiges bild nicht in das format bitte so überarbeiten dass es komplett zu sehen ist, jetzt wird das element zu hoch bitte flacher darstellen, kannst du bitte einfügen, dass man mobil ein anderes bild pflegen kann
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign display_image = block.settings.image %}
{% if block.settings.mobile_image != blank %}{% assign display_image = block.settings.mobile_image %}{% endif %}
{% case block.settings.desktop_split %}{% when '70_30' %}{% assign image_share = 70 %}{% assign text_share = 30 %}{% when '60_40' %}{% assign image_share = 60 %}{% assign text_share = 40 %}{% when '40_60' %}{% assign image_share = 40 %}{% assign text_share = 60 %}{% when '30_70' %}{% assign image_share = 30 %}{% assign text_share = 70 %}{% else %}{% assign image_share = 50 %}{% assign text_share = 50 %}{% endcase %}
{% style %}
.ai-premium-image-text-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;padding:{{ block.settings.outer_padding }}px;color:{{ block.settings.text_color }};background:{{ block.settings.section_background }};border-radius:{{ block.settings.corner_radius }}px}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__layout{display:grid;grid-template-columns:minmax(0,{{ image_share }}fr) minmax(0,{{ text_share }}fr);align-items:center;gap:clamp(24px,4vw,64px)}.ai-premium-image-text-{{ ai_gen_id }}.ai-premium-image-text--image-right .ai-premium-image-text__layout{grid-template-columns:minmax(0,{{ text_share }}fr) minmax(0,{{ image_share }}fr)}.ai-premium-image-text-{{ ai_gen_id }}.ai-premium-image-text--image-right .ai-premium-image-text__media{order:2}.ai-premium-image-text-{{ ai_gen_id }}.ai-premium-image-text--image-right .ai-premium-image-text__content{order:1}
.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__media{position:relative;min-width:0;aspect-ratio:{{ block.settings.image_ratio }};perspective:1200px}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__image-frame{position:absolute;inset:0;overflow:hidden;border-radius:{{ block.settings.image_radius }}px;background:{{ block.settings.image_background }};transform:rotateY({{ block.settings.image_tilt }}deg) rotateX({{ block.settings.image_lift }}deg);box-shadow:0 {{ block.settings.shadow_depth }}px {{ block.settings.shadow_blur }}px rgba(0,0,0,{{ block.settings.shadow_opacity | divided_by:100.0 }});transform-style:preserve-3d;transition:transform .35s ease,box-shadow .35s ease;display:flex;align-items:center;justify-content:center}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__media:hover .ai-premium-image-text__image-frame{transform:rotateY({{ block.settings.image_tilt | times:0.5 }}deg) rotateX(0deg) translateY(-{{ block.settings.hover_lift }}px) translateZ(12px);box-shadow:0 {{ block.settings.shadow_depth | plus:8 }}px {{ block.settings.shadow_blur | plus:12 }}px rgba(0,0,0,{{ block.settings.shadow_opacity | divided_by:100.0 }})}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__image-frame img{display:block;width:100%;height:100%;object-fit:contain;object-position:center}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__placeholder{position:relative;width:100%;height:100%}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__placeholder svg{display:block;width:100%;height:100%;color:#77736c;object-fit:contain}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__empty-state{position:absolute;inset:auto 16px 16px;color:#393832;font-size:13px;line-height:1.5}
.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__content{padding:clamp(16px,3vw,{{ block.settings.content_padding }}px);text-align:{{ block.settings.text_alignment }};color:{{ block.settings.panel_text_color }};background:{{ block.settings.panel_background }};border:{{ block.settings.panel_border_width }}px solid {{ block.settings.panel_border_color }};border-radius:{{ block.settings.panel_radius }}px;box-shadow:0 {{ block.settings.panel_shadow }}px {{ block.settings.panel_shadow | times:2 }}px rgba(0,0,0,.08)}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__eyebrow{margin:0 0 12px;color:{{ block.settings.accent_color }};font-size:11px;font-weight:700;letter-spacing:.16em;line-height:1.4;text-transform:uppercase}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__heading{margin:0 0 14px;color:{{ block.settings.panel_text_color }};font-size:clamp(26px,2.8vw,{{ block.settings.heading_size }}px);font-weight:500;letter-spacing:-.035em;line-height:1.1}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__body{font-size:{{ block.settings.body_size }}px;line-height:1.65}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__body p{margin:0 0 10px}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__body p:last-child{margin-bottom:0}
.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__link{display:inline-flex;align-items:center;justify-content:center;min-height:44px;margin-top:20px;padding:11px 22px;border:1px solid {{ block.settings.button_color }};border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font-size:12px;font-weight:700;letter-spacing:.08em;line-height:1.2;text-decoration:none;text-transform:uppercase;box-shadow:0 4px 12px rgba(0,0,0,.16);transition:background .2s ease,color .2s ease,transform .2s ease,box-shadow .2s ease}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__link:hover{background:{{ block.settings.button_hover_color }};border-color:{{ block.settings.button_hover_color }};color:{{ block.settings.button_hover_text_color }};{% if block.settings.button_effect == 'raise' %}transform:translateY(-3px);box-shadow:0 9px 20px rgba(0,0,0,.22);{% elsif block.settings.button_effect == 'scale' %}transform:scale(1.04);box-shadow:0 8px 18px rgba(0,0,0,.2);{% endif %}}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__link:focus-visible{outline:2px solid {{ block.settings.accent_color }};outline-offset:4px}@media(prefers-reduced-motion:reduce){.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__image-frame,.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__link{transition:none}}
@media screen and (max-width:749px){.ai-premium-image-text-{{ ai_gen_id }}{width:100%;padding:{{ block.settings.mobile_outer_padding }}px}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__layout,.ai-premium-image-text-{{ ai_gen_id }}.ai-premium-image-text--image-right .ai-premium-image-text__layout{display:flex;flex-direction:column;gap:{{ block.settings.mobile_gap }}px}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__media,.ai-premium-image-text-{{ ai_gen_id }}.ai-premium-image-text--image-right .ai-premium-image-text__media{order:{% if block.settings.mobile_image_position == 'bottom' %}2{% else %}1{% endif %};width:100%;aspect-ratio:{{ block.settings.mobile_image_ratio }}}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__content,.ai-premium-image-text-{{ ai_gen_id }}.ai-premium-image-text--image-right .ai-premium-image-text__content{order:{% if block.settings.mobile_image_position == 'bottom' %}1{% else %}2{% endif %};width:100%;padding:{{ block.settings.mobile_padding }}px;text-align:{{ block.settings.mobile_text_alignment }}}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__heading{font-size:{{ block.settings.mobile_heading_size }}px}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__body{font-size:{{ block.settings.mobile_body_size }}px}.ai-premium-image-text-{{ ai_gen_id }} .ai-premium-image-text__link{width:{% if block.settings.mobile_button_full_width %}100%{% else %}auto{% endif %}}}
{% endstyle %}
<div class="ai-premium-image-text-{{ ai_gen_id }}{% if block.settings.image_position == 'right' %} ai-premium-image-text--image-right{% endif %}" {{ block.shopify_attributes }}><div class="ai-premium-image-text__layout"><div class="ai-premium-image-text__media"><div class="ai-premium-image-text__image-frame">{% if display_image %}<picture>{% if block.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width:1200 }}">{% endif %}<img src="{{ block.settings.image | image_url: width:2000 }}" alt="{{ display_image.alt | escape }}" loading="lazy" width="{{ display_image.width }}" height="{{ display_image.height }}"></picture>{% else %}<div class="ai-premium-image-text__placeholder">{{ 'image' | placeholder_svg_tag }}<div class="ai-premium-image-text__empty-state">Füge ein hochwertiges Bild hinzu, um diesen Abschnitt zu vervollständigen.</div></div>{% endif %}</div></div><div class="ai-premium-image-text__content">{% if block.settings.eyebrow != blank %}<p class="ai-premium-image-text__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}{% if block.settings.heading != blank %}<h2 class="ai-premium-image-text__heading">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.body != blank %}<div class="ai-premium-image-text__body">{{ block.settings.body }}</div>{% endif %}{% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="ai-premium-image-text__link" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}</div></div></div>
{% schema %}
{"name":"Premium image mit Text","settings":[{"type":"header","content":"Inhalt"},{"type":"image_picker","id":"image","label":"Bild Desktop"},{"type":"image_picker","id":"mobile_image","label":"Bild mobil","info":"Optional. Wird auf Mobilgeräten statt des Desktop-Bildes angezeigt."},{"type":"text","id":"eyebrow","label":"Überzeile","default":"Für dein Training gemacht"},{"type":"text","id":"heading","label":"Überschrift","default":"Kraft, die sich richtig anfühlt."},{"type":"richtext","id":"body","label":"Text","default":"<p>Entdecke ausgewähltes Equipment, das durchdachtes Design, langlebige Materialien und ein besonderes Trainingserlebnis verbindet.</p>"},{"type":"text","id":"button_label","label":"Button-Text","default":"Jetzt entdecken"},{"type":"url","id":"button_link","label":"Button-Link"},{"type":"header","content":"Desktop-Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop-Breite","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"select","id":"desktop_split","label":"Bild- und Textanteil","options":[{"value":"70_30","label":"70 % Bild / 30 % Text"},{"value":"60_40","label":"60 % Bild / 40 % Text"},{"value":"50_50","label":"50 % Bild / 50 % Text"},{"value":"40_60","label":"40 % Bild / 60 % Text"},{"value":"30_70","label":"30 % Bild / 70 % Text"}],"default":"50_50"},{"type":"select","id":"image_position","label":"Bildposition","options":[{"value":"left","label":"Links"},{"value":"right","label":"Rechts"}],"default":"left"},{"type":"select","id":"image_ratio","label":"Bildformat Desktop","options":[{"value":"21 / 9","label":"Extra flach (21:9)"},{"value":"16 / 9","label":"Flach (16:9)"},{"value":"4 / 3","label":"Querformat (4:3)"},{"value":"1 / 1","label":"Quadratisch"},{"value":"3 / 4","label":"Hochformat"}],"default":"16 / 9"},{"type":"range","id":"image_tilt","label":"3D-Neigung seitlich","min":0,"max":12,"step":2,"unit":"°","default":4},{"type":"range","id":"image_lift","label":"3D-Neigung nach vorn","min":0,"max":10,"step":2,"unit":"°","default":2},{"type":"range","id":"shadow_depth","label":"Bild-Schatten Tiefe","min":4,"max":32,"step":4,"unit":"px","default":16},{"type":"range","id":"shadow_blur","label":"Bild-Schatten Weichheit","min":10,"max":50,"step":5,"unit":"px","default":25},{"type":"range","id":"shadow_opacity","label":"Bild-Schatten Stärke","min":10,"max":60,"step":5,"unit":"%","default":25},{"type":"range","id":"hover_lift","label":"Anhebung beim Hover","min":0,"max":12,"step":2,"unit":"px","default":4},{"type":"select","id":"text_alignment","label":"Textausrichtung Desktop","options":[{"value":"left","label":"Links"},{"value":"center","label":"Zentriert"}],"default":"left"},{"type":"range","id":"heading_size","label":"Überschrift Desktop","min":28,"max":64,"step":4,"unit":"px","default":44},{"type":"range","id":"body_size","label":"Textgröße Desktop","min":14,"max":22,"step":2,"unit":"px","default":16},{"type":"range","id":"content_padding","label":"Innenabstand Desktop","min":20,"max":80,"step":5,"unit":"px","default":40},{"type":"header","content":"Bildstil"},{"type":"color","id":"image_background","label":"Hintergrund bei abweichendem Bildformat","default":"#F1F0ED"},{"type":"header","content":"Textfläche"},{"type":"color","id":"panel_background","label":"Hintergrund Textfläche","default":"#F4F1EC"},{"type":"color","id":"panel_text_color","label":"Textfarbe Textfläche","default":"#0A0B0C"},{"type":"color","id":"panel_border_color","label":"Rahmenfarbe","default":"#E4E0D9"},{"type":"range","id":"panel_border_width","label":"Rahmenstärke","min":0,"max":4,"step":1,"unit":"px","default":0},{"type":"range","id":"panel_radius","label":"Eckenradius Textfläche","min":0,"max":40,"step":4,"unit":"px","default":8},{"type":"range","id":"panel_shadow","label":"Schatten Textfläche","min":0,"max":20,"step":2,"unit":"px","default":4},{"type":"header","content":"Button-Stil"},{"type":"color","id":"button_color","label":"Button-Hintergrund","default":"#0A0B0C"},{"type":"color","id":"button_text_color","label":"Button-Text","default":"#FFFFFF"},{"type":"color","id":"button_hover_color","label":"Hover-Hintergrund","default":"#49574A"},{"type":"color","id":"button_hover_text_color","label":"Hover-Text","default":"#FFFFFF"},{"type":"select","id":"button_effect","label":"Hover-Effekt","options":[{"value":"none","label":"Keiner"},{"value":"raise","label":"Anheben"},{"value":"scale","label":"Vergrößern"}],"default":"raise"},{"type":"range","id":"button_radius","label":"Button-Eckenradius","min":0,"max":32,"step":4,"unit":"px","default":4},{"type":"header","content":"Mobiles Layout"},{"type":"select","id":"mobile_image_position","label":"Bildposition mobil","options":[{"value":"top","label":"Oben"},{"value":"bottom","label":"Unten"}],"default":"top"},{"type":"select","id":"mobile_image_ratio","label":"Bildformat mobil","options":[{"value":"16 / 9","label":"Flach (16:9)"},{"value":"4 / 3","label":"Querformat (4:3)"},{"value":"1 / 1","label":"Quadratisch"},{"value":"3 / 4","label":"Hochformat"}],"default":"16 / 9"},{"type":"select","id":"mobile_text_alignment","label":"Textausrichtung mobil","options":[{"value":"left","label":"Links"},{"value":"center","label":"Zentriert"}],"default":"left"},{"type":"range","id":"mobile_heading_size","label":"Überschrift mobil","min":22,"max":40,"step":2,"unit":"px","default":30},{"type":"range","id":"mobile_body_size","label":"Textgröße mobil","min":13,"max":19,"step":1,"unit":"px","default":15},{"type":"range","id":"mobile_padding","label":"Innenabstand mobil","min":10,"max":40,"step":5,"unit":"px","default":20},{"type":"range","id":"mobile_gap","label":"Abstand mobil","min":0,"max":40,"step":5,"unit":"px","default":15},{"type":"range","id":"mobile_outer_padding","label":"Außenabstand mobil","min":0,"max":24,"step":4,"unit":"px","default":8},{"type":"checkbox","id":"mobile_button_full_width","label":"Button mobil volle Breite","default":true},{"type":"header","content":"Farben und Flächen"},{"type":"color","id":"section_background","label":"Abschnitt-Hintergrund","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Standard-Textfarbe","default":"#0A0B0C"},{"type":"color","id":"accent_color","label":"Akzentfarbe","default":"#49574A"},{"type":"range","id":"outer_padding","label":"Abschnitt-Innenabstand","min":0,"max":40,"step":5,"unit":"px","default":0},{"type":"range","id":"image_radius","label":"Bild-Eckenradius","min":0,"max":40,"step":4,"unit":"px","default":8},{"type":"range","id":"corner_radius","label":"Abschnitt-Eckenradius","min":0,"max":40,"step":4,"unit":"px","default":8}],"presets":[{"name":"Premium image mit Text"}],"tag":null,"class":"premium-image-text-block"}
{% endschema %}