<script>
(function(){

  class C{{ ai_gen_id }} extends HTMLElement {

    connectedCallback(){

      /* ============================================================
         MOBILE FILTER TOGGLE
      ============================================================ */

      const mobileFilterToggle = this.querySelector('[data-mobile-filter-toggle]');
      const mobileFilterPanel = this.querySelector('[data-mobile-filter-panel]');

      if (mobileFilterToggle && mobileFilterPanel) {

        mobileFilterToggle.addEventListener('click', () => {

          const isOpen = mobileFilterPanel.classList.toggle('is-open');

          mobileFilterToggle.setAttribute(
            'aria-expanded',
            isOpen ? 'true' : 'false'
          );

          const label = mobileFilterToggle.querySelector('span:first-child');

          if (label) {
            label.textContent = isOpen ? 'Filter ausblenden' : 'Filter anzeigen';
          }

        });

      }

      /* ============================================================
         NUMERIC FILTER SLIDER
      ============================================================ */

      this.querySelectorAll('[data-numeric-slider]').forEach(slider => {

        const range = slider.querySelector('[data-numeric-range]');
        const output = slider.querySelector('[data-numeric-output]');
        const inputs = Array.from(slider.querySelectorAll('[data-numeric-value]'));

        if (!range || !output || !inputs.length) return;

        const syncOutput = () => {
          const index = Number(range.value);
          const current = inputs[index];
          output.textContent = current ? current.dataset.label : '';
        };

        syncOutput();

        range.addEventListener('input', syncOutput);

        range.addEventListener('change', () => {

          const selectedIndex = Number(range.value);

          inputs.forEach(input => {
            const index = Number(input.dataset.index);
            input.checked = index >= selectedIndex;
          });

          range.form.submit();

        });

      });


      /* ============================================================
         QUICK ADD TO CART
      ============================================================ */

      this.querySelectorAll('[data-id]').forEach(button => {

        button.addEventListener('click', async (event) => {

          event.preventDefault();
          event.stopPropagation();

          const variantId = Number(button.dataset.id);

          if (!variantId || button.disabled) return;

          const root =
            window.Shopify &&
            window.Shopify.routes &&
            window.Shopify.routes.root
              ? window.Shopify.routes.root
              : '/';

          const addUrl = root + 'cart/add.js';
          const cartUrl = root + 'cart.js';

          button.disabled = true;
          button.setAttribute('aria-busy', 'true');

          try {

            /* Produkt wirklich in Shopify-Warenkorb legen */

            const addResponse = await fetch(addUrl, {
              method: 'POST',
              credentials: 'same-origin',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({
                items: [
                  {
                    id: variantId,
                    quantity: 1
                  }
                ]
              })
            });

            const addData = await addResponse.json().catch(() => ({}));

            if (!addResponse.ok) {
              throw new Error(
                addData.description ||
                addData.message ||
                'Produkt konnte nicht in den Warenkorb gelegt werden.'
              );
            }


            /* Aktuellen Warenkorb erneut von Shopify laden */

            const cartResponse = await fetch(cartUrl, {
              method: 'GET',
              credentials: 'same-origin',
              headers: {
                'Accept': 'application/json'
              },
              cache: 'no-store'
            });

            if (!cartResponse.ok) {
              throw new Error('Warenkorb konnte nicht aktualisiert werden.');
            }

            const cart = await cartResponse.json();


            /* Theme-Events auslösen */

            const detail = {
              cart: cart,
              product: addData,
              variantId: variantId,
              source: 'premium-collection-grid'
            };

            document.dispatchEvent(
              new CustomEvent('cart:refresh', {
                bubbles: true,
                detail: detail
              })
            );

            document.dispatchEvent(
              new CustomEvent('cart:change', {
                bubbles: true,
                detail: detail
              })
            );

            document.dispatchEvent(
              new CustomEvent('ajaxProduct:added', {
                bubbles: true,
                detail: {
                  product: addData,
                  addToCartBtn: button,
                  cart: cart
                }
              })
            );


            /* Häufige Cart-Counter direkt aktualisieren */

            document
              .querySelectorAll(
                '[data-cart-count], [data-header-cart-count]'
              )
              .forEach(counter => {
                counter.textContent = cart.item_count;
                counter.removeAttribute('hidden');
              });


            /* Essence / Sidebar-Warenkorb öffnen */

            setTimeout(() => {

              const cartHandle =
                document.querySelector(
                  '[data-js-sidebar-handle][aria-controls="site-cart-sidebar"]'
                ) ||
                document.querySelector('.button--cart-handle');

              if (
                cartHandle &&
                cartHandle.getAttribute('aria-expanded') !== 'true'
              ) {
                cartHandle.click();
              }

            }, 200);


          } catch(error) {

            console.error(
              '[Premium Collection Grid] Add to cart error:',
              error
            );

            alert(
              error && error.message
                ? error.message
                : 'Das Produkt konnte nicht in den Warenkorb gelegt werden.'
            );

          } finally {

            button.disabled = false;
            button.removeAttribute('aria-busy');

          }

        });

      });

    }

  }


  const elementName = 'collection-grid-{{ ai_gen_id }}';

  if (!customElements.get(elementName)) {
    customElements.define(
      elementName,
      C{{ ai_gen_id }}
    );
  }

})();
</script>


