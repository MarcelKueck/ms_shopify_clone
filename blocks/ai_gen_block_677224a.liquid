{% doc %}
  Premium Collection Grid
  Collection-spezifische Filtersteuerung.
  Search & Discovery stellt die Shopify Filter-Engine bereit.
  Auswahl, Reihenfolge und Darstellung erfolgen hier im Block.
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}

/* ============================================================
   SECTION
============================================================ */

.ai-{{ ai_gen_id }} {
  display: block;
  width: {{ block.settings.desktop_width }}%;
  padding: {{ block.settings.section_padding }}px;
  background: {{ block.settings.section_background }};
  color: {{ block.settings.text_color }};
  font-family: {{ block.settings.body_font.family }};
}

.ai-{{ ai_gen_id }}__layout {
  display: grid;
  grid-template-columns: {{ block.settings.filter_width }}px 1fr;
  gap: {{ block.settings.layout_gap }}px;
}


/* ============================================================
   FILTER SIDEBAR
============================================================ */

.ai-{{ ai_gen_id }}__sidebar {
  padding: {{ block.settings.filter_padding }}px;
  background: {{ block.settings.filter_background }};
  border-radius: {{ block.settings.card_radius }}px;
  align-self: start;
}

.ai-{{ ai_gen_id }}__sidebar-title {
  margin: 0 0 15px;
  font-size: 18px;
  font-weight: 700;
}

.ai-{{ ai_gen_id }}__filter {
  padding: 12px 0;
  border-top: 1px solid #ddd;
}

.ai-{{ ai_gen_id }}__filter summary {
  cursor: pointer;
  font-weight: 600;
  margin-bottom: 8px;
}

.ai-{{ ai_gen_id }}__option {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 5px 0;
  font-size: {{ block.settings.filter_text_size }}px;
  cursor: pointer;
}

.ai-{{ ai_gen_id }}__option input {
  margin: 0;
}

.ai-{{ ai_gen_id }}__reset {
  display: inline-block;
  margin-top: 16px;
  color: inherit;
  font-size: {{ block.settings.filter_text_size }}px;
  text-decoration: underline;
}


/* ============================================================
   FILTER SWATCHES
============================================================ */

.ai-{{ ai_gen_id }}__filter-swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  padding-top: 5px;
}

.ai-{{ ai_gen_id }}__filter-swatch-wrap {
  position: relative;
  display: flex;
  align-items: center;
  cursor: pointer;
}

.ai-{{ ai_gen_id }}__filter-swatch-wrap input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.ai-{{ ai_gen_id }}__filter-swatch {
  display: block;
  width: 28px;
  height: 28px;
  flex: 0 0 28px;
  border-radius: 50%;
  border: 2px solid #fff;
  box-shadow: 0 0 0 1px rgba(0,0,0,.22);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  transition: transform .15s ease;
}

.ai-{{ ai_gen_id }}__filter-swatch-wrap:hover
.ai-{{ ai_gen_id }}__filter-swatch {
  transform: scale(1.08);
}

.ai-{{ ai_gen_id }}__filter-swatch-wrap.is-active
.ai-{{ ai_gen_id }}__filter-swatch {
  outline: 2px solid {{ block.settings.text_color }};
  outline-offset: 2px;
}

.ai-{{ ai_gen_id }}__filter-swatch-count {
  display: none;
}


/* ============================================================
   TOGGLE FILTER
============================================================ */

.ai-{{ ai_gen_id }}__toggle-option {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10px;
  padding: 5px 0;
  font-size: {{ block.settings.filter_text_size }}px;
  cursor: pointer;
}

.ai-{{ ai_gen_id }}__toggle-option input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

/* Toggle – kompakte Größe */
.ai-{{ ai_gen_id }}__toggle-switch {
  position: relative;
  display: inline-block;
  width: 28px;
  height: 16px;
  flex: 0 0 28px;
  border-radius: 999px;
  background: #d8dde3;
  transition: background .2s ease;
}

/* weißer Schalter */
.ai-{{ ai_gen_id }}__toggle-switch:after {
  content: '';
  position: absolute;
  top: 2px;
  left: 2px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 1px 2px rgba(0,0,0,.18);
  transition: transform .2s ease;
}

/* aktiv */
.ai-{{ ai_gen_id }}__toggle-option input:checked + .ai-{{ ai_gen_id }}__toggle-switch {
  background: {{ block.settings.quick_background }};
}

/* Schalter nach rechts */
.ai-{{ ai_gen_id }}__toggle-option input:checked + .ai-{{ ai_gen_id }}__toggle-switch:after {
  transform: translateX(12px);
}

/* ============================================================
   NUMERIC LIST SLIDER
============================================================ */

.ai-{{ ai_gen_id }}__numeric-slider {
  padding-top: 6px;
}

.ai-{{ ai_gen_id }}__numeric-slider-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 9px;
  font-size: {{ block.settings.filter_text_size }}px;
}

.ai-{{ ai_gen_id }}__numeric-slider-head strong {
  font-weight: 600;
  white-space: nowrap;
}

.ai-{{ ai_gen_id }}__numeric-range {
  width: 100%;
  height: 20px;
  margin: 6px 0 9px;
  padding: 0;
  border: 0;
  background: transparent;
  appearance: none;
  -webkit-appearance: none;
  cursor: pointer;
}

.ai-{{ ai_gen_id }}__numeric-range::-webkit-slider-runnable-track {
  width: 100%;
  height: 5px;
  border: 0;
  border-radius: 20px;
  background: #d8dce1;
}

.ai-{{ ai_gen_id }}__numeric-range::-webkit-slider-thumb {
  width: 19px;
  height: 19px;
  margin-top: -7px;
  border: 2px solid #fff;
  border-radius: 50%;
  background: {{ block.settings.quick_background }};
  box-shadow: 0 0 0 1px rgba(0,0,0,.16);
  appearance: none;
  -webkit-appearance: none;
  cursor: pointer;
}

.ai-{{ ai_gen_id }}__numeric-range::-moz-range-track {
  width: 100%;
  height: 5px;
  border: 0;
  border-radius: 20px;
  background: #d8dce1;
}

.ai-{{ ai_gen_id }}__numeric-range::-moz-range-thumb {
  width: 19px;
  height: 19px;
  border: 2px solid #fff;
  border-radius: 50%;
  background: {{ block.settings.quick_background }};
  box-shadow: 0 0 0 1px rgba(0,0,0,.16);
  cursor: pointer;
}

.ai-{{ ai_gen_id }}__numeric-slider-scale {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  font-size: 11px;
  opacity: .65;
}

.ai-{{ ai_gen_id }}__numeric-slider-inputs {
  display: none;
}

/* ============================================================
   PRICE SLIDER
============================================================ */

.ai-{{ ai_gen_id }}__price-slider {
  padding-top: 6px;
}

.ai-{{ ai_gen_id }}__price-slider-values {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 9px;
  font-size: {{ block.settings.filter_text_size }}px;
}

.ai-{{ ai_gen_id }}__price-slider-values strong {
  font-weight: 600;
  white-space: nowrap;
}

.ai-{{ ai_gen_id }}__price-range {
  width: 100%;
  height: 20px;
  margin: 6px 0 9px;
  padding: 0;
  border: 0;
  background: transparent;
  appearance: none;
  -webkit-appearance: none;
  cursor: pointer;
}

.ai-{{ ai_gen_id }}__price-range::-webkit-slider-runnable-track {
  width: 100%;
  height: 5px;
  border: 0;
  border-radius: 20px;
  background: #d8dce1;
}

.ai-{{ ai_gen_id }}__price-range::-webkit-slider-thumb {
  width: 19px;
  height: 19px;
  margin-top: -7px;
  border: 2px solid #fff;
  border-radius: 50%;
  background: {{ block.settings.quick_background }};
  box-shadow: 0 0 0 1px rgba(0,0,0,.16);
  appearance: none;
  -webkit-appearance: none;
  cursor: pointer;
}

.ai-{{ ai_gen_id }}__price-range::-moz-range-track {
  width: 100%;
  height: 5px;
  border: 0;
  border-radius: 20px;
  background: #d8dce1;
}

.ai-{{ ai_gen_id }}__price-range::-moz-range-thumb {
  width: 19px;
  height: 19px;
  border: 2px solid #fff;
  border-radius: 50%;
  background: {{ block.settings.quick_background }};
  box-shadow: 0 0 0 1px rgba(0,0,0,.16);
  cursor: pointer;
}

.ai-{{ ai_gen_id }}__price-scale {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  font-size: 11px;
  opacity: .65;
}


/* ============================================================
   PRODUCT GRID
============================================================ */

.ai-{{ ai_gen_id }}__grid {
  display: grid;
  grid-template-columns: repeat({{ block.settings.columns }}, minmax(0, 1fr));
  gap: {{ block.settings.grid_gap }}px;
  align-items: stretch;
}

.ai-{{ ai_gen_id }}__card {
  overflow: hidden;
  display: flex;
  flex-direction: column;
  height: 100%;
  background: {{ block.settings.card_background }};
  border-radius: {{ block.settings.card_radius }}px;
  box-shadow: 0 8px 20px #0002;
  transition: transform .2s, box-shadow .2s;
}

.ai-{{ ai_gen_id }}__card:hover {
  transform: translateY(-5px);
  box-shadow: 0 16px 30px #0003;
}

.ai-{{ ai_gen_id }}__media {
  position: relative;
  display: block;
  flex: 0 0 auto;
  aspect-ratio: 1;
  background: #f5f5f5;
}

.ai-{{ ai_gen_id }}__media img,
.ai-{{ ai_gen_id }}__media svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ai-{{ ai_gen_id }}__badges {
  position: absolute;
  top: 12px;
  right: 12px;
  left: auto;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
  pointer-events: none;
}

.ai-{{ ai_gen_id }}__badge {
  display: inline-flex;
  align-items: center;
  min-height: 26px;
  padding: 5px 9px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: .03em;
  text-transform: uppercase;
}

.ai-{{ ai_gen_id }}__badge--sale {
  background: #008CCB;
  color: #ffffff;
}

.ai-{{ ai_gen_id }}__badge--soldout {
  background: #eeeeee;
  color: #000000;
}

.ai-{{ ai_gen_id }}__content {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  padding: {{ block.settings.card_padding }}px;
}

.ai-{{ ai_gen_id }}__title {
  margin: 0 0 {{ block.settings.title_price_gap }}px;
  font-size: {{ block.settings.title_size }}px;
  font-weight: {{ block.settings.title_weight }};
}

.ai-{{ ai_gen_id }}__title a {
  color: inherit;
  text-decoration: none;
}

.ai-{{ ai_gen_id }}__price {
  margin-bottom: {{ block.settings.price_rating_gap }}px;
  font-size: {{ block.settings.price_size }}px;
  font-weight: {{ block.settings.price_weight }};
}

.ai-{{ ai_gen_id }}__price s {
  margin-left: 5px;
  opacity: .55;
}

.ai-{{ ai_gen_id }}__rating {
  margin-bottom: {{ block.settings.rating_gap }}px;
  color: {{ block.settings.rating_color }};
  font-size: {{ block.settings.rating_size }}px;
}


/* ============================================================
   PRODUCT SWATCHES
============================================================ */

.ai-{{ ai_gen_id }}__product-swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  min-height: 20px;
  margin: 2px 0 12px;
}

.ai-{{ ai_gen_id }}__product-swatch {
  display: block;
  width: 20px;
  height: 20px;
  flex: 0 0 20px;
  border-radius: 50%;
  border: 2px solid #fff;
  box-shadow: 0 0 0 1px rgba(0,0,0,.22);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  cursor: pointer;
  text-decoration: none;
  transition: transform .15s ease, outline .15s ease;
}

.ai-{{ ai_gen_id }}__product-swatch:hover {
  transform: scale(1.12);
  outline: 1px solid rgba(0,0,0,.35);
  outline-offset: 2px;
}


/* ============================================================
   BUTTONS
============================================================ */

.ai-{{ ai_gen_id }}__actions {
  display: flex;
  gap: 8px;
  margin-top: auto;
  padding-top: 4px;
}

.ai-{{ ai_gen_id }}__view,
.ai-{{ ai_gen_id }}__quick {
  position: relative;
  overflow: hidden;
  border: 0;
  border-radius: {{ block.settings.button_radius }}px;
  box-shadow: none;
  font-family: {{ block.settings.button_font.family }};
  cursor: pointer;
}

.ai-{{ ai_gen_id }}__view {
  flex: 1;
  padding: {{ block.settings.button_padding }}px;
  background: {{ block.settings.button_background }};
  color: {{ block.settings.button_text }};
  text-align: center;
  text-decoration: none;
}

.ai-{{ ai_gen_id }}__quick {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  min-width: 40px;
  padding: 0;
  background: {{ block.settings.quick_background }};
  color: #fff;
}

.ai-{{ ai_gen_id }}__quick svg {
  width: 16px;
  height: 16px;
}

.ai-{{ ai_gen_id }}__view:before,
.ai-{{ ai_gen_id }}__quick:before {
  content: '';
  position: absolute;
  inset: 0 auto 0 -120%;
  width: 70%;
  background: linear-gradient(110deg,transparent,#fff8,transparent);
  transform: skewX(-20deg);
  transition: left .5s;
}

.ai-{{ ai_gen_id }}__view:hover:before,
.ai-{{ ai_gen_id }}__quick:hover:before {
  left: 140%;
}

.ai-{{ ai_gen_id }}__quick:disabled {
  opacity: .55;
  cursor: wait;
}


/* ============================================================
   PAGINATION
============================================================ */

.ai-{{ ai_gen_id }}__pagination {
  margin-top: 30px;
}



/* ============================================================
   MOBILE FILTER TOGGLE
============================================================ */

.ai-{{ ai_gen_id }}__mobile-filter-toggle {
  display: none;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 13px 15px;
  margin: 0 0 12px;
  border: 1px solid rgba(0,0,0,.14);
  border-radius: {{ block.settings.card_radius }}px;
  background: {{ block.settings.filter_background }};
  color: {{ block.settings.text_color }};
  font: inherit;
  font-weight: 700;
  text-align: left;
  cursor: pointer;
}

.ai-{{ ai_gen_id }}__mobile-filter-toggle-icon {
  position: relative;
  width: 16px;
  height: 16px;
  flex: 0 0 16px;
}

.ai-{{ ai_gen_id }}__mobile-filter-toggle-icon:before,
.ai-{{ ai_gen_id }}__mobile-filter-toggle-icon:after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 12px;
  height: 2px;
  background: currentColor;
  transform: translate(-50%,-50%);
  transition: transform .2s ease;
}

.ai-{{ ai_gen_id }}__mobile-filter-toggle-icon:after {
  transform: translate(-50%,-50%) rotate(90deg);
}

.ai-{{ ai_gen_id }}__mobile-filter-toggle[aria-expanded="true"]
.ai-{{ ai_gen_id }}__mobile-filter-toggle-icon:after {
  transform: translate(-50%,-50%) rotate(0deg);
}

/* ============================================================
   MOBILE
============================================================ */

@media(max-width: 749px) {

  .ai-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-{{ ai_gen_id }}__layout {
    display: block;
  }

  .ai-{{ ai_gen_id }}__mobile-filter-toggle {
    display: flex;
  }

  .ai-{{ ai_gen_id }}__sidebar {
    display: none;
    margin-bottom: 20px;
  }

  .ai-{{ ai_gen_id }}__sidebar.is-open {
    display: block;
  }

  .ai-{{ ai_gen_id }}__grid {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }

}

{% endstyle %}


<collection-grid-{{ ai_gen_id }}
  class="ai-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>

<form method="get" action="{{ collection.url }}">

<div class="ai-{{ ai_gen_id }}__layout">


<!-- ============================================================
     FILTER SIDEBAR
============================================================ -->

<button
  type="button"
  class="ai-{{ ai_gen_id }}__mobile-filter-toggle"
  aria-expanded="false"
  aria-controls="ai-{{ ai_gen_id }}-filters"
  data-mobile-filter-toggle
>
  <span>Filter anzeigen</span>
  <span class="ai-{{ ai_gen_id }}__mobile-filter-toggle-icon" aria-hidden="true"></span>
</button>

<aside
  class="ai-{{ ai_gen_id }}__sidebar"
  id="ai-{{ ai_gen_id }}-filters"
  data-mobile-filter-panel
>

<h2 class="ai-{{ ai_gen_id }}__sidebar-title">
  Filter
</h2>

{% for position in (1..10) %}

  {% case position %}

    {% when 1 %}
      {% assign configured_key = block.settings.filter_1_key %}
      {% assign configured_display = block.settings.filter_1_display %}

    {% when 2 %}
      {% assign configured_key = block.settings.filter_2_key %}
      {% assign configured_display = block.settings.filter_2_display %}

    {% when 3 %}
      {% assign configured_key = block.settings.filter_3_key %}
      {% assign configured_display = block.settings.filter_3_display %}

    {% when 4 %}
      {% assign configured_key = block.settings.filter_4_key %}
      {% assign configured_display = block.settings.filter_4_display %}

    {% when 5 %}
      {% assign configured_key = block.settings.filter_5_key %}
      {% assign configured_display = block.settings.filter_5_display %}

    {% when 6 %}
      {% assign configured_key = block.settings.filter_6_key %}
      {% assign configured_display = block.settings.filter_6_display %}

    {% when 7 %}
      {% assign configured_key = block.settings.filter_7_key %}
      {% assign configured_display = block.settings.filter_7_display %}

    {% when 8 %}
      {% assign configured_key = block.settings.filter_8_key %}
      {% assign configured_display = block.settings.filter_8_display %}

    {% when 9 %}
      {% assign configured_key = block.settings.filter_9_key %}
      {% assign configured_display = block.settings.filter_9_display %}

    {% when 10 %}
      {% assign configured_key = block.settings.filter_10_key %}
      {% assign configured_display = block.settings.filter_10_display %}

  {% endcase %}


  {% if configured_key != blank %}

    {% for filter in collection.filters %}

      {% if filter.param_name == configured_key %}


        {% if filter.type == 'list' and filter.values.size > 0 %}

          <details class="ai-{{ ai_gen_id }}__filter" open>

            <summary>
              {{ filter.label }}
            </summary>


            {% if configured_display == 'numeric_min_slider' %}

              {% assign numeric_active_index = 0 %}
              {% assign numeric_has_active = false %}

              {% for value in filter.values %}
                {% if value.active and numeric_has_active == false %}
                  {% assign numeric_active_index = forloop.index0 %}
                  {% assign numeric_has_active = true %}
                {% endif %}
              {% endfor %}

              <div
                class="ai-{{ ai_gen_id }}__numeric-slider"
                data-numeric-slider
              >

                <div class="ai-{{ ai_gen_id }}__numeric-slider-head">
                  <span>Mindestens</span>
                  <strong data-numeric-output></strong>
                </div>

                <input
                  class="ai-{{ ai_gen_id }}__numeric-range"
                  type="range"
                  min="0"
                  max="{{ filter.values.size | minus: 1 }}"
                  step="1"
                  value="{{ numeric_active_index }}"
                  data-numeric-range
                >

                <div class="ai-{{ ai_gen_id }}__numeric-slider-scale">
                  <span>{{ filter.values.first.label }}</span>
                  <span>{{ filter.values.last.label }}</span>
                </div>

                <div class="ai-{{ ai_gen_id }}__numeric-slider-inputs">
                  {% for value in filter.values %}
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value | escape }}"
                      data-numeric-value
                      data-label="{{ value.label | escape }}"
                      data-index="{{ forloop.index0 }}"
                      {% if value.active %}checked{% endif %}
                    >
                  {% endfor %}
                </div>

              </div>

            {% elsif configured_display == 'swatch' %}

              <div class="ai-{{ ai_gen_id }}__filter-swatches">

                {% for value in filter.values %}

                  {% if value.count > 0 or value.active %}

                    {% assign swatch_name = value.label | downcase | strip %}

                    <label
                      class="ai-{{ ai_gen_id }}__filter-swatch-wrap {% if value.active %}is-active{% endif %}"
                      title="{{ value.label | escape }}"
                    >

                      <input
                        type="checkbox"
                        name="{{ value.param_name }}"
                        value="{{ value.value | escape }}"
                        {% if value.active %}checked{% endif %}
                        onchange="this.form.submit()"
                      >

                      <span
                        class="ai-{{ ai_gen_id }}__filter-swatch"

                        {% if value.swatch.image %}

                          style="background-image:url('{{ value.swatch.image | image_url: width: 80 }}');"

                        {% elsif value.swatch.color %}

                          style="background-color:{{ value.swatch.color }};"

                        {% else %}

                          {% case swatch_name %}

                            {% when 'weiß (kl01)' %}style="background:#EEEEEE;"
                            {% when 'perle (kl34)' %}style="background:#D6D7D1;"
                            {% when 'sand (kl36)' %}style="background:#D9D1BA;"
                            {% when 'apricot (kl11)' %}style="background:#F4B575;"
                            {% when 'safran (kl06)' %}style="background:#F8AD4C;"
                            {% when 'rost (kl30)' %}style="background:#C05742;"
                            {% when 'kirsche (kl35)' %}style="background:#B63A42;"
                            {% when 'cyclam (kl04)' %}style="background:#944671;"
                            {% when 'orchidee (kl03)' %}style="background:#5E4668;"
                            {% when 'sky (kl33)' %}style="background:#607A93;"
                            {% when 'atoll (kl27)' %}style="background:#24558D;"
                            {% when 'royal (kl13)' %}style="background:#324260;"
                            {% when 'aqua (kl32)' %}style="background:#6EC5B6;"
                            {% when 'basalt' %}style="background:#817260;"
                            {% when 'aubergine' %}style="background:#565057;"
                            {% when 'misty mountain' %}style="background:#485F77;"
                            {% when 'smaragd (kl07)' %}style="background:#008B63;"
                            {% when 'limone (kl28)' %}style="background:#A3BE63;"
                            {% when 'apfel (kl08)' %}style="background:#79C14F;"
                            {% when 'chrom (kl05)' %}style="background:#807F7F;"
                            {% when 'anthrazit (kl29)' %}style="background:#4D565A;"
                            {% when 'schwarz (kl02)' %}style="background:#3E4043;"

                            {% when 'birke (tor01)' %}style="background:#A29C8F;"
                            {% when 'mocca (tor02)' %}style="background:#5A4831;"
                            {% when 'olive (tor03)' %}style="background:#7D8645;"
                            {% when 'limone (tor04)' %}style="background:#9CAE19;"
                            {% when 'corn (tor05)' %}style="background:#DDB01E;"
                            {% when 'orange (tor06)' %}style="background:#DA9621;"
                            {% when 'stone blue (tor07)' %}style="background:#7A8793;"
