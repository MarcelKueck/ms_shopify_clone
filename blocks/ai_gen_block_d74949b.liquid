{% doc %}
  @prompt
    Ich möchte ein Element exakt wie dieses. Name "BlueBox". Es soll in der Breite präzise skalierbar sein (max width px) und im Desktop optimal platzierba sein (also nicht immer nur full width)
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bluebox-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 20px 0;
  }

  .ai-bluebox-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    width: 100%;
    margin: 0 auto;
  }

  {% if block.settings.desktop_alignment == 'left' %}
    @media screen and (min-width: 750px) {
      .ai-bluebox-wrapper-{{ ai_gen_id }} {
        margin-left: 0;
        margin-right: auto;
      }
    }
  {% elsif block.settings.desktop_alignment == 'right' %}
    @media screen and (min-width: 750px) {
      .ai-bluebox-wrapper-{{ ai_gen_id }} {
        margin-left: auto;
        margin-right: 0;
      }
    }
  {% endif %}

  .ai-bluebox-content-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-bluebox-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    font-weight: 600;
  }

  .ai-bluebox-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-bluebox-text-{{ ai_gen_id }} p {
    margin: 0 0 12px 0;
  }

  .ai-bluebox-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-bluebox-text-{{ ai_gen_id }} ul,
  .ai-bluebox-text-{{ ai_gen_id }} ol {
    margin: 0 0 12px 0;
    padding-left: 20px;
  }

  .ai-bluebox-text-{{ ai_gen_id }} li {
    margin-bottom: 6px;
  }

  @media screen and (max-width: 749px) {
    .ai-bluebox-content-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }

    .ai-bluebox-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }

    .ai-bluebox-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<bluebox-{{ ai_gen_id }} class="ai-bluebox-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bluebox-wrapper-{{ ai_gen_id }}">
    <div class="ai-bluebox-content-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h3 class="ai-bluebox-title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
      {% endif %}
      
      {% if block.settings.text != blank %}
        <div class="ai-bluebox-text-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </div>
      {% endif %}
    </div>
  </div>
</bluebox-{{ ai_gen_id }}>

<script>
  (function() {
    class BlueBox{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('bluebox-{{ ai_gen_id }}', BlueBox{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "BlueBox",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Titel",
      "default": "Wichtiger Hinweis"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Fügen Sie hier Ihren Text ein. Sie können Listen, Links und Formatierungen verwenden.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximale Breite",
      "min": 300,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 800
    },
    {
      "type": "select",
      "id": "desktop_alignment",
      "label": "Desktop-Ausrichtung",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Zentriert"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe",
      "default": "#E3F2FD"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Rahmenfarbe",
      "default": "#2196F3"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Titelfarbe",
      "default": "#1565C0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Textfarbe",
      "default": "#0D47A1"
    },
    {
      "type": "header",
      "content": "Stil"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Eckenradius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Rahmenstärke",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Innenabstand vertikal",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Innenabstand horizontal",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Typografie"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Titelgröße",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "title_spacing",
      "label": "Abstand nach Titel",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Textgröße",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "BlueBox"
    }
  ]
}
{% endschema %}