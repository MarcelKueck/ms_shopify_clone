{% doc %}
  @prompt
    generiere mir einen abschnitt in dem man mehrere Bilder, ab einer bestimmten anzahl als slider in eine horizontale reihe stellen kann. die bilder sollen 3D visuell dargestellt werden können. Jedes Bild soll einen Titel oben drüber haben, bei dem die Überschrift zu pflegen ist. Darunter soll ein Preisfeld zu pflegen sein. Und darunter mehrere Produkte zu in bezug auf das kartenbild zu verlinken sein. Alle Felder sollen mit Abstand, Farbe, Padding etc. zu pflegen sein., bitte 4 karten anlegen. die verlinkten produkte sollen  mit bild und einzelpreis angezeigt werden. das modul benötigt noch eine überschrift. , überschriften, titel und preise sollen alle zu pflegen sein. die karten sollen über 3d effekte verfügen und es sollen nur 3 karten angezeigt werden und mit dem slider dann weitergeklickt werden. , das ist gut! die effekte sollen zu pflegen sein sowie größen der titel, text und farben etc., das modul soll zu positionieren sein, also link, rechts und zentriert. So auch der Titel, bitte gestalte die 3D effekte sitlvoller und füßiger. zudem soll es noch einen button geben mit dem man alle verlinkten produkte zu dem angegeben en preis in den warenkorb legen kann., anstatt dem bild soll ein jetzt ein Bundle Produkt verlinkt werden. die verknüpften produkte beibehalten!, kannst du bitte unter dem titel von dem ganzen modul eine underline einfügen
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-slider-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin-top:{{ block.settings.module_margin_top }}px;margin-bottom:{{ block.settings.module_margin_bottom }}px;box-sizing:border-box;background:{{ block.settings.background_color }};padding:{{ block.settings.section_padding }}px;color:{{ block.settings.text_color }};{% if block.settings.module_position == 'center' %}margin-left:auto;margin-right:auto;{% elsif block.settings.module_position == 'right' %}margin-left:auto;margin-right:0;{% else %}margin-left:0;margin-right:auto;{% endif %}}
.ai-slider-{{ ai_gen_id }} .ai-slider__title{margin:0 0 24px;text-align:{{ block.settings.title_alignment }};font-size:{{ block.settings.section_heading_size }}px;color:{{ block.settings.section_heading_color }}}
.ai-slider-{{ ai_gen_id }} .ai-slider__title:after{content:"";display:block;width:64px;height:2px;margin-top:10px;background:{{ block.settings.section_heading_color }};{% if block.settings.title_alignment == 'center' %}margin-left:auto;margin-right:auto;{% elsif block.settings.title_alignment == 'right' %}margin-left:auto;margin-right:0;{% else %}margin-left:0;margin-right:auto;{% endif %}}
.ai-slider-{{ ai_gen_id }} .ai-slider__controls{display:flex;justify-content:flex-end;gap:8px;margin-bottom:8px}.ai-slider-{{ ai_gen_id }} .ai-slider__button{width:42px;height:42px;border:1px solid {{ block.settings.control_color }};border-radius:50%;background:{{ block.settings.background_color }};color:{{ block.settings.control_color }};font-size:20px;cursor:pointer}
.ai-slider-{{ ai_gen_id }} .ai-slider__track{display:grid;grid-auto-flow:column;grid-auto-columns:min(calc((100% - {{ block.settings.card_gap | times: 2 }}px)/3), {{ block.settings.card_max_width }}px);gap:{{ block.settings.card_gap }}px;overflow-x:auto;scroll-snap-type:x mandatory;padding:16px 14px 30px;perspective:1400px;scrollbar-width:none}.ai-slider-{{ ai_gen_id }} .ai-slider__track::-webkit-scrollbar{display:none}
.ai-slider-{{ ai_gen_id }} .ai-slider__card{min-width:0;scroll-snap-align:start;padding:{{ block.settings.card_padding }}px;background:linear-gradient(145deg,{{ block.settings.card_color }},{{ block.settings.card_color | color_darken: 4 }});border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.corner_radius }}px;box-sizing:border-box;box-shadow:0 {{ block.settings.shadow_y }}px {{ block.settings.shadow_blur }}px rgba(0,0,0,{{ block.settings.shadow_opacity | divided_by: 100.0 }});{% if block.settings.enable_3d %}transform:perspective(1000px) rotateY(-{{ block.settings.tilt_degrees }}deg) rotateX(1deg);transform-style:preserve-3d;{% endif %}transition:transform .45s cubic-bezier(.2,.75,.25,1),box-shadow .45s ease}
.ai-slider-{{ ai_gen_id }} .ai-slider__card:hover{transform:perspective(1000px) rotateY(0) rotateX(0) translateY(-{{ block.settings.hover_lift }}px) scale(1.015);box-shadow:0 {{ block.settings.hover_shadow_y }}px {{ block.settings.hover_shadow_blur }}px rgba(0,0,0,{{ block.settings.hover_shadow_opacity | divided_by: 100.0 }})}
.ai-slider-{{ ai_gen_id }} .ai-slider__heading{margin:0 0 10px;font-size:{{ block.settings.heading_size }}px;line-height:1.25;color:{{ block.settings.card_heading_color }}}.ai-slider-{{ ai_gen_id }} .ai-slider__price{margin:0 0 16px;font-size:{{ block.settings.card_price_size }}px;font-weight:600;color:{{ block.settings.card_price_color }}}
.ai-slider-{{ ai_gen_id }} .ai-slider__bundle-image,.ai-slider-{{ ai_gen_id }} .ai-slider__placeholder{display:block;width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:{{ block.settings.corner_radius }}px;margin-bottom:16px;transform:translateZ(16px)}.ai-slider-{{ ai_gen_id }} .ai-slider__placeholder{position:relative;background:#f0efed;overflow:hidden}.ai-slider-{{ ai_gen_id }} .ai-slider__placeholder svg{width:100%;height:100%;object-fit:cover}.ai-slider-{{ ai_gen_id }} .ai-slider__empty{position:absolute;bottom:10px;left:10px;right:10px;text-align:center;color:#222;background:rgba(255,255,255,.94);padding:6px;font-size:12px}
.ai-slider-{{ ai_gen_id }} .ai-slider__products{display:grid;gap:12px;list-style:none;margin:0;padding:0}.ai-slider-{{ ai_gen_id }} .ai-slider__product{display:grid;grid-template-columns:64px 1fr;gap:12px;align-items:center}.ai-slider-{{ ai_gen_id }} .ai-slider__product img{width:64px;height:64px;object-fit:cover;border-radius:{{ block.settings.corner_radius }}px}.ai-slider-{{ ai_gen_id }} .ai-slider__product a{color:{{ block.settings.product_title_color }};font-size:{{ block.settings.product_title_size }}px;text-decoration:underline}.ai-slider-{{ ai_gen_id }} .ai-slider__product-price{display:block;margin-top:4px;color:{{ block.settings.product_price_color }};font-size:{{ block.settings.product_price_size }}px}
.ai-slider-{{ ai_gen_id }} .ai-slider__add{width:100%;margin-top:18px;padding:12px 16px;border:0;border-radius:{{ block.settings.corner_radius }}px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font:inherit;cursor:pointer}.ai-slider-{{ ai_gen_id }} .ai-slider__add:disabled{opacity:.55;cursor:wait}.ai-slider-{{ ai_gen_id }} .ai-slider__status{min-height:1.4em;margin:8px 0 0;font-size:13px;color:{{ block.settings.text_color }}}
.ai-slider-{{ ai_gen_id }} button:focus-visible,.ai-slider-{{ ai_gen_id }} a:focus-visible{outline:2px solid currentColor;outline-offset:3px}
@media(max-width:749px){.ai-slider-{{ ai_gen_id }}{padding:{{ block.settings.mobile_padding }}px}.ai-slider-{{ ai_gen_id }} .ai-slider__track{grid-auto-columns:min(85%, {{ block.settings.card_max_width }}px)}.ai-slider-{{ ai_gen_id }} .ai-slider__card{transform:none}.ai-slider-{{ ai_gen_id }} .ai-slider__card:hover{transform:translateY(-{{ block.settings.hover_lift }}px)}}
@media(prefers-reduced-motion:reduce){.ai-slider-{{ ai_gen_id }} .ai-slider__card{transition:none}.ai-slider-{{ ai_gen_id }} .ai-slider__track{scroll-behavior:auto}}
{% endstyle %}
<editorial-bundle-slider-{{ ai_gen_id }} class="ai-slider-{{ ai_gen_id }}" style="width:{{ block.settings.desktop_width_percent }}%" {{ block.shopify_attributes }}>
{% if block.settings.section_heading != blank %}<h2 class="ai-slider__title">{{ block.settings.section_heading | escape }}</h2>{% endif %}<div class="ai-slider__controls"><button class="ai-slider__button" type="button" data-direction="back" aria-label="Vorherige Karte">‹</button><button class="ai-slider__button" type="button" data-direction="forward" aria-label="Nächste Karte">›</button></div><div class="ai-slider__track">
{% for i in (1..4) %}{% assign bundle_key = 'card_' | append: i | append: '_bundle' %}{% assign title_key = 'card_' | append: i | append: '_title' %}{% assign price_key = 'card_' | append: i | append: '_price' %}{% assign products_key = 'card_' | append: i | append: '_products' %}{% assign card_bundle = block.settings[bundle_key] %}{% assign card_title = block.settings[title_key] %}{% assign card_price = block.settings[price_key] %}{% assign card_products = block.settings[products_key] %}<article class="ai-slider__card"><h3 class="ai-slider__heading">{{ card_title | escape }}</h3><p class="ai-slider__price">{{ card_price | escape }}</p>{% if card_bundle != blank and card_bundle.featured_image %}<a href="{{ card_bundle.url }}" aria-label="{{ card_bundle.title | escape }}"><img class="ai-slider__bundle-image" src="{{ card_bundle.featured_image | image_url: width: 1000 }}" alt="{{ card_bundle.featured_image.alt | default: card_bundle.title | escape }}" loading="lazy" width="{{ card_bundle.featured_image.width }}" height="{{ card_bundle.featured_image.height }}"></a>{% else %}<div class="ai-slider__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}<span class="ai-slider__empty">Bundle-Produkt für Karte {{ i }} auswählen</span></div>{% endif %}{% if card_products != blank %}<ul class="ai-slider__products">{% for related_product in card_products %}<li class="ai-slider__product"><a href="{{ related_product.url }}" aria-label="{{ related_product.title | escape }}">{% if related_product.featured_image %}<img src="{{ related_product.featured_image | image_url: width: 160 }}" alt="{{ related_product.featured_image.alt | default: related_product.title | escape }}" width="64" height="64" loading="lazy">{% endif %}</a><div><a href="{{ related_product.url }}">{{ related_product.title | escape }}</a><span class="ai-slider__product-price">{{ related_product.price | money }}</span></div></li>{% endfor %}</ul><button class="ai-slider__add" type="button" data-add-products="{% for related_product in card_products %}{% if related_product.selected_or_first_available_variant.available %}{{ related_product.selected_or_first_available_variant.id }}{% unless forloop.last %},{% endunless %}{% endif %}{% endfor %}">{{ block.settings.add_button_label | escape }}</button><p class="ai-slider__status" aria-live="polite" role="status"></p>{% endif %}</article>{% endfor %}</div></editorial-bundle-slider-{{ ai_gen_id }}>
<script>(()=>{const tag='editorial-bundle-slider-{{ ai_gen_id }}';if(customElements.get(tag))return;class EditorialBundleSlider extends HTMLElement{connectedCallback(){const track=this.querySelector('.ai-slider__track');this.querySelectorAll('[data-direction]').forEach(button=>button.addEventListener('click',()=>{const card=track.querySelector('.ai-slider__card');if(card){const gap=parseFloat(getComputedStyle(track).columnGap)||0;track.scrollBy({left:(button.dataset.direction==='forward'?1:-1)*(card.getBoundingClientRect().width+gap),behavior:'smooth'})}}));this.querySelectorAll('[data-add-products]').forEach(button=>button.addEventListener('click',async()=>{const ids=button.dataset.addProducts.split(',').filter(Boolean);const status=button.parentElement.querySelector('.ai-slider__status');if(!ids.length){status.textContent='Keine verfügbaren Produkte ausgewählt.';return}button.disabled=true;status.textContent='Produkte werden hinzugefügt …';try{const response=await fetch((window.Shopify&&Shopify.routes&&Shopify.routes.root?Shopify.routes.root:'/')+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:ids.map(id=>({id:Number(id),quantity:1}))})});if(!response.ok)throw new Error('add');await response.json();status.textContent='Produkte wurden zum Warenkorb hinzugefügt.';this.dispatchEvent(new CustomEvent('cart:refresh',{bubbles:true}))}catch(error){status.textContent='Hinzufügen nicht möglich. Bitte versuche es erneut.'}finally{button.disabled=false}}))}}customElements.define(tag,EditorialBundleSlider)})();</script>
