{% doc %}
  @prompt
    erstelle mir einen Block mit h2 überschrift, einleitungstext unten drunter. Dazu dann mehrfach auswählbare cards mit h3 und eigenen text. Die cards sollen designvoll sein, mit schatten und hoover effekt. Die überschriften, texte, cards, badges, buttons - alles soll anpassbar sein in größe position und mehr. Die badges und buttons sollen auch mit effekten zu designen sein. Mobil soll das modul auch zu pflegen sein.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-card-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px {{ block.settings.section_padding_horizontal }}px;
    background-color: {{ block.settings.section_background_color }};
  }

  .ai-card-section__content-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-card-section__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-card-section__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_bottom_spacing }}px 0;
    font-weight: {{ block.settings.heading_font_weight }};
    line-height: 1.2;
  }

  .ai-card-section__intro-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_text_size }}px;
    color: {{ block.settings.intro_text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-card-section__cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.cards_per_row_desktop }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-top: {{ block.settings.cards_top_spacing }}px;
  }

  .ai-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    transition: transform {{ block.settings.card_hover_transition_duration }}s ease, box-shadow {{ block.settings.card_hover_transition_duration }}s ease;
    position: relative;
    overflow: hidden;
  }

  .ai-card-{{ ai_gen_id }}:hover {
    transform: translateY({{ block.settings.card_hover_translate_y }}px) scale({{ block.settings.card_hover_scale }});
    box-shadow: {{ block.settings.card_hover_shadow_horizontal }}px {{ block.settings.card_hover_shadow_vertical }}px {{ block.settings.card_hover_shadow_blur }}px {{ block.settings.card_hover_shadow_color }};
  }

  .ai-card__badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.badge_background_color }};
    color: {{ block.settings.badge_text_color }};
    font-size: {{ block.settings.badge_font_size }}px;
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    margin-bottom: {{ block.settings.badge_bottom_spacing }}px;
    font-weight: {{ block.settings.badge_font_weight }};
    transition: transform {{ block.settings.badge_hover_transition_duration }}s ease, background-color {{ block.settings.badge_hover_transition_duration }}s ease;
  }

  .ai-card-{{ ai_gen_id }}:hover .ai-card__badge-{{ ai_gen_id }} {
    transform: scale({{ block.settings.badge_hover_scale }});
    background-color: {{ block.settings.badge_hover_background_color }};
  }

  .ai-card__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_heading_size }}px;
    color: {{ block.settings.card_heading_color }};
    margin: 0 0 {{ block.settings.card_heading_bottom_spacing }}px 0;
    font-weight: {{ block.settings.card_heading_font_weight }};
    line-height: 1.3;
  }

  .ai-card__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    line-height: 1.6;
    margin: 0 0 {{ block.settings.card_text_bottom_spacing }}px 0;
  }

  .ai-card__button-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_font_size }}px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-weight: {{ block.settings.button_font_weight }};
    transition: transform {{ block.settings.button_hover_transition_duration }}s ease, background-color {{ block.settings.button_hover_transition_duration }}s ease, box-shadow {{ block.settings.button_hover_transition_duration }}s ease;
    box-shadow: {{ block.settings.button_shadow_horizontal }}px {{ block.settings.button_shadow_vertical }}px {{ block.settings.button_shadow_blur }}px {{ block.settings.button_shadow_color }};
    border: none;
    cursor: pointer;
  }

  .ai-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    transform: translateY({{ block.settings.button_hover_translate_y }}px) scale({{ block.settings.button_hover_scale }});
    box-shadow: {{ block.settings.button_hover_shadow_horizontal }}px {{ block.settings.button_hover_shadow_vertical }}px {{ block.settings.button_hover_shadow_blur }}px {{ block.settings.button_hover_shadow_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-card-section__cards-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.cards_per_row_tablet }}, 1fr);
    }
    
    .ai-card-section__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
    
    .ai-card__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_heading_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-card-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px {{ block.settings.section_padding_bottom_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px;
    }

    .ai-card-section__cards-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.cards_per_row_mobile }}, 1fr);
      gap: {{ block.settings.card_gap_mobile }}px;
    }

    .ai-card-section__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-card-section__intro-{{ ai_gen_id }} {
      font-size: {{ block.settings.intro_text_size_mobile }}px;
    }

    .ai-card__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_heading_size_mobile }}px;
    }

    .ai-card__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_text_size_mobile }}px;
    }

    .ai-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-card-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-card-section__content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.intro_text != blank %}
      <div class="ai-card-section__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-card-section__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.intro_text != blank %}
          <div class="ai-card-section__intro-{{ ai_gen_id }}">{{ block.settings.intro_text }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-card-section__cards-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign card_enabled_key = 'card_' | append: i | append: '_enabled'
          assign card_badge_key = 'card_' | append: i | append: '_badge'
          assign card_heading_key = 'card_' | append: i | append: '_heading'
          assign card_text_key = 'card_' | append: i | append: '_text'
          assign card_button_text_key = 'card_' | append: i | append: '_button_text'
          assign card_button_link_key = 'card_' | append: i | append: '_button_link'

          assign card_enabled = block.settings[card_enabled_key]
          assign card_badge = block.settings[card_badge_key]
          assign card_heading = block.settings[card_heading_key]
          assign card_text = block.settings[card_text_key]
          assign card_button_text = block.settings[card_button_text_key]
          assign card_button_link = block.settings[card_button_link_key]
        %}

        {% if card_enabled %}
          <div class="ai-card-{{ ai_gen_id }}">
            {% if card_badge != blank %}
              <span class="ai-card__badge-{{ ai_gen_id }}">{{ card_badge }}</span>
            {% endif %}
            {% if card_heading != blank %}
              <h3 class="ai-card__heading-{{ ai_gen_id }}">{{ card_heading }}</h3>
            {% endif %}
            {% if card_text != blank %}
              <div class="ai-card__text-{{ ai_gen_id }}">{{ card_text }}</div>
            {% endif %}
            {% if card_button_text != blank %}
              <a href="{{ card_button_link }}" class="ai-card__button-{{ ai_gen_id }}">
                {{ card_button_text }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

