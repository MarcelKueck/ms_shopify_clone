{% doc %}
  @prompt
    Erstelle mir einen Block auf Basis des bereits existierenden Blocks "Related products" der mehr Mouseover-Effekte beinhaltet und insbesondre auf diese Codes setzt. 
    
      product-recommendations .grid-carousel-item .product-card-wrapper,
      product-recommendations .grid-carousel-item [class*="product-card"] {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 8px;
        overflow: hidden;
      }
    
      product-recommendations .grid-carousel-item:hover .product-card-wrapper,
      product-recommendations .grid-carousel-item:hover [class*="product-card"] {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.14);
      }
    
      product-recommendations .grid-carousel-item .product-card-wrapper img,
      product-recommendations .grid-carousel-item [class*="product-card"] img {
        transition: transform 0.4s ease;
      }
    
      product-recommendations .grid-carousel-item:hover .product-card-wrapper img,
      product-recommendations .grid-carousel-item:hover [class*="product-card"] img {
        transform: scale(1.04);
      }
    
      product-recommendations quick-add-button button {
        transition: background-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
      }
    
      product-recommendations .grid-carousel-item:hover quick-add-button button {
        background-color: #008CCB;
        color: #ffffff;
        box-shadow: 0 4px 14px rgba(0, 91, 211, 0.4);
      }
    
      product-recommendations .grid-carousel-item:hover quick-add-button button svg {
        color: #ffffff;
      }
    
    Er soll "Related products 02" heißen
    
    , es fehlt leider noch die Möglichkeit related products oder andere Produkte auszuwählen.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-related-products-02-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-related-products-02-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-related-products-02-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-related-products-02-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-related-products-02-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-related-products-02-item-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-related-products-02-card-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .ai-related-products-02-item-{{ ai_gen_id }}:hover .ai-related-products-02-card-{{ ai_gen_id }} {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.14);
  }

  .ai-related-products-02-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-related-products-02-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ai-related-products-02-item-{{ ai_gen_id }}:hover .ai-related-products-02-image-{{ ai_gen_id }} {
    transform: scale(1.04);
  }

  .ai-related-products-02-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    z-index: 2;
  }

  .ai-related-products-02-info-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-related-products-02-vendor-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.vendor_color }};
    text-transform: uppercase;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
  }

  .ai-related-products-02-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 12px;
    line-height: 1.3;
    flex-grow: 1;
  }

  .ai-related-products-02-title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
  }

  .ai-related-products-02-title-link-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  .ai-related-products-02-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    margin-bottom: 16px;
    font-weight: 600;
  }

  .ai-related-products-02-price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-right: 8px;
  }

  .ai-related-products-02-price-sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_price_color }};
  }

  .ai-related-products-02-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
    text-decoration: none;
    display: inline-block;
    text-align: center;
  }

  .ai-related-products-02-item-{{ ai_gen_id }}:hover .ai-related-products-02-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    box-shadow: 0 4px 14px rgba(0, 91, 211, 0.4);
  }

  .ai-related-products-02-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999;
    font-style: italic;
  }

  @media screen and (max-width: 989px) {
    .ai-related-products-02-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-related-products-02-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-related-products-02-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<related-products-02-{{ ai_gen_id }} class="ai-related-products-02-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-related-products-02-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-related-products-02-header-{{ ai_gen_id }}">
        <h2 class="ai-related-products-02-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}

    {% liquid
      assign products_to_display = ''
      
      if block.settings.product_source == 'manual'
        assign products_to_display = block.settings.products
      elsif block.settings.product_source == 'collection' and block.settings.collection != blank
        assign products_to_display = block.settings.collection.products
      else
        if recommendations.performed and recommendations.products_count > 0
          assign products_to_display = recommendations.products
        endif
      endif
    %}

    {% if products_to_display != blank and products_to_display.size > 0 %}
      <ul class="ai-related-products-02-grid-{{ ai_gen_id }}">
        {% for product in products_to_display limit: block.settings.products_to_show %}
          <li class="ai-related-products-02-item-{{ ai_gen_id }}">
            <div class="ai-related-products-02-card-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-related-products-02-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-related-products-02-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-related-products-02-image-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if product.compare_at_price > product.price %}
                  <span class="ai-related-products-02-badge-{{ ai_gen_id }}">
                    {{ block.settings.sale_badge_text }}
                  </span>
                {% endif %}
              </a>

              <div class="ai-related-products-02-info-{{ ai_gen_id }}">
                {% if block.settings.show_vendor and product.vendor != blank %}
                  <div class="ai-related-products-02-vendor-{{ ai_gen_id }}">{{ product.vendor }}</div>
                {% endif %}

                <h3 class="ai-related-products-02-title-{{ ai_gen_id }}">
                  <a href="{{ product.url }}" class="ai-related-products-02-title-link-{{ ai_gen_id }}">
                    {{ product.title }}
                  </a>
                </h3>

                <div class="ai-related-products-02-price-{{ ai_gen_id }}">
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-related-products-02-price-compare-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                    <span class="ai-related-products-02-price-sale-{{ ai_gen_id }}">
                      {{ product.price | money }}
                    </span>
                  {% else %}
                    {{ product.price | money }}
                  {% endif %}
                </div>

                <a href="{{ product.url }}" class="ai-related-products-02-button-{{ ai_gen_id }}">
                  {{ block.settings.button_text }}
                </a>
              </div>
            </div>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="ai-related-products-02-empty-{{ ai_gen_id }}">
        {{ block.settings.empty_state_text }}
      </div>
    {% endif %}
  </div>
</related-products-02-{{ ai_gen_id }}>

