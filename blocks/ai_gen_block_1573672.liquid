    {
      "type": "range",
      "id": "stripe_spacing",
      "label": "Abstand nach Stripe",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Hintergrund und Rahmen"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Rahmenradius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
