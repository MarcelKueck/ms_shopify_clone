{% doc %}
  @prompt
    wir benötigen ein stylisches richt text feld. die form des richt texts felds soll anpasspar sein in größe, border hintergrundfarbe etc. in dem rich text soll man den text beliebig gestalten können mit bolt, links, bullet points und nummerierungen. , bitte titel einfügen für den stylischen richttext in h3. bitte einfügen, dass man den richt text in der breite in px anpassen kann, z.b. 1400 px. , der hintergrund des ganzen abschnitts sollte auch einstellbar sein , der titel sollte zusätzlich left, center, right positionierbar sein, unter dem titel soll bitte noch ein stripe zu pflegen sein, titel soll in bolt einstellbar sein
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-richtext-wrapper-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background_color }};
    padding: {{ block.settings.section_padding_vertical }}px {{ block.settings.section_padding_horizontal }}px;
  }

  .ai-richtext-block-{{ ai_gen_id }} {
    display: block;
    {% if block.settings.width_type == 'percent' %}
      width: {{ block.settings.desktop_width_percent }}%;
    {% else %}
      width: {{ block.settings.desktop_width_px }}px;
    {% endif %}
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    {% if block.settings.border_width > 0 %}
      border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    {% endif %}
    box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_spread }}px {{ block.settings.shadow_color }};
  }

  .ai-richtext-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    {% if block.settings.title_bold %}
      font-weight: 700;
    {% else %}
      font-weight: 400;
    {% endif %}
    margin-top: 0;
    margin-bottom: {{ block.settings.title_spacing }}px;
    text-align: {{ block.settings.title_align }};
  }

  .ai-richtext-stripe-{{ ai_gen_id }} {
    height: {{ block.settings.stripe_height }}px;
    background-color: {{ block.settings.stripe_color }};
    border-radius: {{ block.settings.stripe_border_radius }}px;
    margin-bottom: {{ block.settings.stripe_spacing }}px;
    {% if block.settings.stripe_align == 'left' %}
      margin-right: auto;
    {% elsif block.settings.stripe_align == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif block.settings.stripe_align == 'right' %}
      margin-left: auto;
    {% endif %}
    width: {{ block.settings.stripe_width }}%;
  }

  .ai-richtext-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    line-height: {{ block.settings.line_height }};
    text-align: {{ block.settings.text_align }};
  }

  .ai-richtext-content-{{ ai_gen_id }} h1,
  .ai-richtext-content-{{ ai_gen_id }} h2,
  .ai-richtext-content-{{ ai_gen_id }} h3,
  .ai-richtext-content-{{ ai_gen_id }} h4,
  .ai-richtext-content-{{ ai_gen_id }} h5,
  .ai-richtext-content-{{ ai_gen_id }} h6 {
    color: {{ block.settings.heading_color }};
    margin-top: 1em;
    margin-bottom: 0.5em;
  }

  .ai-richtext-content-{{ ai_gen_id }} h1 {
    font-size: 2em;
  }

  .ai-richtext-content-{{ ai_gen_id }} h2 {
    font-size: 1.5em;
  }

  .ai-richtext-content-{{ ai_gen_id }} h3 {
    font-size: 1.3em;
  }

  .ai-richtext-content-{{ ai_gen_id }} h4 {
    font-size: 1.1em;
  }

  .ai-richtext-content-{{ ai_gen_id }} h5 {
    font-size: 1em;
  }

  .ai-richtext-content-{{ ai_gen_id }} h6 {
    font-size: 0.9em;
  }

  .ai-richtext-content-{{ ai_gen_id }} p {
    margin-bottom: 1em;
  }

  .ai-richtext-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: {{ block.settings.link_style }};
  }

  .ai-richtext-content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-richtext-content-{{ ai_gen_id }} strong,
  .ai-richtext-content-{{ ai_gen_id }} b {
    font-weight: 700;
  }

  .ai-richtext-content-{{ ai_gen_id }} em,
  .ai-richtext-content-{{ ai_gen_id }} i {
    font-style: italic;
  }

  .ai-richtext-content-{{ ai_gen_id }} ul,
  .ai-richtext-content-{{ ai_gen_id }} ol {
    margin-left: {{ block.settings.list_indent }}px;
    margin-bottom: 1em;
  }

  .ai-richtext-content-{{ ai_gen_id }} ul {
    list-style-type: {{ block.settings.bullet_style }};
  }

  .ai-richtext-content-{{ ai_gen_id }} ol {
    list-style-type: decimal;
  }

  .ai-richtext-content-{{ ai_gen_id }} li {
    margin-bottom: 0.5em;
  }

  .ai-richtext-content-{{ ai_gen_id }} blockquote {
    margin: 1em 0;
    padding-left: 1em;
    border-left: 4px solid {{ block.settings.border_color }};
    font-style: italic;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-richtext-content-{{ ai_gen_id }} hr {
    border: none;
    border-top: 1px solid {{ block.settings.border_color }};
    margin: 1.5em 0;
  }

  @media screen and (max-width: 749px) {
    .ai-richtext-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_vertical | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px;
    }

    .ai-richtext-block-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }

    .ai-richtext-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }

    .ai-richtext-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-richtext-wrapper-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-richtext-block-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h3 class="ai-richtext-title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
    {% endif %}

    {% if block.settings.show_stripe %}
      <div class="ai-richtext-stripe-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.content != blank %}
      <div class="ai-richtext-content-{{ ai_gen_id }}">
        {{ block.settings.content }}
      </div>
    {% else %}
      <div class="ai-richtext-content-{{ ai_gen_id }}" style="opacity: 0.5; font-style: italic;">
        Fügen Sie hier Ihren Rich-Text-Inhalt hinzu. Sie können den Text formatieren mit <strong>Fettdruck</strong>, <em>Kursivschrift</em>, <a href="#">Links</a>, Überschriften und Listen.
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Stylisches Rich Text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titel"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Abschnitt-Hintergrund"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Abschnitt Hintergrundfarbe",
      "default": "#f9f9f9"
    },
    {
      "type": "range",
      "id": "section_padding_vertical",
      "label": "Abschnitt vertikaler Abstand",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "label": "Abschnitt horizontaler Abstand",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Größe und Abstände"
    },
    {
      "type": "select",
      "id": "width_type",
      "label": "Breiteneinheit",
      "options": [
        {
          "value": "percent",
          "label": "Prozent"
        },
        {
          "value": "pixel",
          "label": "Pixel"
        }
      ],
      "default": "percent"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Breite in Prozent",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "desktop_width_px",
      "label": "Breite in Pixel",
      "min": 400,
      "max": 1800,
      "step": 100,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertikaler Abstand",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontaler Abstand",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Titel"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Titelgröße",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Titelfarbe",
      "default": "#000000"
    },
    {
      "type": "checkbox",
