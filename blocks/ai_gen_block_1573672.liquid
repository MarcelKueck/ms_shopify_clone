        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "title_spacing",
      "label": "Abstand nach Titel",
      "min": 0,
      "max": 60,
      "step": 5,
