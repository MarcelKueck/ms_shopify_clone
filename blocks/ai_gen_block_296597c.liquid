{% doc %}
  @prompt
    kopiere den den home gym guide und ergänze um: wir geben einen pool an basis geräten für dei drei pakete vor. das zubehör muss dann automatisch geladen werden, je nachdem welches produkt aus welchem paket geladen wird. bitte stelle hier eine dynamische verbindung zu den " Ergänzende Produkte" produkten her. , jetzt den Guide optisch, visuell so aufbereiten das jemand der keine ahnung von home gyms hat, sich zurecht findet und die komplette auswahl auch in den warenkorb legen kann. bitte das design mit wow effekt anhand unseres shops designen, die pakete und produkte der pakete sollen zudem zwischen wandmontageund freisthend unterteilt werden. Das zubehör soll auch direkt ausählbar sein. das design der produkte sowie ihre auswahl soll auch mit wow efffekt sein., nein bleib bei deinen drei paketen. jedes dieser pakete verfügt über die möglichkeit freisthende oder wandmontierte geräte zu wählen. Nach der Auswahl der Montageart und des Produkts geht das dynamisch gezogende Zubehör auf und lässt sich ebfenfalls auswahlen. Die Auswahl addiert sich automatisch auf und lässt sich anschließend  in den Warenkorb legen, die felder lassen sich nicht auswählen, die auswahlmöglichkeiten müssen funktionieren. und bitte denke an den wow faktor des home gym guides , die produkte werden nicht in dem guide angezeigt?, funktioniert nicht, es werden die gewählten produkte nicht angezeigt und auch kein dynamsiches zubehör, du übernimmst falsche preise! bei varianten produkten muss es möglich sein die varianten zu wählen und auch direkt die anzahl festzulegen. und bitte bauen mehr wow effekt bei dem guide ein., die varianten lassen sich nicht richtig auswählen, mach das nicht mit drop down sondern checkboxen. und bitte mehr wow character , aktuell wird nur das basisgerät mit kaufpreis in unsere Übersicht aufgezählt bitte auch das zubehör mit anzahl und preis mit aufnehmen, sodass man den gesamtpreis mit verfolgen kann. Pack bitte 4 produkte pro schritt nebeneinander. von dem design her bitte etwas edler, moderner und mehr wow effekt. , die anzahl wird noch nicht korrekt in unserer übersichtsdarstellung aufgenommen. bitte positioniere "deine Auswahl" rechts neben unseren schritten. diese soll immer mit laufen, sodass man diese immer im blick hat. designe den rest bitte auch in dem dark design wie "deine auswahl"
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.hgg-{{ai_gen_id}}{display:block;width:{{block.settings.desktop_width_percent}}%;max-width:100%;background:#101414;color:#f5f8f6;border-radius:28px;overflow:hidden;box-shadow:0 28px 80px #07111155}.hgg-{{ai_gen_id}}__hero{padding:64px 6%;background:linear-gradient(135deg,#101414,{{block.settings.accent_color}});text-align:center}.hgg-{{ai_gen_id}}__hero h2{font-size:clamp(34px,5vw,68px);letter-spacing:-3px;margin:0 0 12px}.hgg-{{ai_gen_id}}__hero p{max-width:700px;margin:auto;line-height:1.7}.hgg-{{ai_gen_id}}__layout{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:36px;padding:40px}.hgg-{{ai_gen_id}}__steps h3{margin:28px 0 12px}.hgg-{{ai_gen_id}}__tabs{display:flex;gap:10px;margin-bottom:26px}.hgg-{{ai_gen_id}}__tabs button{flex:1;border:1px solid #516361;border-radius:12px;background:#18201f;color:#f5f8f6;padding:14px;font-weight:700;cursor:pointer}.hgg-{{ai_gen_id}}__tabs button.active{background:{{block.settings.accent_color}};border-color:{{block.settings.accent_color}}}.hgg-{{ai_gen_id}}__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.hgg-{{ai_gen_id}}__set{display:none}.hgg-{{ai_gen_id}}__set.active{display:grid}.hgg-{{ai_gen_id}}__card{border:1px solid #3b4b49;border-radius:16px;padding:12px;background:#18201f;transition:transform .2s,box-shadow .2s}.hgg-{{ai_gen_id}}__card:hover{transform:translateY(-4px);box-shadow:0 16px 28px #0008}.hgg-{{ai_gen_id}}__card:has(input:checked){border-color:{{block.settings.accent_color}};box-shadow:0 0 0 2px {{block.settings.accent_color}}44}.hgg-{{ai_gen_id}}__card img{width:100%;aspect-ratio:1;object-fit:contain;background:#f2f5f3;border-radius:11px}.hgg-{{ai_gen_id}}__card h4{line-height:1.35}.hgg-{{ai_gen_id}}__variant{display:block;border:1px solid #50615e;border-radius:8px;padding:8px;margin-top:6px;font-size:12px;cursor:pointer}.hgg-{{ai_gen_id}}__qty{width:60px;background:#101414;color:#fff;border:1px solid #667774;border-radius:7px;padding:7px;margin-top:8px}.hgg-{{ai_gen_id}}__summary{position:sticky;top:20px;align-self:start;padding:24px;border:1px solid #42514f;border-radius:20px;background:#18201f;box-shadow:0 16px 36px #0007}.hgg-{{ai_gen_id}}__summary-list{display:grid;gap:8px;margin:18px 0;max-height:55vh;overflow:auto}.hgg-{{ai_gen_id}}__row{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid #ffffff22;padding:8px 0;font-size:12px}.hgg-{{ai_gen_id}}__total{display:flex;justify-content:space-between;font-size:22px;font-weight:800;margin:18px 0}.hgg-{{ai_gen_id}}__button{width:100%;border:0;border-radius:12px;padding:15px;background:{{block.settings.accent_color}};color:#fff;font-weight:800;cursor:pointer}@media(max-width:1000px){.hgg-{{ai_gen_id}}__layout{grid-template-columns:1fr;padding:25px}.hgg-{{ai_gen_id}}__summary{position:relative;top:auto;order:-1}.hgg-{{ai_gen_id}}__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.hgg-{{ai_gen_id}}__grid{grid-template-columns:1fr}}{% endstyle %}<home-gym-guide-{{ai_gen_id}} class="hgg-{{ai_gen_id}}" {{block.shopify_attributes}}><div class="hgg-{{ai_gen_id}}__hero"><h2>{{block.settings.heading}}</h2><p>{{block.settings.intro}}</p></div><div class="hgg-{{ai_gen_id}}__layout"><div class="hgg-{{ai_gen_id}}__steps"><h3>1. Paket wählen</h3><div class="hgg-{{ai_gen_id}}__tabs" data-packages><button class="active" data-value="1">{{block.settings.package_1_name}}</button><button data-value="2">{{block.settings.package_2_name}}</button><button data-value="3">{{block.settings.package_3_name}}</button></div><h3>2. Montageart wählen</h3><div class="hgg-{{ai_gen_id}}__tabs" data-mounting><button class="active" data-value="wall">Wandmontiert</button><button data-value="free">Freistehend</button></div><h3>3. Basisgerät und Variante wählen</h3>{% for i in (1..3) %}{% assign wk='wall_products_' | append:i %}{% assign fk='free_products_' | append:i %}{% for m in (1..2) %}{% if m==1 %}{% assign products=block.settings[wk] %}{% assign mount='wall' %}{% else %}{% assign products=block.settings[fk] %}{% assign mount='free' %}{% endif %}<div class="hgg-{{ai_gen_id}}__grid hgg-{{ai_gen_id}}__set{% if i==1 and m==1 %} active{% endif %}" data-set data-package="{{i}}" data-mounting="{{mount}}">{% for product in products %}<div class="hgg-{{ai_gen_id}}__card"><img src="{{product.featured_image | image_url: width:500}}" alt="{{product.title | escape}}" loading="lazy"><h4>{{product.title}}</h4>{% for variant in product.variants %}<label class="hgg-{{ai_gen_id}}__variant"><input type="radio" name="base-{{ai_gen_id}}" data-base value="{{variant.id}}" data-product="{{product.id}}" data-title="{{product.title | escape}} – {{variant.title | escape}}" data-price="{{variant.price | divided_by:100.0}}"{% unless variant.available %} disabled{% endunless %}> {{variant.title}} · {{variant.price | money}}</label>{% endfor %}<input class="hgg-{{ai_gen_id}}__qty" data-qty type="number" min="1" value="1" aria-label="Anzahl"></div>{% endfor %}</div>{% endfor %}{% endfor %}<div data-accessories hidden><h3>4. Ergänzendes Zubehör</h3><div class="hgg-{{ai_gen_id}}__grid" data-accessory-grid></div></div></div><aside class="hgg-{{ai_gen_id}}__summary"><strong>Deine Auswahl</strong><div class="hgg-{{ai_gen_id}}__summary-list" data-summary-list><span>Bitte Gerät und Variante wählen.</span></div><div class="hgg-{{ai_gen_id}}__total"><span>Gesamt</span><span data-total>0,00 €</span></div><button class="hgg-{{ai_gen_id}}__button" data-cart>Komplettes Setup in den Warenkorb</button></aside></div></home-gym-guide-{{ai_gen_id}}><script>(function(){class G extends HTMLElement{connectedCallback(){this.p='1';this.m='wall';this.querySelectorAll('[data-packages] button').forEach(b=>b.onclick=()=>{this.p=b.dataset.value;this.activate('[data-packages] button',b);this.refresh()});this.querySelectorAll('[data-mounting] button').forEach(b=>b.onclick=()=>{this.m=b.dataset.value;this.activate('[data-mounting] button',b);this.refresh()});this.querySelectorAll('[data-base]').forEach(x=>x.onchange=()=>this.load(x));this.querySelectorAll('[data-qty]').forEach(x=>x.oninput=()=>this.summary());this.querySelector('[data-cart]').onclick=()=>this.add();this.refresh()}activate(s,b){this.querySelectorAll(s).forEach(x=>x.classList.toggle('active',x===b))}refresh(){this.querySelectorAll('[data-set]').forEach(x=>x.classList.toggle('active',x.dataset.package===this.p&&x.dataset.mounting===this.m));this.querySelector('[data-accessories]').hidden=true;this.querySelector('[data-accessory-grid]').innerHTML='';this.summary()}async load(r){let a=await fetch('/recommendations/products.json?product_id='+r.dataset.product+'&intent=complementary&limit=12'),d=await a.json(),h='';(d.products||[]).forEach(p=>(p.variants||[]).forEach(v=>{h+='<div class="hgg-{{ai_gen_id}}__card"><img src="'+(p.featured_image||'')+'" alt="'+p.title.replace(/"/g,'&quot;')+'"><h4>'+p.title+'</h4><label class="hgg-{{ai_gen_id}}__variant"><input type="checkbox" data-accessory value="'+v.id+'" data-title="'+p.title.replace(/"/g,'&quot;')+' – '+v.title.replace(/"/g,'&quot;')+'" data-price="'+Number(v.price)/100+'"> '+v.title+' · '+(Number(v.price)/100).toLocaleString('de-DE',{style:'currency',currency:'EUR'})+'</label><input class="hgg-{{ai_gen_id}}__qty" data-qty type="number" min="1" value="1" aria-label="Anzahl"></div>'}));this.querySelector('[data-accessory-grid]').innerHTML=h;this.querySelector('[data-accessories]').hidden=!h;this.querySelectorAll('[data-accessory]').forEach(x=>x.onchange=()=>this.summary());this.querySelectorAll('[data-qty]').forEach(x=>x.oninput=()=>this.summary());this.summary()}summary(){let rows=[],total=0,r=this.querySelector('[data-base]:checked');if(r){let q=Number(r.closest('.hgg-{{ai_gen_id}}__card').querySelector('[data-qty]').value)||1,v=Number(r.dataset.price)*q;rows.push('<div class="hgg-{{ai_gen_id}}__row"><span>'+r.dataset.title+' × '+q+'</span><span>'+v.toLocaleString('de-DE',{style:'currency',currency:'EUR'})+'</span></div>');total+=v}this.querySelectorAll('[data-accessory]:checked').forEach(x=>{let q=Number(x.closest('.hgg-{{ai_gen_id}}__card').querySelector('[data-qty]').value)||1,v=Number(x.dataset.price)*q;rows.push('<div class="hgg-{{ai_gen_id}}__row"><span>'+x.dataset.title+' × '+q+'</span><span>'+v.toLocaleString('de-DE',{style:'currency',currency:'EUR'})+'</span></div>');total+=v});this.querySelector('[data-summary-list]').innerHTML=rows.join('')||'<span>Bitte Gerät und Variante wählen.</span>';this.querySelector('[data-total]').textContent=total.toLocaleString('de-DE',{style:'currency',currency:'EUR'})}async add(){let items=[],r=this.querySelector('[data-base]:checked');if(r)items.push({id:Number(r.value),quantity:Number(r.closest('.hgg-{{ai_gen_id}}__card').querySelector('[data-qty]').value)||1});this.querySelectorAll('[data-accessory]:checked').forEach(x=>items.push({id:Number(x.value),quantity:Number(x.closest('.hgg-{{ai_gen_id}}__card').querySelector('[data-qty]').value)||1}));if(items.length){await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items})});location.href='/cart'}}}customElements.define('home-gym-guide-{{ai_gen_id}}',G)})();</script>{% schema %}{"name":"Home gym guide","tag":null,"class":"home-gym-guide-block","settings":[{"type":"text","id":"heading","label":"Heading","default":"Dein Home Gym. Klar geplant."},{"type":"textarea","id":"intro","label":"Intro","default":"Wähle dein Paket, die Montageart und exakt die passende Variante."},{"type":"text","id":"package_1_name","label":"Paket 1","default":"Starter"},{"type":"text","id":"package_2_name","label":"Paket 2","default":"Performance"},{"type":"text","id":"package_3_name","label":"Paket 3","default":"Complete"},{"type":"product_list","id":"wall_products_1","label":"Paket 1 Wandmontage","limit":12},{"type":"product_list","id":"free_products_1","label":"Paket 1 Freistehend","limit":12},{"type":"product_list","id":"wall_products_2","label":"Paket 2 Wandmontage","limit":12},{"type":"product_list","id":"free_products_2","label":"Paket 2 Freistehend","limit":12},{"type":"product_list","id":"wall_products_3","label":"Paket 3 Wandmontage","limit":12},{"type":"product_list","id":"free_products_3","label":"Paket 3 Freistehend","limit":12},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"color","id":"accent_color","label":"Accent","default":"#008ccb"}],"presets":[{"name":"Home gym guide"}]}{% endschema %}