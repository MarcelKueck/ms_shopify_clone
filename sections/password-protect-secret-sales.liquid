{% comment %}
Section: Passwortschutz für Secret Sales Seite
Mit Desktop- & Mobile-Hintergrundbildern (mobil: "fit" / contain)
{% endcomment %}

<style>
  /* === Standard (Desktop) Hintergrundbild === */
  #password-protect-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    background-image: url('https://cdn.shopify.com/s/files/1/0823/4896/6217/files/bg-password.jpg?v=1762953256');
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    margin: 0;
    padding: 0;
  }

  /* Passwortbox */
  #password-form {
    text-align: center;
    max-width: 420px;
    width: 90%;
    background: rgba(255, 255, 255, 0.92);
    padding: 2rem 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 12px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(4px);
  }

  #password-form h2 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: 600;
  }

  #password-form p {
    color: #333;
    margin-bottom: 1.5rem;
  }

  #password-form form {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
  }

  #password-form input {
    padding: 0.75rem 1rem;
    font-size: 1rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    flex: 1;
  }

  #password-form button {
    padding: 0.75rem 1.25rem;
    background: #000;
    color: #fff;
    font-weight: 600;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.25s ease;
  }

  #password-form button:hover {
    background: #333;
  }

  #password-error {
    color: #d00;
    display: none;
    margin-top: 1rem;
  }

  /* === MOBILE FALLBACK === */
  @media (max-width: 768px) {
    #password-protect-wrapper {
      background-image: url('https://cdn.shopify.com/s/files/1/0823/4896/6217/files/bg-password-mobil.jpg?v=1762953856');
      background-size: contain; /* <-- "Fit" Effekt */
      background-position: center top;
      background-attachment: scroll;
      background-color: #000; /* Falls Bild nicht vollflächig ist */
    }

    #password-form {
      padding: 1.5rem;
      background: rgba(255, 255, 255, 0.95);
    }

    #password-form h2 {
      font-size: 1.25rem;
    }
  }
</style>

<div id="password-protect-wrapper">
  <div id="password-form">
    <h2>Hast Du den Code für den Black Week Early Access?</h2>
    <p>Als Newsletter-Empfänger erhältst Du früher Zugang zu unseren exklusiven Black-Week Angeboten!<br><b>Bitte gib nun deinen Code aus dem Newsletter ein:</b></p>
    <form id="secret-password-form">
      <input
        type="password"
        id="secret-password-input"
        placeholder="Passwort eingeben"
      />
      <button type="submit">Weiter</button>
    </form>
    <p id="password-error">❌ Falsches Passwort.</p>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const wrapper = document.getElementById('password-protect-wrapper');
  const form = document.getElementById('secret-password-form');
  const input = document.getElementById('secret-password-input');
  const error = document.getElementById('password-error');
  const correctPassword = "{{ section.settings.page_password | escape }}";

  // --- URL-Logout: bei ?logout=true ---
  const params = new URLSearchParams(window.location.search);
  if (params.get('logout') === 'true') {
    sessionStorage.removeItem('secret_access_granted');
    const cleanUrl = window.location.origin + window.location.pathname;
    window.location.replace(cleanUrl);
    return;
  }

  // Alle anderen Sections (außer Passwort-Wrapper) ausblenden
  const allSections = document.querySelectorAll('section, .shopify-section');
  allSections.forEach(s => {
    if (!s.contains(wrapper)) s.style.display = 'none';
  });

  // Wenn bereits freigeschaltet (Session)
  if (sessionStorage.getItem('secret_access_granted') === 'true') {
    wrapper.style.display = 'none';
    allSections.forEach(s => s.style.display = 'block');
  }

  // Passwortprüfung
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    if (input.value === correctPassword) {
      sessionStorage.setItem('secret_access_granted', 'true');
      wrapper.style.display = 'none';
      allSections.forEach(s => s.style.display = 'block');
    } else {
      error.style.display = 'block';
    }
  });
});
</script>

{% schema %}
{
  "name": "Secret Passwortschutz",
  "settings": [
    {
      "type": "text",
      "id": "page_password",
      "label": "Passwort für Seite",
      "default": "meinPasswort"
    }
  ]
}
{% endschema %}
