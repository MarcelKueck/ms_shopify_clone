{% comment %}
  MOTIONSPORTS – ZUBEHÖR TAB 03
  Wird per Recommendations API (intent=complementary) in tabs-cards.liquid geladen.
  Produktkarten im Look von related-products-03.liquid.
{% endcomment %}

{% if recommendations.performed and recommendations.products_count > 0 %}
  {% capture items %}
    {% for recommendation in recommendations.products %}
      {% unless recommendation.tags contains 'globo-product-options' %}
        {% assign card_variant = blank %}
        {% for variant in recommendation.variants %}
          {% if variant.price == recommendation.price %}
            {% assign card_variant = variant %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% assign card_saving = 0 %}
        {% if card_variant != blank and card_variant.compare_at_price != blank %}
          {% if card_variant.compare_at_price > card_variant.price %}
            {% assign card_saving = card_variant.compare_at_price | minus: card_variant.price %}
          {% endif %}
        {% endif %}
        <div class="grid-carousel-item comp-rp03-item">
          <article class="comp-rp03-card product-card">
            <a class="comp-rp03-media" href="{{ recommendation.url }}" aria-label="{{ recommendation.title | escape }}">
              {% if recommendation.featured_image %}
                <img
                  src="{{ recommendation.featured_image | image_url: width: 800 }}"
                  alt="{{ recommendation.featured_image.alt | default: recommendation.title | escape }}"
                  width="800"
                  height="{{ 800 | divided_by: recommendation.featured_image.aspect_ratio | round }}"
                  loading="lazy"
                >
              {% else %}
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              {% endif %}
              {% if card_saving > 0 %}<span class="comp-rp03-badge comp-rp03-badge--sale">%</span>{% endif %}
              {% unless recommendation.available %}<span class="comp-rp03-badge comp-rp03-badge--soldout">SOLD OUT</span>{% endunless %}
            </a>
            <div class="comp-rp03-content">
              <h3 class="comp-rp03-title"><a href="{{ recommendation.url }}">{{ recommendation.title | escape }}</a></h3>
              <div class="comp-rp03-price">
                {{ recommendation.price | money }}
                {% if card_saving > 0 %}<s>{{ card_variant.compare_at_price | money }}</s>{% endif %}
              </div>
              {% assign comp_rating = recommendation.metafields.loox.avg_rating.value | default: recommendation.metafields.loox.rating.value %}
              {% assign comp_reviews = recommendation.metafields.loox.num_reviews.value | default: recommendation.metafields.loox.review_count.value %}
              <div class="comp-rp03-rating" aria-label="{% if comp_rating != blank %}Bewertung {{ comp_rating }} von 5{% else %}Noch keine Bewertungen{% endif %}">
                {% if comp_rating != blank %}★★★★★{% if comp_reviews != blank %} ({{ comp_reviews }}){% endif %}{% else %}☆☆☆☆☆{% endif %}
              </div>
            </div>
          </article>
        </div>
      {% endunless %}
    {% endfor %}
  {% endcapture %}
  <div class="comp-rp03-carousel" style="--grid-columns-max: var(--comp-visible, 5);">
    <div class="product-carousel-wrapper relative">
      <scroll-carousel class="grid scroll-area-x bleed pb-2 -mb-2" item-selector=".product-card">
        <div class="grid-carousel grid-carousel--pseudo-pr grid-carousel--products">{{ items }}</div>
      </scroll-carousel>
      {% render 'carousel-buttons' %}
    </div>
  </div>
{% else %}
  <p>Aktuell kein Zubehör empfohlen.</p>
{% endif %}

{% schema %}
{
  "name": "Zubehör Tab",
  "settings": []
}
{% endschema %}
