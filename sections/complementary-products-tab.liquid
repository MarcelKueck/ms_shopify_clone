{% comment %}Zubehör (Komplementärprodukte) – nutzt das Theme-Element <quick-add-button>{% endcomment %}
{% if recommendations.performed and recommendations.products_count > 0 %}
  <div class="comp-grid">
    {% for rec in recommendations.products %}
      {% assign v = rec.selected_or_first_available_variant %}
      <div class="comp-card">
        <a class="comp-link" href="{{ rec.url }}" title="{{ rec.title | escape }}">
          {% if rec.featured_image %}
            {{ rec.featured_image
              | image_url: width: 480
              | image_tag: loading: 'lazy', alt: rec.featured_image.alt | escape }}
          {% endif %}

          <div class="comp-title">{{ rec.title }}</div>

          <div class="comp-price">
            {% if rec.compare_at_price > rec.price %}
              <span class="comp-price-now">{{ rec.price | money }}</span>
              <s class="comp-price-old">{{ rec.compare_at_price | money }}</s>
            {% else %}
              <span class="comp-price-now">{{ rec.price | money }}</span>
            {% endif %}
          </div>
        </a>

        {%- if v -%}
        <quick-add-button class="comp-quick" variant-id="{{ v.id }}" handle="{{ rec.handle }}">
          <button class="button button-light complementary-product__button-add-to-cart p-0 w-9 h-9 md:w-10 md:h-10 rounded-full comp-add-btn"
                  type="button" aria-label="In den Warenkorb legen" {% unless v.available %}disabled{% endunless %}>
            <div class="icon-sm">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"
                   stroke="currentColor" stroke-width="var(--icon-stroke-width)"
                   stroke-linecap="var(--icon-stroke-linecap)" stroke-linejoin="var(--icon-stroke-linejoin)" aria-hidden="true" focusable="false">
                <path d="M6 7L21 7L19 16L9 16L6 7ZM6 7L5 4H2" vector-effect="non-scaling-stroke"></path>
                <circle cx="9.5" cy="20.5" r="1.5" fill="currentColor" stroke="none"></circle>
                <circle cx="17.5" cy="20.5" r="1.5" fill="currentColor" stroke="none"></circle>
              </svg>
            </div>
          </button>
        </quick-add-button>
        {%- endif -%}
      </div>
    {% endfor %}
  </div>
{% else %}
  <p>Aktuell kein Zubehör empfohlen.</p>
{% endif %}

<style>
  /* Grid: 2 Spalten mobil, 5 Spalten Desktop */
  .comp-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.9rem}
  @media (min-width:900px){.comp-grid{grid-template-columns:repeat(5,1fr)}}

  .comp-card{position:relative;border:1px solid #eee;border-radius:.75rem;background:#fff;transition:box-shadow .2s}
  .comp-card:hover{box-shadow:0 6px 18px rgba(0,0,0,.06)}
  .comp-link{display:block;text-decoration:none;color:inherit;padding:.75rem}
  .comp-title{margin-top:.5rem;font-size:.95rem;line-height:1.35}
  .comp-price{margin-top:.25rem;font-weight:600}
  .comp-price-old{color:#888;margin-left:.5rem;font-weight:400}

  /* Quick-Add Button unten rechts */
  .comp-quick{position:absolute;right:.5rem;bottom:.5rem;z-index:3}
  .comp-add-btn svg{width:20px;height:20px}
</style>

{% schema %}{"name":"Zubehör Tab","settings":[]} {% endschema %}
