<script>
(function() {
var header = document.getElementById('shopify-section-{{ section.id }}');
if (!header) return;

var dropdown = header.querySelector('.header-topbar__support-dropdown');
if (!dropdown) return;

var toggle = dropdown.querySelector('.header-topbar__support-toggle');
var menu = dropdown.querySelector('.header-topbar__support-menu');
if (!toggle || !menu) return;

function closeMenu() {
menu.hidden = true;
toggle.setAttribute('aria-expanded', 'false');
}

function openMenu() {
menu.hidden = false;
toggle.setAttribute('aria-expanded', 'true');
}

toggle.addEventListener('click', function(event) {
event.preventDefault();
event.stopPropagation();
if (menu.hidden) {
openMenu();
} else {
closeMenu();
}
});

document.addEventListener('click', function(event) {
if (!dropdown.contains(event.target)) {
closeMenu();
}
});

document.addEventListener('keydown', function(event) {
if (event.key === 'Escape') {
closeMenu();
toggle.focus();
}
});
})();
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {

  function updateEtrustedWidgets() {

    document
      .querySelectorAll('.fh-header-etrusted etrusted-widget')
      .forEach(function(widget) {

        widget.setAttribute('data-theme', 'dark');
        widget.style.setProperty('--accent-color', '#9A0000');

        const innerWidget = widget.querySelector('etrusted-trusted-stars-service-widget');

        if (innerWidget) {
          innerWidget.style.setProperty('--accent-color', '#9A0000');
        }

      });

  }

  updateEtrustedWidgets();

  const observer = new MutationObserver(function() {
    updateEtrustedWidgets();
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });

});
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  function updateHeaderCartBubble() {
    fetch('/cart.js')
      .then(function(response) {
        return response.json();
      })
      .then(function(cart) {
        document.querySelectorAll('[data-fh-cart-bubble]').forEach(function(bubble) {
          bubble.textContent = cart.item_count;

          if (cart.item_count > 0) {
            bubble.classList.remove('hidden');
          } else {
            bubble.classList.add('hidden');
          }
        });
      });
  }

  document.addEventListener('cart:updated', updateHeaderCartBubble);
  document.addEventListener('cart:refresh', updateHeaderCartBubble);
  document.addEventListener('cart:change', updateHeaderCartBubble);

  document.addEventListener('submit', function(event) {
    if (event.target && event.target.matches('form[action*="/cart/add"]')) {
      setTimeout(updateHeaderCartBubble, 600);
      setTimeout(updateHeaderCartBubble, 1200);
    }
  });

  document.addEventListener('click', function(event) {
    if (event.target.closest('[name="add"], button[type="submit"], .product-form__submit')) {
      setTimeout(updateHeaderCartBubble, 600);
      setTimeout(updateHeaderCartBubble, 1200);
    }
  });

  updateHeaderCartBubble();
});
</script>
