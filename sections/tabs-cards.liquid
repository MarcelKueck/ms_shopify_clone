      { "type": "range", "id": "max_width", "min": 720, "max": 1400, "step": 10, "unit": "px", "label": "Max. Breite", "default": 1100 },
      { "type": "range", "id": "card_min_h", "min": 0, "max": 800, "step": 10, "unit": "px", "label": "Min. Kartenhöhe (Desktop)", "default": 0 },
      { "type": "range", "id": "comp_limit", "min": 2, "max": 12, "step": 1, "label": "Zubehör: Anzahl Produkte", "default": 8 },
      { "type": "checkbox", "id": "show_qa_tab", "label": "Q&A-Tab anzeigen", "default": true },
      { "type": "header", "content": "Zubehör – Produktkarten" },
      { "type": "range", "id": "comp_visible_desktop", "min": 2, "max": 7, "step": 1, "label": "Sichtbare Produkte Desktop", "default": 5 },
      { "type": "select", "id": "comp_visible_mobile", "label": "Sichtbare Produkte mobil", "options": [{"value":"1","label":"1"},{"value":"2","label":"2"}], "default": "2" },
      { "type": "color", "id": "comp_card_background", "label": "Hintergrund Produktkarten", "default": "#FFFFFF" },
      { "type": "checkbox", "id": "comp_enable_shadow", "label": "Hover-Schatten aktivieren", "default": false },
      { "type": "color", "id": "comp_shadow_color", "label": "Schattenfarbe", "default": "#000000" },
      { "type": "range", "id": "comp_shadow_opacity", "label": "Schattenintensität", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 20 },
      { "type": "range", "id": "comp_shadow_size", "label": "Schattenstärke", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 30 }
    ],
    "blocks": [
      {
        "type": "tab",
        "name": "Tab",
        "limit": 6,
        "settings": [
          { "type": "text", "id": "tab_title", "label": "Tab-Titel", "default": "Tab-Titel" },
          { "type": "richtext", "id": "tab_content", "label": "Inhalt (Fallback)", "default": "<p>Dein Inhalt hier …</p>" }
        ]
      }
    ],
    "max_blocks": 6,
    "presets": [
      {
        "name": "Tabs – Produkt",
        "blocks": [{ "type": "tab" }, { "type": "tab" }, { "type": "tab" }, { "type": "tab" }]
      }
    ]
  }
  {% endschema %}
</section>
