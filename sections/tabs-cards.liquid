{% comment %}
  Section: Tabs (Kartenreiter) – Produktseite
  Tabs:
  1) Beschreibung (Block-Richtext)
  2) Details (custom.kurztext + custom.zusatzbilder, Fallback: Block-Richtext)
  3) Bewertungen (Loox – produktspezifisch)
  4) Zubehör (intent=complementary) – lädt über separate Section + Fallback-JS
{% endcomment %}

{% assign comp_shadow_alpha = section.settings.comp_shadow_opacity | divided_by: 100.0 %}
<section class="tabs-cards-section" id="section-{{ section.id }}" style="--comp-visible: {{ section.settings.comp_visible_desktop }}; --comp-mobile: {{ section.settings.comp_visible_mobile }}; --comp-card-bg: {{ section.settings.comp_card_background }}; --comp-shadow-color: {{ section.settings.comp_shadow_color | color_modify: 'alpha', comp_shadow_alpha }}; --comp-shadow-blur: {{ section.settings.comp_shadow_size }}px; --comp-star-color: #9A0000;">
  <div class="tabs-cards container">
    {% if section.settings.heading != blank %}
      <h2 class="tabs-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% assign blocks = section.blocks %}

    {%- liquid
      # Q&A-Tab: nur rendern, wenn das Metafeld custom.qa (JSON) mindestens
      # einen gültigen Eintrag mit nicht-leerem q UND a enthält.
      assign qa_count = 0
      if section.settings.show_qa_tab
        assign qa_value = product.metafields.custom.qa.value
        if qa_value
          for qa_item in qa_value limit: 20
            assign qa_q = qa_item['q'] | strip_html | strip
            assign qa_a = qa_item['a'] | strip_html | strip
            if qa_q != '' and qa_a != ''
              assign qa_count = qa_count | plus: 1
            endif
          endfor
        endif
      endif
      assign tab_count = blocks.size
      if qa_count > 0
        assign tab_count = tab_count | plus: 1
        assign qa_tab_index = blocks.size | plus: 1
      endif
    -%}

    {% if blocks.size > 0 %}

      <div class="tabs" role="tablist" aria-label="{{ section.settings.heading | default: 'Tabs' }}">
        {% for block in blocks %}
          {% assign is_active = forloop.first %}
          <button
            id="tab-{{ section.id }}-{{ forloop.index }}"
            class="tab-btn{% if is_active %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if is_active %}true{% else %}false{% endif %}"
            aria-controls="panel-{{ section.id }}-{{ forloop.index }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.tab_title | escape }}
          </button>
        {% endfor %}
        {% if qa_count > 0 %}
          <button
            id="tab-{{ section.id }}-{{ qa_tab_index }}"
            class="tab-btn"
            role="tab"
            aria-selected="false"
            aria-controls="panel-{{ section.id }}-{{ qa_tab_index }}"
          >
            {{ 'products.product.qa_tab_label' | t }}
          </button>
        {% endif %}
      </div>

      <div class="tab-panels">
        {% for block in blocks %}
          {% assign is_active = forloop.first %}

          <button
            type="button"
            id="accordion-{{ section.id }}-{{ forloop.index }}"
            class="accordion-btn"
            aria-expanded="false"
            aria-controls="panel-{{ section.id }}-{{ forloop.index }}"
            data-tab-index="{{ forloop.index0 }}"
          >
            <span>{{ block.settings.tab_title | escape }}</span>
            <span class="accordion-icon" aria-hidden="true"></span>
          </button>

          <div
            id="panel-{{ section.id }}-{{ forloop.index }}"
            class="tab-panel{% if is_active %} is-active{% endif %}"
            role="tabpanel"
            aria-labelledby="tab-{{ section.id }}-{{ forloop.index }}"
            {% unless is_active %}hidden{% endunless %}
          >
            <div class="panel-card">
              {% case forloop.index %}

                {% when 1 %}
                  {% if block.settings.tab_content != blank %}
                    {{ block.settings.tab_content }}
                  {% else %}
                    <p>Bitte Inhalt für Tab&nbsp;1 im Editor pflegen.</p>
                  {% endif %}

                {% when 2 %}
                  {%- comment -%}
                    Tab 2: Zweispaltig
                    Links: Richtext aus custom.kurztext (HTML bleibt erhalten), Fallback: Block-Content
                    Rechts: Zusatzbilder aus custom.zusatzbilder (Liste von Dateien ODER einzelne Datei)
                  {%- endcomment -%}
                  <div class="tab2-grid">
                    <div class="tab2-left">
                      {% if product and product.metafields.custom.kurztext != blank %}
                        {{ product.metafields.custom.kurztext | metafield_tag }}
                      {% else %}
                        {{ block.settings.tab_content }}
                      {% endif %}
                    </div>

                    <div class="tab2-right">
                      {%- assign mf = product.metafields.custom.zusatzbilder -%}
                      {%- if mf and mf.value -%}
                        {%- if mf.type contains 'list' -%}
                          {%- for file in mf.value limit: 2 -%}
                            {%- render 'tab2-image-item', file: file, product: product -%}
                          {%- endfor -%}
                        {%- else -%}
                          {%- assign file = mf.value -%}
                          {%- render 'tab2-image-item', file: file, product: product -%}
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                  </div>

                {% when 3 %}
                  {%- comment -%} Sprungmarke für Scroll (Offset gegen Header) {%- endcomment -%}
                  <div id="loox-faq" class="loox-faq-anchor" aria-hidden="true"></div>

                  {%- comment -%}
                    Loox Product Reviews Widget (produktspezifisch)
                    Wichtig: Loox erwartet data-product-id (nicht data-loox-product-id)
                  {%- endcomment -%}
                  <div
                    id="looxReviews"
                    class="loox-reviews-default"
                    data-product-id="{{ product.id }}">
                  </div>

                {% when 4 %}
                  {%- comment -%} Zubehör via Recommendations-API (intent=complementary)
                                 Erfordert /sections/complementary-products-tab.liquid {%- endcomment -%}
                  <product-recommendations
                    class="comp-root"
                    data-url="{{ routes.product_recommendations_url }}?section_id=complementary-products-tab&product_id={{ product.id }}&intent=complementary{% if section.settings.comp_limit %}&limit={{ section.settings.comp_limit }}{% endif %}">
                    <div>Lade Zubehör …</div>
                  </product-recommendations>

                {% else %}
                  {{ block.settings.tab_content }}

              {% endcase %}
            </div>
          </div>
        {% endfor %}
        {% if qa_count > 0 %}
          <button
            type="button"
            id="accordion-{{ section.id }}-{{ qa_tab_index }}"
            class="accordion-btn"
            aria-expanded="false"
            aria-controls="panel-{{ section.id }}-{{ qa_tab_index }}"
            data-tab-index="{{ qa_tab_index | minus: 1 }}"
          >
            <span>{{ 'products.product.qa_tab_label' | t }}</span>
            <span class="accordion-icon" aria-hidden="true"></span>
          </button>

          <div
            id="panel-{{ section.id }}-{{ qa_tab_index }}"
            class="tab-panel"
            role="tabpanel"
            aria-labelledby="tab-{{ section.id }}-{{ qa_tab_index }}"
            hidden
          >
            <div class="panel-card">
              {% render 'product-qa', product: product %}
            </div>
          </div>
        {% endif %}
      </div>

    {% else %}
      <p>Bitte Tabs im Theme-Editor hinzufügen.</p>
    {% endif %}
  </div>

  <style>
  /* === Container === */
  #section-{{ section.id }} .container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  #section-{{ section.id }} .tabs-heading {
    margin-bottom: 1rem;
  }

/* ===================================================
   Tabs – leichte Reiter
   =================================================== */

/* ===================================================
   Desktop-Tabs
   =================================================== */

/* ===================================================
   Desktop-Tabs – kräftigere Darstellung
   =================================================== */

#section-{{ section.id }} .tabs {
  display: grid;
  grid-template-columns: repeat({{ tab_count | default: 4 }}, 1fr);
  gap: 0;
  align-items: stretch;

  border: 1.5px solid #cfcfcf;
  border-radius: 12px;
  overflow: hidden;

  padding: 0;
  margin-bottom: 1.5rem;
  background: #fff;
}

#section-{{ section.id }} .tab-btn {
  position: relative;
  min-height: 58px;

  border: 0;
  border-right: 1.5px solid #cfcfcf;

  background: #fff;
  color: #111;

  cursor: pointer;
  text-align: center;

  padding: 16px 18px;

  font-size: 17px;
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: .01em;

  white-space: nowrap;
  outline: none;

  transition:
    background-color .2s ease,
    color .2s ease,
    box-shadow .2s ease;
}

#section-{{ section.id }} .tab-btn:last-child {
  border-right: 0;
}

#section-{{ section.id }} .tab-btn::after {
  display: none;
}

/* Aktiver Tab: hellblauer Hintergrund und blaue Kontur */
#section-{{ section.id }} .tab-btn.is-active {
  z-index: 2;
  background: #f5fbff;
  color: #111;
  font-weight: 700;
  box-shadow: inset 0 0 0 1px #59aee0;
}

/* Hover: hellblauer Hintergrund, aber keinerlei zusätzliche Kontur */
#section-{{ section.id }} .tab-btn:hover {
  z-index: 2;
  background: #f5fbff;
  color: #111;
  box-shadow: none;
}

/* Auch beim Hover über dem aktiven Tab Kontur ausblenden */
#section-{{ section.id }} .tab-btn.is-active:hover {
  background: #f5fbff;
  color: #111;
  box-shadow: none;
}

/* Linke Rundung beim ersten aktiven Tab */
#section-{{ section.id }} .tab-btn:first-child.is-active,
#section-{{ section.id }} .tab-btn:first-child:hover {
  border-radius: 10px 0 0 10px;
}

/* Rechte Rundung beim letzten aktiven Tab */
#section-{{ section.id }} .tab-btn:last-child.is-active,
#section-{{ section.id }} .tab-btn:last-child:hover {
  border-radius: 0 10px 10px 0;
}

/* Tastaturfokus */
#section-{{ section.id }} .tab-btn:focus-visible {
  z-index: 3;
  outline: none;
  box-shadow:
    inset 0 0 0 3px rgba(0, 140, 203, .55);
}

/* === Panels / Rahmen um die Tab-Sektion === */
#section-{{ section.id }} .tab-panels {
  margin-top: 1rem;
}

#section-{{ section.id }} .panel-card {
  border: 1px solid rgba(0,0,0,.08);
  border-radius: 14px;
  padding: 1.5rem;
  background: #fff;
  box-shadow: 0 8px 24px rgba(0,0,0,.045);
}

@media (min-width: 900px) {
  #section-{{ section.id }} .tab-panels .tab-panel .panel-card {
    min-height: {{ section.settings.card_min_h }}px;
  }
}

  /* === Richtext-Spacing allgemein === */
  #section-{{ section.id }} .panel-card p {
    margin: 0 0 1rem;
    line-height: 1.55;
  }

  #section-{{ section.id }} .panel-card ul,
  #section-{{ section.id }} .panel-card ol {
    margin: 0 0 1rem 1.5rem;
    padding-left: 0;
  }

  #section-{{ section.id }} .panel-card ul {
    list-style: disc;
  }

  #section-{{ section.id }} .panel-card ol {
    list-style: decimal;
  }

  #section-{{ section.id }} .panel-card li {
    margin: .3rem 0;
    line-height: 1.5;
  }

  /* === Tab 2: zweispaltig === */
  #section-{{ section.id }} .tab2-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 900px) {
    #section-{{ section.id }} .tab2-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  #section-{{ section.id }} .tab2-left p {
    margin: 0 0 1rem;
    line-height: 1.55;
  }

  #section-{{ section.id }} .tab2-right .tab2-image {
    margin-bottom: 1rem;
  }

  #section-{{ section.id }} .tab2-right img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: .5rem;
  }

  /* === Nur Tab 2: Bullets aus, Streifen beibehalten === */
  #section-{{ section.id }} #panel-{{ section.id }}-2 .panel-card ul {
    list-style: none;
    margin: 0;
    padding-left: 0;
  }

  #section-{{ section.id }} #panel-{{ section.id }}-2 .panel-card ul li {
    padding: 4px 6px;
  }

  #section-{{ section.id }} #panel-{{ section.id }}-2 .panel-card ul li:nth-child(odd) {
    background-color: #fff;
  }

  #section-{{ section.id }} #panel-{{ section.id }}-2 .panel-card ul li:nth-child(even) {
    background-color: #eee;
  }

  /* ---- Loox: Sprungmarke Offset ---- */
  #section-{{ section.id }} .loox-faq-anchor {
    position: relative;
    top: -220px;
    height: 1px;
  }

  @media (max-width: 640px) {
    #section-{{ section.id }} .loox-faq-anchor {
      top: -70px;
    }
  }

  /* ===== Tab 3: Loox – darf NICHT abgeschnitten werden ===== */
  #section-{{ section.id }} #panel-{{ section.id }}-3,
  #section-{{ section.id }} #panel-{{ section.id }}-3 .panel-card {
    overflow: visible !important;
    height: auto !important;
    max-height: none !important;
  }

  #section-{{ section.id }} #looxReviews {
    position: relative !important;
    overflow: visible !important;
    min-height: 1px;
  }

  #section-{{ section.id }} #looxReviews #grid {
    position: relative !important;
    overflow: visible !important;
  }

   /* Zubehör Tab: Karten aus complementary-products-tab.liquid */
   #section-{{ section.id }} #panel-{{ section.id }}-4 .panel-card { overflow: visible; }
   #section-{{ section.id }} .comp-rp03-carousel { position: relative; width: 100%; min-width: 0; }
   #section-{{ section.id }} .comp-rp03-carousel .product-carousel-wrapper { width: 100%; min-width: 0; }
   #section-{{ section.id }} .comp-rp03-carousel .grid-carousel--products { align-items: stretch; }
   #section-{{ section.id }} .comp-rp03-carousel { --grid-products-columns-sm: {% if section.settings.comp_visible_mobile == '1' %}1.15{% else %}1.6{% endif %}; }
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-item { min-width: 0; padding: 7px 0 12px; background: transparent !important; }
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-card {
     height: 100%; display: flex; flex-direction: column; overflow: hidden;
     border: 0 !important; outline: 0 !important; border-radius: 16px;
     background: var(--comp-card-bg) !important;
     box-shadow: none !important;
     transition: transform .2s ease, box-shadow .2s ease;
   }
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-card::before,
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-card::after { border: 0 !important; }
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-media {
     position: relative; display: block; aspect-ratio: 1 / 1;
     overflow: hidden; background: #f5f5f5;
   }
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-media img,
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-media svg {
     display: block; width: 100%; height: 100%; object-fit: cover;
   }
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-badge {
     position: absolute; z-index: 2; display: inline-flex; align-items: center;
     justify-content: center; min-height: 26px; padding: 5px 9px;
     border-radius: 4px; font-size: 11px; font-weight: 700;
     line-height: 1; letter-spacing: .03em; pointer-events: none;
   }
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-badge--sale {
     top: 12px; right: 12px; color: #fff; background: #9A0000;
   }
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-badge--soldout {
     bottom: 12px; left: 12px; background: #eee; color: #000; font-size: 10px;
   }
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-content {
     display: flex; flex: 1 1 auto; flex-direction: column;
     padding: 16px; background: var(--comp-card-bg) !important;
   }
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-title {
     margin: 0 0 8px; font-family: Montserrat, sans-serif;
     font-size: 15px; font-weight: 300; line-height: 1.45;
   }
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-title a {
     color: inherit; text-decoration: none;
   }
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-price {
     margin-top: auto; font-family: Montserrat, sans-serif;
     font-size: 14px; font-weight: 700 !important; line-height: 1.5;
     color: #111 !important;
   }
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-price s {
     margin-left: 5px; color: #9A0000 !important;
     opacity: 1 !important; font-weight: 400 !important;
   }
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-rating {
     margin-top: 8px; font-size: 14px; line-height: 1.4;
     color: var(--comp-star-color) !important;
   }
   #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-card a:focus-visible {
     outline: 2px solid currentColor; outline-offset: -3px;
   }
   @media (hover: hover) and (prefers-reduced-motion: no-preference) {
     #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-card:hover {
       transform: translateY(-5px);
       box-shadow: {% if section.settings.comp_enable_shadow %}0 16px var(--comp-shadow-blur) var(--comp-shadow-color){% else %}none{% endif %} !important;
     }
   }
   @media (min-width: 990px) {
     #section-{{ section.id }} .comp-rp03-carousel scroll-carousel .grid-carousel--products {
       --comp-gap: 16px;
       display: grid !important; grid-auto-flow: column !important;
       grid-template-columns: none !important;
       grid-auto-columns: calc((100% - (var(--comp-visible) - 1) * var(--comp-gap)) / var(--comp-visible)) !important;
       column-gap: var(--comp-gap) !important; justify-content: start !important;
     }
     #section-{{ section.id }} .comp-rp03-carousel scroll-carousel .grid-carousel--products > .grid-carousel-item {
       width: 100% !important; min-width: 0 !important; max-width: none !important;
       box-sizing: border-box;
     }
   }
   @media (max-width: 749px) {
     #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-content { padding: 12px; }
     #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-title { font-size: 14px; }
   }
   @media (prefers-reduced-motion: reduce) {
     #section-{{ section.id }} .comp-rp03-carousel .comp-rp03-card { transition: none; }
   }

  /* =========================================================
     TAB 1 – ANGEPASSTE FORMATIERUNG
     ========================================================= */

  #section-{{ section.id }} #panel-{{ section.id }}-1 .panel-card {
    overflow: visible;
  }

  #section-{{ section.id }} #panel-{{ section.id }}-1 .panel-card h1 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 .75rem;
  }

  #section-{{ section.id }} #panel-{{ section.id }}-1 .panel-card h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 1.25rem 0 .5rem;
  }

  #section-{{ section.id }} #panel-{{ section.id }}-1 .panel-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 1rem 0 .4rem;
  }

  #section-{{ section.id }} #panel-{{ section.id }}-1 .panel-card p {
    font-size: .85rem;
    line-height: 1.55;
    margin: 0 0 .9rem;
  }

  #section-{{ section.id }} #panel-{{ section.id }}-1 .panel-card ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0 0 .9rem;
  }

  #section-{{ section.id }} #panel-{{ section.id }}-1 .panel-card li {
    margin: .3rem 0;
    line-height: 1.5;
  }

  /* ===================================================
     Mobil: Akkordeon statt Tab-Raster
     =================================================== */
  #section-{{ section.id }} .accordion-btn {
    display: none;
  }

  @media (max-width: 767px) {
    #section-{{ section.id }} .tabs {
      display: none;
    }

    #section-{{ section.id }} .tab-panels {
      margin-top: 0;
      border-top: 1px solid rgba(0,0,0,.12);
    }

    #section-{{ section.id }} .accordion-btn {
      display: flex;
      width: 100%;
      min-height: 62px;
      padding: 15px 4px 15px 0;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      border: 0;
      border-bottom: 1px solid rgba(0,0,0,.12);
      border-radius: 0;
      background: transparent;
      color: #111;
      font: inherit;
      font-size: 17px;
      font-weight: 700;
      line-height: 1.25;
      text-align: left;
      cursor: pointer;
      box-shadow: none;
      appearance: none;
      -webkit-appearance: none;
    }

    #section-{{ section.id }} .accordion-btn:hover,
    #section-{{ section.id }} .accordion-btn.is-active {
      background: transparent;
      color: #111;
    }

    #section-{{ section.id }} .accordion-btn:focus-visible {
      outline: 2px solid rgba(0,140,203,.5);
      outline-offset: 3px;
    }

    #section-{{ section.id }} .accordion-icon {
      position: relative;
      flex: 0 0 28px;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #e5e7e9;
    }

    #section-{{ section.id }} .accordion-icon::before,
    #section-{{ section.id }} .accordion-icon::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      width: 9px;
      height: 1.5px;
      background: #111;
      transform: translate(-50%, -50%);
      transition: transform .2s ease;
    }

    #section-{{ section.id }} .accordion-icon::after {
      transform: translate(-50%, -50%) rotate(90deg);
    }

    #section-{{ section.id }} .accordion-btn.is-active .accordion-icon::after {
      transform: translate(-50%, -50%) rotate(0deg);
    }

    #section-{{ section.id }} .tab-panel {
      display: none;
      padding: 0;
    }

    #section-{{ section.id }} .tab-panel.is-active {
      display: block;
    }

    #section-{{ section.id }} .tab-panel[hidden] {
      display: none !important;
    }

    #section-{{ section.id }} .panel-card {
      padding: 1.1rem 0 1.4rem;
      border: 0;
      border-bottom: 1px solid rgba(0,0,0,.12);
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    #section-{{ section.id }} .accordion-btn + .tab-panel .panel-card {
      margin: 0;
    }

    #section-{{ section.id }} .tab2-grid {
      gap: 1rem;
    }
  }

  /* === Mobil: kein „nach rechts schwimmen“ === */
  @media (max-width: 767px) {
    #section-{{ section.id }} {
      overflow-x: hidden;
    }

    #section-{{ section.id }} .tabs {
      overflow-x: hidden;
    }
  }
</style>

  <script>
    (function() {
      const root = document.getElementById('section-{{ section.id }}');
      if (!root) return;

      const tabs       = Array.from(root.querySelectorAll('.tab-btn'));
      const accordions = Array.from(root.querySelectorAll('.accordion-btn'));
      const panels     = Array.from(root.querySelectorAll('.tab-panel'));
      const mobileMq   = window.matchMedia('(max-width: 767px)');

      function runPanelHooks(index) {
        // Tab 3 (Index 2): Loox neu layouten, weil Panel zuvor hidden war
        if (index === 2) {
          const kick = () => {
            try { window.Loox && typeof window.Loox.refresh === 'function' && window.Loox.refresh(); } catch(_) {}
            try { window.dispatchEvent(new Event('resize')); } catch(_) {}
          };
          setTimeout(kick, 30);
          setTimeout(kick, 180);
          setTimeout(kick, 700);
        }

        // Tab 4 (Index 3): Zubehör laden
        if (index === 3) {
          const recEl = root.querySelector('product-recommendations[data-url]');
          recEl && loadComplementary(recEl);
        }
      }

      function activate(index, options = {}) {
        const isMobile = mobileMq.matches;
        const allowCollapse = options.allowCollapse === true;
        const currentlyOpen = panels[index] && panels[index].classList.contains('is-active');

        if (isMobile && allowCollapse && currentlyOpen) {
          panels[index].classList.remove('is-active');
          panels[index].setAttribute('hidden', '');

          if (accordions[index]) {
            accordions[index].classList.remove('is-active');
            accordions[index].setAttribute('aria-expanded', 'false');
          }
          return;
        }

        tabs.forEach((tab, i) => {
          const active = i === index;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
          tab.setAttribute('tabindex', active ? '0' : '-1');
        });

        accordions.forEach((button, i) => {
          const active = i === index;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-expanded', active ? 'true' : 'false');
        });

        panels.forEach((panel, i) => {
          const active = i === index;
          panel.classList.toggle('is-active', active);
          if (active) panel.removeAttribute('hidden');
          else panel.setAttribute('hidden', '');
        });

        runPanelHooks(index);
      }

function setResponsiveState() {
  if (mobileMq.matches) {
    /*
     * Mobil:
     * Beim Wechsel in die mobile Ansicht werden zunächst
     * alle Bereiche geschlossen und anschließend der erste geöffnet.
     */
    accordions.forEach((button) => {
      button.classList.remove('is-active');
      button.setAttribute('aria-expanded', 'false');
    });

    panels.forEach((panel) => {
      panel.classList.remove('is-active');
      panel.setAttribute('hidden', '');
    });

    toggleMobileAccordion(0, true);
  } else {
    /*
     * Desktop:
     * Klassisches Tab-Verhalten.
     */
    activate(0);
  }
}

      function loadComplementary(el) {
        if (!el || !el.getAttribute('data-url') || el.dataset.loaded) return;
        const url = el.getAttribute('data-url');
        el.setAttribute('data-loading', 'true');

        fetch(url, { credentials: 'same-origin' })
          .then(r => r.text())
          .then(html => {
            el.innerHTML = html;
            el.dataset.loaded = 'true';

                         // Zubehörkarten werden bereits vollständig in der Section ausgegeben.
             // Keine nachträgliche DOM-Umschreibung erforderlich.

document.dispatchEvent(new CustomEvent('product-recommendations:loaded', { detail: { el } }));
            window.dispatchEvent(new Event('resize'));
          })
          .catch(() => {
            el.innerHTML = '<p>Aktuell kein Zubehör empfohlen.</p>';
          })
          .finally(() => {
            el.removeAttribute('data-loading');
          });
      }

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => activate(i));
      });

      accordions.forEach((button, i) => {
  button.addEventListener('click', () => {
    if (mobileMq.matches) {
      toggleMobileAccordion(i);
    } else {
      activate(i);
    }
  });
});

      setResponsiveState();

      if (typeof mobileMq.addEventListener === 'function') {
        mobileMq.addEventListener('change', setResponsiveState);
      } else if (typeof mobileMq.addListener === 'function') {
        mobileMq.addListener(setResponsiveState);
      }

      const recEl = root.querySelector('product-recommendations[data-url]');
      recEl && loadComplementary(recEl);

      function openReviewsAndScroll() {
        activate(2);

        const anchor = root.querySelector('#loox-faq');
        const mobileButton = accordions[2];
        const target = mobileMq.matches
          ? (mobileButton || anchor || root.querySelector('#panel-{{ section.id }}-3'))
          : (anchor || root.querySelector('#looxReviews') || root.querySelector('#panel-{{ section.id }}-3'));
        if (!target) return;

        const doScroll = () => {
          try { target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
          catch(_) { window.location.hash = '#loox-faq'; }
        };
        setTimeout(doScroll, 60);
        setTimeout(doScroll, 240);
      }

document.addEventListener(
  'click',
  function (e) {
    const hit = e.target.closest(
      '.loox-rating, .loox-rating-content, .loox-rating-stars, [data-loox-rating], .loox-stars, .loox-rating-fallback'
    );
    if (!hit) return;

    e.preventDefault();
    openReviewsAndScroll();
  },
  true
);

function toggleMobileAccordion(index, forceOpen = false) {
  const panel = panels[index];
  const button = accordions[index];

  if (!panel || !button) return;

  const isOpen = panel.classList.contains('is-active');
  const shouldOpen = forceOpen || !isOpen;

  panel.classList.toggle('is-active', shouldOpen);
  button.classList.toggle('is-active', shouldOpen);

  button.setAttribute(
    'aria-expanded',
    shouldOpen ? 'true' : 'false'
  );

  if (shouldOpen) {
    panel.removeAttribute('hidden');
    runPanelHooks(index);
  } else {
    panel.setAttribute('hidden', '');
  }
}

    })();
  </script>

  {% schema %}
  {
    "name": "Tabs – Produkt",
    "settings": [
