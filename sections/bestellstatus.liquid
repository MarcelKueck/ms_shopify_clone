<section id="ms-order-status">
  <style>
    #ms-order-status .ms-section{padding:60px 20px}
    #ms-order-status .ms-container{max-width:1100px;margin:0 auto}
    #ms-order-status .ms-h2{margin:0 0 20px 0 !important;padding:0 !important;font-weight:700;font-size:28px;line-height:1.2}
    #ms-order-status .ms-lead{font-size:18px;max-width:760px}
    #ms-order-status .ms-card{background:#fff;border:1px solid #e5e7eb;border-radius:18px;padding:22px}
    #ms-order-status .ms-steps{margin:0;padding:0;list-style:none;display:grid;gap:14px}
    #ms-order-status .ms-step{display:flex;align-items:flex-start;gap:12px}
    #ms-order-status .ms-step svg{flex:0 0 22px;margin-top:2px}
    #ms-order-status .ms-badges{display:flex;flex-wrap:wrap;gap:12px;margin-top:20px;padding:0;list-style:none}
    #ms-order-status .ms-badges li{padding:8px 12px;border:1px solid #e5e7eb;border-radius:999px;background:#fff}
    #ms-order-status .ms-form-wrap{max-width:820px}
    #ms-order-status label{display:block;margin-bottom:6px;font-weight:600}
    #ms-order-status input,
    #ms-order-status select,
    #ms-order-status textarea{
      width:100%;
      padding:12px;
      border:1px solid #d1d5db;
      border-radius:10px;
      background:#fff;
      font:inherit;
      box-sizing:border-box;
    }
    #ms-order-status input[type="checkbox"]{
      width:auto;
      padding:0;
      border:none;
      border-radius:0;
      margin:0;
    }
    #ms-order-status textarea{min-height:140px;resize:vertical}
    #ms-order-status .ms-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
    #ms-order-status .ms-btn{
      display:inline-block;background:#111827;color:#fff;padding:14px 24px;border:none;
      border-radius:12px;text-decoration:none;font-weight:600;cursor:pointer
    }
    #ms-order-status .ms-btn-secondary{
      display:inline-block;border:1px solid #111827;color:#111827;padding:14px 24px;
      border-radius:12px;text-decoration:none;font-weight:600
    }
    #ms-order-status .ms-muted{color:#4b5563}
    #ms-order-status .ms-success{padding:16px;background:#d1fae5;border-radius:8px;margin-bottom:24px}
    #ms-order-status .ms-error{padding:16px;background:#fee2e2;border-radius:8px;margin-bottom:24px}
    #ms-order-status .ms-checkbox-row{
      display:flex;
      align-items:flex-start;
      gap:10px;
      margin-top:4px;
    }
    #ms-order-status .ms-checkbox-row label{
      margin:0;
      font-weight:400;
      line-height:1.5;
    }

    @media (max-width: 900px){
      #ms-order-status .ms-form-grid{grid-template-columns:1fr}
    }

    @media (prefers-reduced-motion: no-preference){
      #ms-order-status .reveal{opacity:0;transform:translateY(12px);will-change:opacity,transform;transition:opacity .5s ease, transform .6s cubic-bezier(.22,.61,.36,1)}
      #ms-order-status .reveal.fade-in{transform:none}
      #ms-order-status .reveal.is-visible{opacity:1;transform:none}
      #ms-order-status .stagger > *{opacity:0;transform:translateY(12px);transition:opacity .45s ease, transform .55s ease}
      #ms-order-status .stagger.is-visible > *{opacity:1;transform:none}
      #ms-order-status .stagger.is-visible > *:nth-child(1){transition-delay:.05s}
      #ms-order-status .stagger.is-visible > *:nth-child(2){transition-delay:.12s}
      #ms-order-status .stagger.is-visible > *:nth-child(3){transition-delay:.19s}
      #ms-order-status .stagger.is-visible > *:nth-child(4){transition-delay:.26s}
      #ms-order-status .stagger.is-visible > *:nth-child(5){transition-delay:.33s}
    }
  </style>

  <div class="ms-section">
    <div class="ms-container">
      <p class="reveal fade-in" style="background:#f3f4f6; display:inline-block; padding:6px 12px; border-radius:999px; font-size:14px; margin-bottom:16px;">
        motion sports Service
      </p>

      <h1 class="reveal" style="font-size:36px; font-weight:700; margin-bottom:20px;">
        Bestellstatus anfragen
      </h1>

      <p class="reveal ms-lead">
        Du vermisst deine Bestellung? Kein Problem – sende uns einfach die nachfolgenden Angaben und wir geben dir schnellstmöglich Bescheid zum Versandstatus.
      </p>

      <ul class="reveal fade-in ms-badges">
        <li>Schnelle Rückmeldung</li>
        <li>Direkte Zuordnung zur Bestellung</li>
        <li>Für Privat- und Firmenkunden</li>
        <li>Persönlicher Support</li>
      </ul>

      <div class="reveal fade-in" style="margin-top:30px;">
        <a href="#bestellstatus-form" class="ms-btn" style="margin-right:12px;">Bestellstatus anfragen</a>
        <a href="#bestellstatus-info" class="ms-btn-secondary">Infos zur Bearbeitung</a>
      </div>
    </div>
  </div>

  <div id="bestellstatus-info" class="ms-section" style="background:#f9fafb;">
    <div class="ms-container">
      <h2 class="ms-h2 reveal">So läuft deine Anfrage ab</h2>

      <ul class="ms-steps stagger">
        <li class="ms-step">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22a10 10 0 1 1 10-10"></path>
            <path d="M22 12a10 10 0 0 1-10 10"></path>
            <circle cx="12" cy="12" r="2"></circle>
            <path d="M22 2 12 12"></path>
          </svg>
          <div>
            <strong>Anfrage absenden</strong><br>
            Teile uns deine Bestelldaten, Lieferadresse und Kontaktdaten mit, damit wir deine Bestellung schnell zuordnen können.
          </div>
        </li>

        <li class="ms-step">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 16v-8a2 2 0 0 0-2-2h-5l-2-2H5a2 2 0 0 0-2 2v12"></path>
            <rect x="3" y="8" width="18" height="13" rx="2"></rect>
            <path d="m9 13 2 2 4-4"></path>
          </svg>
          <div>
            <strong>Prüfung durch unser Team</strong><br>
            Wir prüfen deine Angaben und gleichen sie mit dem aktuellen Stand deiner Bestellung und dem Versandstatus ab.
          </div>
        </li>

        <li class="ms-step">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 11a4 4 0 1 0-8 0"></path>
            <path d="M12 15v6"></path>
            <path d="M8 21h8"></path>
            <path d="M7 8h10"></path>
          </svg>
          <div>
            <strong>Rückmeldung zum Bestellstatus</strong><br>
            Wir informieren dich schnellstmöglich über den aktuellen Status deiner Bestellung und das weitere Vorgehen.
          </div>
        </li>
      </ul>
    </div>
  </div>

  <div id="bestellstatus-form" class="ms-section">
    <div class="ms-container">
      <div class="ms-form-wrap reveal fade-in">
        <h2 class="ms-h2" style="margin-bottom:12px !important;">Bestellstatus anfragen</h2>
        <p class="ms-muted" style="margin-bottom:28px;">
          Bitte fülle das Formular möglichst vollständig aus, damit wir deine Bestellung schnell zuordnen können.
        </p>

        {% form 'contact', id: 'order-status-form' %}
          {% if form.posted_successfully? %}
            <div class="ms-success">
              <strong>Vielen Dank!</strong> Deine Anfrage zum Bestellstatus wurde erfolgreich übermittelt. Wir melden uns schnellstmöglich bei dir.
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="ms-error">
              <strong>Ups!</strong> Bitte überprüfe deine Angaben.
              <ul style="margin-top:8px;">
                {% for field in form.errors %}
                  <li>{{ form.errors.messages[field] }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <input type="hidden" name="contact[tags]" value="Bestellstatus">

          <div style="display:flex; flex-direction:column; gap:16px;">
            <div class="ms-form-grid">
              <div>
                <label for="order-status-first-name">Vorname *</label>
                <input type="text" id="order-status-first-name" name="contact[first_name]" required>
              </div>
              <div>
                <label for="order-status-last-name">Nachname *</label>
                <input type="text" id="order-status-last-name" name="contact[last_name]" required>
              </div>
            </div>

            <div>
              <label for="order-status-company">ggf. Unternehmen</label>
              <input type="text" id="order-status-company" name="contact[company]">
            </div>

            <div class="ms-form-grid">
              <div>
                <label for="order-status-city">Stadt Lieferadresse *</label>
                <input type="text" id="order-status-city" name="contact[shipping_city]" required>
              </div>
              <div>
                <label for="order-status-country">Land Lieferadresse *</label>
                <input type="text" id="order-status-country" name="contact[shipping_country]" required>
              </div>
            </div>

            <div class="ms-form-grid">
              <div>
                <label for="order-status-email">E-Mail *</label>
                <input type="email" id="order-status-email" name="contact[email]" required>
              </div>
              <div>
                <label for="order-status-phone">Telefon (optional)</label>
                <input type="tel" id="order-status-phone" name="contact[phone]">
              </div>
            </div>

            <div class="ms-form-grid">
              <div>
                <label for="order-status-order-number">Bestellnummer (wenn bekannt)</label>
                <input type="text" id="order-status-order-number" name="contact[order_number]">
              </div>
              <div>
                <label for="order-status-order-date">Bestelldatum *</label>
                <input type="date" id="order-status-order-date" name="contact[order_date]" required>
              </div>
            </div>

            <div>
              <label for="order-status-message">Nachricht (optional)</label>
              <textarea id="order-status-message" name="contact[body]" placeholder="Hier kannst du weitere Hinweise zu deiner Bestellung oder deinem Anliegen ergänzen."></textarea>
            </div>

            <div class="ms-checkbox-row">
              <input type="checkbox" id="order-status-contact-request" name="contact[contact_request]" value="Ja">
              <label for="order-status-contact-request">Bitte um Kontaktaufnahme</label>
            </div>

            <div class="ms-checkbox-row">
              <input type="checkbox" id="order-status-consent" name="contact[data_privacy_accepted]" value="Ja" required>
              <label for="order-status-consent">Datenschutz akzeptiert *</label>
            </div>

            <div>
              <button type="submit" class="ms-btn" style="width:100%;">Anfrage absenden</button>
            </div>
          </div>
        {% endform %}
      </div>
    </div>
  </div>

  <div class="ms-section" style="background:#f9fafb;">
    <div class="ms-container">
      <div class="ms-card reveal fade-in">
        <h2 class="ms-h2" style="margin-bottom:12px !important;">Service & Kontakt</h2>
        <p>
          <strong>Telefon:</strong> <a href="tel:+498142448666">08142 / 448666</a><br>
          <strong>E-Mail:</strong> <a href="mailto:info@motionsports.de">info@motionsports.de</a>
        </p>
      </div>
    </div>
  </div>

  <script>
    (function() {
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var revealEls = document.querySelectorAll('#ms-order-status .reveal, #ms-order-status .stagger');
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { root: null, rootMargin: '0px 0px -10% 0px', threshold: 0.1 });

      revealEls.forEach(function(el) {
        io.observe(el);
      });
    })();
  </script>

  {% schema %}
  {
    "name": "Bestellstatus",
    "settings": [],
    "presets": [
      {
        "name": "Bestellstatus"
      }
    ]
  }
  {% endschema %}
</section>