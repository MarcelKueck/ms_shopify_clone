
{% comment %}
  MOTIONSPORTS – FEATURED PRODUCTS 03
  Version 2.4.0 | Fruits & Harvest

  - Produktliste oder Kollektion
  - Karussell
  - Individuelle Überschriftenfarben
  - Padding und Margin
  - Hover-Schatten
  - Button Normal: Hintergrund + Schrift
  - Button Hover: Hintergrund + Schrift
  - Fix für doppelte Kartenrundungen
{% endcomment %}

{% render 'section-bg-number-vars' %}

{% assign shown_products = section.settings.product_list %}
{% assign selected_collection = section.settings.collection %}

{% capture image_sizes %}
  {% render 'product-carousel-image-sizes',
    enabled: section.settings.carousel,
    grid_columns: section.settings.grid_columns,
    grid_columns_mobile: section.settings.grid_columns_mobile
  %}
{% endcapture %}

{% capture card_attrs %}
  data-animation="block"
  data-animation-group="{{ section.id }}-product-cards"
{% endcapture %}

{% assign shadow_alpha = section.settings.hover_shadow_opacity | divided_by: 100.0 %}
<style>
  /* ==========================================
     FEATURED PRODUCTS 03 – GRUNDWERTE
     ========================================== */

  #shopify-section-{{ section.id }} {
    --pm03-bg: {{ section.settings.background_color }};
    --pm03-heading-color: {{ section.settings.heading_color }};
    --pm03-subheading-color: {{ section.settings.subheading_color }};

    --pm03-shadow-color: {{ section.settings.hover_shadow_color }};
    --pm03-shadow-opacity: {{ section.settings.hover_shadow_opacity | divided_by: 100.0 }};
    --pm03-shadow-size: {{ section.settings.hover_shadow_size }}px;

    --pm03-button-bg: {{ section.settings.view_button_bg_color }};
    --pm03-button-text: {{ section.settings.view_button_text_color }};
    --pm03-button-hover-bg: {{ section.settings.view_button_hover_bg_color }};
    --pm03-button-hover-text: {{ section.settings.view_button_hover_text_color }};

    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  /* ==========================================
     SEKTION – HINTERGRUND UND ABSTÄNDE
     ========================================== */

  #shopify-section-{{ section.id }} .fp03-root {
    background-color: var(--pm03-bg);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  /* ==========================================
     ÜBERSCHRIFT UND SUBHEADING
     ========================================== */

  #shopify-section-{{ section.id }} .section-header .section-heading,
  #shopify-section-{{ section.id }} .section-header .section-title,
  #shopify-section-{{ section.id }} .section-header h1,
  #shopify-section-{{ section.id }} .section-header h2,
  #shopify-section-{{ section.id }} .section-header h3,
  #shopify-section-{{ section.id }} .section-header h4 {
    color: var(--pm03-heading-color) !important;
  }

  #shopify-section-{{ section.id }} .section-header .section-subheading,
  #shopify-section-{{ section.id }} .section-header .section-subtitle,
  #shopify-section-{{ section.id }} .section-header .subheading,
  #shopify-section-{{ section.id }} .section-header .subtitle {
    color: var(--pm03-subheading-color) !important;
  }

  /* ==========================================
     PRODUKTKARTEN
     ========================================== */

  #shopify-section-{{ section.id }} .fp03-card-wrapper {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    isolation: isolate;

    transition:
      box-shadow 0.3s ease;
  }

  /* Zusätzliche Schatten der inneren Karte vermeiden */

  #shopify-section-{{ section.id }}
  .fp03-card-wrapper .product-card {
    box-shadow: none !important;
  }

  /* ==========================================
     HOVER-SCHATTEN
     ========================================== */

  @media (hover: hover) {
    #shopify-section-{{ section.id }}
    .fp03-card-wrapper:hover {
      box-shadow:
        0 10px var(--pm03-shadow-size)
        color-mix(
          in srgb,
          var(--pm03-shadow-color)
          calc(var(--pm03-shadow-opacity) * 100%),
          transparent
        );
    }
  }

  /* Produktdarstellung analog Premium Search Grid */
  #shopify-section-{{ section.id }} .fp03-product-card { display:flex;flex-direction:column;height:100%;background:{{ section.settings.card_background_color }}; }
  #shopify-section-{{ section.id }} .fp03-media { position:relative;display:block;aspect-ratio:1;background:#f5f5f5;overflow:hidden; }
  #shopify-section-{{ section.id }} .fp03-media img { display:block;width:100%;height:100%;object-fit:cover; }
  #shopify-section-{{ section.id }} .fp03-badge { position:absolute;z-index:2;display:inline-flex;align-items:center;min-height:26px;padding:5px 9px;border-radius:4px;font-size:11px;font-weight:700;line-height:1;letter-spacing:.03em;text-transform:uppercase;pointer-events:none; }
  #shopify-section-{{ section.id }} .fp03-badge--sale { top:12px;right:12px;background:#9A0000;color:#fff; }
  #shopify-section-{{ section.id }} .fp03-badge--soldout { bottom:12px;left:12px;background:#eee;color:#000;font-size:10px; }
  #shopify-section-{{ section.id }} .fp03-content { display:flex;flex-direction:column;flex:1;padding:16px; }
  #shopify-section-{{ section.id }} .fp03-product-title { margin:0 0 8px;font-size:15px;line-height:1.4;font-weight:300; }
  #shopify-section-{{ section.id }} .fp03-product-title a { color:inherit;text-decoration:none; }
  #shopify-section-{{ section.id }} .fp03-price { font-size:14px;font-weight:700; }
  #shopify-section-{{ section.id }} .fp03-price s { margin-left:5px;opacity:.55;font-weight:400; }
  @media(max-width:749px) { #shopify-section-{{ section.id }} .fp03-content { padding:12px; } #shopify-section-{{ section.id }} .fp03-product-title { font-size:14px; } }
  @media(prefers-reduced-motion:reduce) { #shopify-section-{{ section.id }} .fp03-card-wrapper { transition:none; } }
  /* Durchgehend weisser Kartenhintergrund, auch bei unterschiedlich hohen Karten */
  #shopify-section-{{ section.id }} .fp03-item {
    background: {{ section.settings.card_background_color }};
    border-radius: 12px;
  }
  #shopify-section-{{ section.id }} .fp03-card-wrapper,
  #shopify-section-{{ section.id }} .fp03-product-card,
  #shopify-section-{{ section.id }} .fp03-content {
    background-color: {{ section.settings.card_background_color }} !important;
  }
  #shopify-section-{{ section.id }} .fp03-content {
    flex-grow: 1;
  }

/* 03 – konsistente Typografie, Loox und Hover */
#shopify-section-{{ section.id }} .section-header .section-heading,
#shopify-section-{{ section.id }} .section-header .section-title,
#shopify-section-{{ section.id }} .section-header h1,
#shopify-section-{{ section.id }} .section-header h2,
#shopify-section-{{ section.id }} .section-header h3,
#shopify-section-{{ section.id }} .section-header h4 {
  color: {{ section.settings.heading_color }} !important;
  font-size: {{ section.settings.heading_font_size }}px !important;
}
#shopify-section-{{ section.id }} .section-header .section-subheading,
#shopify-section-{{ section.id }} .section-header .section-subtitle,
#shopify-section-{{ section.id }} .section-header .subheading,
#shopify-section-{{ section.id }} .section-header .subtitle {
  color: {{ section.settings.subheading_color }} !important;
  font-size: {{ section.settings.subheading_font_size }}px !important;
}
#shopify-section-{{ section.id }} .fp03-card-wrapper {
  border-radius: 16px !important;
  overflow: hidden;
  background: {{ section.settings.card_background_color }} !important;
  height: 100%;
  transition: transform .2s ease, box-shadow .2s ease !important;
  box-shadow: none !important;
}
#shopify-section-{{ section.id }} .fp03-item {
  background: transparent !important;
  border-radius: 16px;
  padding-top: 6px;
  padding-bottom: 12px;
}
#shopify-section-{{ section.id }} .fp03-price s {
  color: #9A0000 !important;
  opacity: 1 !important;
}
#shopify-section-{{ section.id }} .fp03-rating {
  color: #9A0000;
  font-size: 14px;
  line-height: 1.4;
  margin-top: 8px;
}
@media (hover: hover) and (prefers-reduced-motion: no-preference) {
  #shopify-section-{{ section.id }} .fp03-card-wrapper:hover {
    transform: translateY(-5px) !important;
    box-shadow: {% if section.settings.enable_card_shadow %}0 16px {{ section.settings.hover_shadow_size }}px {{ section.settings.hover_shadow_color | color_modify: 'alpha', shadow_alpha }}{% else %}none{% endif %} !important;
  }
}
@media (prefers-reduced-motion: reduce) {
  #shopify-section-{{ section.id }} .fp03-card-wrapper { transition: none !important; }
}


/* v2.6: Kartenfarbe und unerwuenschte Theme-Hover-Kontur */
#shopify-section-{{ section.id }} .fp03-card-wrapper,
#shopify-section-{{ section.id }} .fp03-card-wrapper.product-card,
#shopify-section-{{ section.id }} .fp03-product-card,
#shopify-section-{{ section.id }} .fp03-content {
  background-color: {{ section.settings.card_background_color }} !important;
  border-color: transparent !important;
  outline: none !important;
}
#shopify-section-{{ section.id }} .fp03-card-wrapper:hover,
#shopify-section-{{ section.id }} .fp03-card-wrapper:focus-within {
  border-color: transparent !important;
  outline: none !important;
}
#shopify-section-{{ section.id }} .fp03-card-wrapper::before,
#shopify-section-{{ section.id }} .fp03-card-wrapper::after {
  border-color: transparent !important;
}
#shopify-section-{{ section.id }} .fp03-card-wrapper a:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: -3px;
}


/* v2.7: Sichtbare Produkte im Desktop-Karussell (2 bis 7).
   Nur diese Sektion; andere Carousel-Module bleiben unveraendert. */
@media (min-width: 990px) {
  #shopify-section-{{ section.id }} scroll-carousel .grid-carousel--products {
    --fh03-visible: {{ section.settings.grid_columns }};
    --fh03-gap: 16px;
    display: grid !important;
    grid-auto-flow: column !important;
    grid-template-columns: none !important;
    grid-auto-columns: calc((100% - (var(--fh03-visible) - 1) * var(--fh03-gap)) / var(--fh03-visible)) !important;
    column-gap: var(--fh03-gap) !important;
    justify-content: start !important;
  }
  #shopify-section-{{ section.id }} scroll-carousel .grid-carousel--products > .grid-carousel-item {
    width: 100% !important;
    min-width: 0 !important;
    max-width: none !important;
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .grid-carousel--products.grid-carousel--stack {
    grid-template-columns: repeat({{ section.settings.grid_columns }}, minmax(0, 1fr)) !important;
  }
}
</style>

<div
  {% render 'section-attrs' %}
  style="
    --pm03-bg: {{ section.settings.background_color }};
    --pm03-heading-color: {{ section.settings.heading_color }};
    --pm03-subheading-color: {{ section.settings.subheading_color }};
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {% render 'section-header' %}

  <div class="section-body">

    {% capture items %}

      {% if shown_products != blank %}

        {% for product_item in shown_products limit: 10 %}

          {% unless product_item.tags contains 'globo-product-options' %}

            <div class="grid-carousel-item fp03-item">

              <div class="fp03-card-wrapper">

                {% assign fp03_variant = blank %}
                {% for variant in product_item.variants %}
                  {% if variant.price == product_item.price %}
                    {% assign fp03_variant = variant %}
                    {% break %}
                  {% endif %}
                {% endfor %}
                {% assign fp03_saving = 0 %}
                {% if fp03_variant != blank and fp03_variant.compare_at_price != blank and fp03_variant.compare_at_price > fp03_variant.price %}
                  {% assign fp03_saving = fp03_variant.compare_at_price | minus: fp03_variant.price %}
                {% endif %}
                <article class="fp03-product-card product-card" {{ card_attrs }}>
                  <a href="{{ product_item.url }}" class="fp03-media" aria-label="{{ product_item.title | escape }}">
                    {% if fp03_saving > 0 %}<span class="fp03-badge fp03-badge--sale">%</span>{% endif %}
                    {% unless product_item.available %}<span class="fp03-badge fp03-badge--soldout">SOLD OUT</span>{% endunless %}
                    {% if product_item.featured_image %}
                      <img src="{{ product_item.featured_image | image_url: width: 800 }}"
                           alt="{{ product_item.featured_image.alt | default: product_item.title | escape }}"
                           width="800" height="{{ 800 | divided_by: product_item.featured_image.aspect_ratio | round }}"
                           loading="lazy">
                    {% else %}
                      {{ 'product-apparel-1' | placeholder_svg_tag }}
                    {% endif %}
                  </a>
                  <div class="fp03-content">
                    <h3 class="fp03-product-title"><a href="{{ product_item.url }}">{{ product_item.title | escape }}</a></h3>
                    <div class="fp03-price">{{ product_item.price | money }}{% if fp03_saving > 0 %} <s>{{ fp03_variant.compare_at_price | money }}</s>{% endif %}</div>
                    {% assign fp03_rating = product_item.metafields.loox.avg_rating.value | default: product_item.metafields.loox.rating.value %}
                    {% assign fp03_reviews = product_item.metafields.loox.num_reviews.value | default: product_item.metafields.loox.review_count.value %}
                    <div class="fp03-rating" aria-label="{% if fp03_rating != blank %}Bewertung {{ fp03_rating }} von 5{% else %}Noch keine Bewertungen{% endif %}">
                      {% if fp03_rating != blank %}★★★★★{% if fp03_reviews != blank %} ({{ fp03_reviews }}){% endif %}{% else %}☆☆☆☆☆{% endif %}
                    </div>
                  </div>
                </article>

              </div>

            </div>

          {% endunless %}

        {% endfor %}

      {% elsif selected_collection != blank %}

        {% for product_item in selected_collection.products
          limit: section.settings.products_count
        %}

          {% unless product_item.tags contains 'globo-product-options' %}

            <div class="grid-carousel-item fp03-item">

              <div class="fp03-card-wrapper">

                {% assign fp03_variant = blank %}
                {% for variant in product_item.variants %}
                  {% if variant.price == product_item.price %}
                    {% assign fp03_variant = variant %}
                    {% break %}
                  {% endif %}
                {% endfor %}
                {% assign fp03_saving = 0 %}
                {% if fp03_variant != blank and fp03_variant.compare_at_price != blank and fp03_variant.compare_at_price > fp03_variant.price %}
                  {% assign fp03_saving = fp03_variant.compare_at_price | minus: fp03_variant.price %}
                {% endif %}
                <article class="fp03-product-card product-card" {{ card_attrs }}>
                  <a href="{{ product_item.url }}" class="fp03-media" aria-label="{{ product_item.title | escape }}">
                    {% if fp03_saving > 0 %}<span class="fp03-badge fp03-badge--sale">%</span>{% endif %}
                    {% unless product_item.available %}<span class="fp03-badge fp03-badge--soldout">SOLD OUT</span>{% endunless %}
                    {% if product_item.featured_image %}
                      <img src="{{ product_item.featured_image | image_url: width: 800 }}"
                           alt="{{ product_item.featured_image.alt | default: product_item.title | escape }}"
                           width="800" height="{{ 800 | divided_by: product_item.featured_image.aspect_ratio | round }}"
                           loading="lazy">
                    {% else %}
                      {{ 'product-apparel-1' | placeholder_svg_tag }}
                    {% endif %}
                  </a>
                  <div class="fp03-content">
                    <h3 class="fp03-product-title"><a href="{{ product_item.url }}">{{ product_item.title | escape }}</a></h3>
                    <div class="fp03-price">{{ product_item.price | money }}{% if fp03_saving > 0 %} <s>{{ fp03_variant.compare_at_price | money }}</s>{% endif %}</div>
                    {% assign fp03_rating = product_item.metafields.loox.avg_rating.value | default: product_item.metafields.loox.rating.value %}
                    {% assign fp03_reviews = product_item.metafields.loox.num_reviews.value | default: product_item.metafields.loox.review_count.value %}
                    <div class="fp03-rating" aria-label="{% if fp03_rating != blank %}Bewertung {{ fp03_rating }} von 5{% else %}Noch keine Bewertungen{% endif %}">
                      {% if fp03_rating != blank %}★★★★★{% if fp03_reviews != blank %} ({{ fp03_reviews }}){% endif %}{% else %}☆☆☆☆☆{% endif %}
                    </div>
                  </div>
                </article>

              </div>

            </div>

          {% endunless %}

        {% endfor %}

      {% endif %}

    {% endcapture %}

    {% render 'product-carousel',
      enabled: section.settings.carousel,
      grid_columns: section.settings.grid_columns,
      grid_columns_mobile: section.settings.grid_columns_mobile,
      slot: items
    %}

  </div>
</div>

{% schema %}
{
  "name": "Featured Products 03",
  "class": "overflow-hidden fp03-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Fruits & Harvest – Produktmodul mit individuellen Farben, Abständen und Hover-Effekten."
    },
    {
      "type": "header",
      "content": "Produkte und Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Volle Breite",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "carousel",
      "label": "Karussell aktivieren",
      "default": true
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Einzelne Produkte auswählen",
      "limit": 10
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Oder Kollektion auswählen"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Anzahl Produkte aus Kollektion",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "grid_columns",
      "label": "Sichtbare Produkte Desktop",
      "min": 2,
      "max": 7,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "grid_columns_mobile",
      "label": "Spalten Mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Hintergrund Produktkarten",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe",
      "default": "#F8F8F8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Farbe Überschrift",
      "default": "#0B0B0B"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading Schriftgröße",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "Subheading Schriftgröße",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Farbe Subheading",
      "default": "#0B0B0B"
    },
    {
      "type": "header",
      "content": "Abstände der Sektion"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Innenabstand oben",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Innenabstand unten",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Außenabstand oben",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Außenabstand unten",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Hover-Schatten Produktkarten"
    },
    {
      "type": "checkbox",
      "id": "enable_card_shadow",
      "label": "Hover-Schatten aktivieren",
      "default": false
    },
    {
      "type": "color",
      "id": "hover_shadow_color",
      "label": "Schattenfarbe",
      "default": "#008CCB"
    },
    {
      "type": "range",
      "id": "hover_shadow_opacity",
      "label": "Schattenintensität",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "range",
      "id": "hover_shadow_size",
      "label": "Schattenstärke",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Button – Normalzustand"
    },
    {
      "type": "color",
      "id": "view_button_bg_color",
      "label": "Hintergrundfarbe",
      "default": "#E1F0FA"
    },
    {
      "type": "color",
      "id": "view_button_text_color",
      "label": "Schriftfarbe",
      "default": "#0B0B0B"
    },
    {
      "type": "header",
      "content": "Button – Hover"
    },
    {
      "type": "color",
      "id": "view_button_hover_bg_color",
      "label": "Hover Hintergrundfarbe",
      "default": "#93484D"
    },
    {
      "type": "color",
      "id": "view_button_hover_text_color",
      "label": "Hover Schriftfarbe",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Überschrift"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Jetzt entdecken"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Ausgewählte Produkte"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Überschriftsgröße",
      "options": [
        {
          "value": "h2",
          "label": "h2"
        },
        {
          "value": "h3",
          "label": "h3"
        },
        {
          "value": "h4",
          "label": "h4"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Textausrichtung",
      "options": [
        {
          "value": "text-left",
          "label": "Links"
        },
        {
          "value": "text-center",
          "label": "Mitte"
        },
        {
          "value": "text-right",
          "label": "Rechts"
        }
      ],
      "default": "text-left"
    },
    {
