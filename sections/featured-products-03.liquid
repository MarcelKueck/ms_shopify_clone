{% render 'section-bg-number-vars' %}

{% assign shown_products = section.settings.product_list %}
{% assign selected_collection = section.settings.collection %}

{% capture image_sizes %}
  {% render 'product-carousel-image-sizes',
      enabled: section.settings.carousel,
      grid_columns: section.settings.grid_columns,
      grid_columns_mobile: section.settings.grid_columns_mobile
  %}
{% endcapture %}

{% capture card_attrs %}
  data-animation="block"
  data-animation-group="{{ section.id }}-product-cards"
{% endcapture %}

<div
  {% render 'section-attrs' %}
  style="
    --pm03-bg: {{ section.settings.background_color }};
    --pm03-heading-color: {{ section.settings.heading_color }};
    --pm03-subheading-color: {{ section.settings.subheading_color }};
  "
>
  {% render 'section-header' %}

  <div class="section-body">
    {% capture items %}

      {% if shown_products != blank %}
        {% for product_item in shown_products limit: 10 %}
          {% unless product_item.tags contains 'globo-product-options' %}
            <div class="grid-carousel-item fp03-item">
              <div class="fp03-card-wrapper">
                {% render 'product-card',
                  card_product: product_item,
                  attrs: card_attrs,
                  sizes: image_sizes
                %}

                <a href="{{ product_item.url }}" class="fp03-btn-ansehen">
                  {{ 'products.product.view_product' | t }}
                </a>
              </div>
            </div>
          {% endunless %}
        {% endfor %}

      {% elsif selected_collection != blank %}
        {% for product_item in selected_collection.products limit: section.settings.products_count %}
          {% unless product_item.tags contains 'globo-product-options' %}
            <div class="grid-carousel-item fp03-item">
              <div class="fp03-card-wrapper">
                {% render 'product-card',
                  card_product: product_item,
                  attrs: card_attrs,
                  sizes: image_sizes
                %}

                <a href="{{ product_item.url }}" class="fp03-btn-ansehen">
                  {{ 'products.product.view_product' | t }}
                </a>
              </div>
            </div>
          {% endunless %}
        {% endfor %}
      {% endif %}

    {% endcapture %}

    {% render 'product-carousel',
      enabled: section.settings.carousel,
      grid_columns: section.settings.grid_columns,
      grid_columns_mobile: section.settings.grid_columns_mobile,
      slot: items
    %}
  </div>
</div>

{% schema %}
{
  "name": "Featured Products 03",
  "class": "overflow-hidden fp03-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Redaktionelles Produktmodul: entweder einzelne Produkte auswählen oder eine Kollektion anzeigen."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Volle Breite",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "carousel",
      "label": "Karussell aktivieren",
      "default": true
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Einzelne Produkte auswählen",
      "limit": 10
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Oder Kollektion auswählen"
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 2,
      "max": 20,
      "label": "Anzahl Produkte aus Kollektion",
      "default": 8
    },
    {
      "type": "range",
      "id": "grid_columns",
      "label": "Spalten Desktop",
      "min": 2,
      "max": 5,
      "default": 4
    },
    {
      "type": "select",
      "id": "grid_columns_mobile",
      "label": "Spalten Mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Farben"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hintergrundfarbe",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Farbe Subheading",
      "default": "#008CCB"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Farbe Überschrift",
      "default": "#262626"
    },
    {
      "type": "header",
      "content": "Überschrift"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Jetzt entdecken"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Ausgewählte Produkte"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Überschriftsgröße",
      "options": [
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "h4", "label": "h4" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Textausrichtung",
      "options": [
        { "value": "text-left", "label": "Links" },
        { "value": "text-center", "label": "Mitte" },
        { "value": "text-right", "label": "Rechts" }
      ],
      "default": "text-left"
    },
    {
      "type": "select",
      "id": "heading_html_tag",
      "label": "Heading HTML Tag",
      "options": [
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "p", "label": "p" }
      ],
      "default": "h2"
    }
  ],
  "presets": [
    {
      "name": "Featured Products 03"
    }
  ]
}
{% endschema %}