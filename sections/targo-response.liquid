
{% schema %}
{
  "name": "TARGO Finanzierung",
  "tag": "section",
  "class": "targo-response-section",
  "settings": []
}
{% endschema %}

<style>
  .targo-response-section .targo-box {
    max-width: 650px;
    margin: 70px auto;
    padding: 30px 24px;
    text-align: center;
  }

  .targo-response-section .targo-logo {
    max-width: 330px;
    width: 100%;
    height: auto;
    margin-bottom: 30px;
  }

  .targo-response-section .targo-title {
    font-size: 28px;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 16px;
  }

  .targo-response-section .targo-description {
    font-size: 16px;
    line-height: 1.6;
    color: #444;
  }

  .targo-response-section .targo-loader {
    width: 42px;
    height: 42px;
    margin: 30px auto;
    border: 4px solid #d8eaf2;
    border-top-color: #0F9ED5;
    border-radius: 50%;
    animation: targo-spin 0.8s linear infinite;
  }

  @keyframes targo-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .targo-response-section .targo-details {
    background: #f3f8fb;
    border: 1px solid #d4e9f2;
    border-radius: 6px;
    padding: 18px;
    margin: 24px auto;
    text-align: left;
  }

  .targo-response-section .targo-details p {
    margin: 5px 0;
  }

  .targo-response-section .targo-button {
    background: #0F9ED5;
    color: #fff;
    border: 0;
    border-radius: 5px;
    padding: 15px 25px;
    font-size: 17px;
    font-weight: 700;
    cursor: pointer;
    width: 100%;
    max-width: 440px;
  }

  .targo-response-section .targo-button:hover {
    background: #0b89b7;
  }

  .targo-response-section .targo-error {
    color: #b42318;
    font-weight: 600;
  }
</style>

<div class="page-width">
  <div class="targo-box">

    <img
      class="targo-logo"
      src="https://cdn.shopify.com/s/files/1/0823/4896/6217/files/targobank-nopadding.png?v=1745487001"
      alt="TARGOBANK"
    >

    <h1 class="targo-title" id="targo-title">
      Deine TARGOBANK-Finanzierung
    </h1>

    <p class="targo-description" id="targo-status">
      Deine Finanzierungsdaten werden vorbereitet.
    </p>

    <div class="targo-loader" id="targo-loader" hidden></div>

    <div class="targo-details" id="targo-details" hidden>
      <p>
        <strong>Bestellreferenz:</strong>
        <span id="targo-order-display"></span>
      </p>

      <p>
        <strong>Finanzierungssumme:</strong>
        <span id="targo-amount-display"></span>
      </p>

      <p id="targo-term-row" hidden>
        <strong>Gewählte Laufzeit:</strong>
        <span id="targo-term-display"></span>
      </p>
    </div>

    <p class="targo-error" id="targo-error" hidden></p>

    <form
      id="targo-finance-form"
      method="POST"
      action="https://www.targobank.de/de/app/indirectloanrequest.html"
      target="_self"
      hidden
    >
      <input
        type="hidden"
        name="koop_id"
        value="4motionsports1"
      >

      <input
        type="hidden"
        name="dealerID"
        value="806562"
      >

      <input
        type="hidden"
        name="dealerText"
        value="https://motionsports.de/pages/targo-response"
      >

      <input
        type="hidden"
        name="sessionID"
        id="sessionID"
      >

      <input
        type="hidden"
        name="amount"
        id="amount"
      >

      <input
        type="hidden"
        name="documentno"
        id="documentno"
      >

      <input
        type="hidden"
        name="loanPurpose"
        value="Fitnessgeräte und Sportartikel"
      >

      <input
        type="hidden"
        name="revocationPeriodDays"
        value="14"
      >

      <!-- Gewählte Finanzierungslaufzeit -->
      <input
        type="hidden"
        name="delay"
        id="targo-delay"
        disabled
      >

      <button type="submit" class="targo-button">
        Finanzierungsantrag bei TARGOBANK starten
      </button>
    </form>

    <p class="targo-description" id="targo-hint" hidden>
      Die TARGOBANK öffnet sich anschließend in diesem Fenster.
    </p>

  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const form = document.getElementById("targo-finance-form");
  const details = document.getElementById("targo-details");
  const error = document.getElementById("targo-error");
  const status = document.getElementById("targo-status");
  const loader = document.getElementById("targo-loader");
  const hint = document.getElementById("targo-hint");

  const params = new URLSearchParams(window.location.search);

  const amountRaw = params.get("amount");
  const orderRaw = params.get("order");
  const termRaw = params.get("laufzeit");

  const amountPattern = /^\d+(\.\d{1,2})?$/;
  const orderPattern = /^[A-Za-z0-9#-]{1,50}$/;

  const validAmount =
    amountRaw !== null &&
    amountPattern.test(amountRaw) &&
    Number.isFinite(Number(amountRaw)) &&
    Number(amountRaw) > 0;

  const validOrder =
    orderRaw !== null &&
    orderPattern.test(orderRaw) &&
    orderRaw.length <= 27;

  if (!validAmount || !validOrder) {

    status.textContent =
      "Die Finanzierungsdaten konnten nicht übernommen werden.";

    error.textContent =
      "Bitte öffne den Finanzierungslink erneut über " +
      "deine Shopify-Bestellbestätigung.";

    error.hidden = false;
    return;
  }

  const amount = Number(amountRaw);
  const orderNumber = orderRaw.trim();

  document.getElementById("sessionID").value =
    orderNumber;

  document.getElementById("documentno").value =
    orderNumber;

  document.getElementById("amount").value =
    amount.toFixed(2);

  document.getElementById("targo-order-display").textContent =
    orderNumber;

  document.getElementById("targo-amount-display").textContent =
    new Intl.NumberFormat("de-DE", {
      style: "currency",
      currency: "EUR"
    }).format(amount);

  // Finanzierungslaufzeit übernehmen
  const term = Number(termRaw);

  const validTerm =
    termRaw !== null &&
    /^\d+$/.test(termRaw) &&
    Number.isInteger(term) &&
    term >= 6 &&
    term <= 60;

  if (validTerm) {

    document.getElementById("targo-term-display").textContent =
      term + " Monate";

    document.getElementById("targo-term-row").hidden = false;

    // Laufzeit an die TARGOBANK übergeben
    const delayField = document.getElementById("targo-delay");

    delayField.value = String(term);
    delayField.disabled = false;
  }

  details.hidden = false;

  // Automatische Weiterleitung aktiviert
  const testmodus = false;

  if (testmodus) {

    status.textContent =
      "Deine Finanzierungsdaten wurden vorbereitet.";

    hint.textContent =
      "Testmodus: Die automatische Bankweiterleitung ist deaktiviert.";

    hint.hidden = false;
    return;
  }

  status.textContent =
    "Du wirst jetzt automatisch zur TARGOBANK weitergeleitet.";

  loader.hidden = false;

  window.setTimeout(function () {
    form.submit();
  }, 700);

});
</script>
