<style>
  #shopify-section-{{ section.id }} .button-checkout { background:#080808!important;color:#fff!important;border-color:#080808!important;width:100%;min-height:54px;font-size:15px;font-weight:700;letter-spacing:.015em; }
  #shopify-section-{{ section.id }} .button-checkout:hover {background:#252525!important;border-color:#252525!important;}
  #shopify-section-{{ section.id }} .ms-cart-summary {border-top:1px solid rgba(0,0,0,.12);padding-top:20px;}
  #shopify-section-{{ section.id }} .ms-cart-summary__heading {font-size:13px;font-weight:750;letter-spacing:.055em;margin-bottom:14px;}
  #shopify-section-{{ section.id }} .ms-cart-discount {margin-bottom:20px;}
  #shopify-section-{{ section.id }} .ms-cart-discount__row {display:flex;gap:8px;align-items:stretch;}
  #shopify-section-{{ section.id }} .ms-cart-discount__input {min-width:0;flex:1;border:1px solid #ccc;border-radius:3px;padding:12px;font-size:14px;background:#fff;color:#111;}
  #shopify-section-{{ section.id }} .ms-cart-discount__apply {background:#111;color:#fff;border:1px solid #111;border-radius:3px;padding:0 16px;font-size:13px;font-weight:650;cursor:pointer;}
  #shopify-section-{{ section.id }} .ms-cart-discount__apply:disabled {opacity:.55;cursor:wait;}
  #shopify-section-{{ section.id }} .ms-cart-discount__message {font-size:12px;margin-top:8px;line-height:1.4;}
  #shopify-section-{{ section.id }} .ms-cart-discount__message[data-state=error] {color:#b42318;}
  #shopify-section-{{ section.id }} .ms-cart-discount__message[data-state=success] {color:#187044;}
  #shopify-section-{{ section.id }} .ms-cart-summary__line {display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-size:14px;}
  #shopify-section-{{ section.id }} .ms-cart-summary__line strong {font-size:17px;font-weight:750;white-space:nowrap;}
  #shopify-section-{{ section.id }} .ms-cart-payments {display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:6px;margin-top:15px;}
  #shopify-section-{{ section.id }} .ms-cart-payments svg {height:23px;width:auto;max-width:55px;}
  #shopify-section-{{ section.id }} .ms-cart-payments img {display:block;height:23px;width:auto;max-width:85px;object-fit:contain;}
  #shopify-section-{{ section.id }} .ms-cart-payments__targo {border:1px solid #e2e2e2;border-radius:3px;padding:2px 5px;}
  #shopify-section-{{ section.id }} .ms-cart-checkout {margin-top:18px;}
  @media(max-width:575px){#shopify-section-{{ section.id }} .ms-cart-discount__input {font-size:16px;}#shopify-section-{{ section.id }} .ms-cart-discount__apply {padding:0 12px;}#shopify-section-{{ section.id }} .ms-cart-payments {gap:5px;}}

/* KLEINER GEWÄHRLEISTUNGSLINK */
.ms-legal-guarantee {
  width: 100%;
  margin-top: 8px;
  text-align: left;
}

.ms-legal-guarantee__link {
  display: inline-block;
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  color: #777;
  font-size: 10px;
  font-weight: 400;
  line-height: 1.5;
  text-decoration: underline;
  text-underline-offset: 2px;
  cursor: pointer;
}

.ms-legal-guarantee__link:hover {
  color: #111;
}

/* LIGHTBOX */
.ms-legal-lightbox {
  position: fixed;
  inset: 0;
  width: min(92vw, 720px);
  max-width: 720px;
  max-height: 92dvh;
  margin: auto;
  padding: 45px 20px 20px;
  border: 0;
  border-radius: 6px;
  background: #fff;
  color: #111;
  overflow: auto;
  box-shadow: 0 20px 80px rgba(0,0,0,.25);
}

.ms-legal-lightbox[open] {
  display: block;
}

.ms-legal-lightbox::backdrop {
  background: rgba(0,0,0,.78);
}

.ms-legal-lightbox__close {
  position: absolute;
  top: 10px;
  right: 12px;
  width: 36px;
  height: 36px;
  border: 0;
  border-radius: 4px;
  background: #111;
  color: #fff;
  font-size: 29px;
  line-height: 1;
  cursor: pointer;
  z-index: 2;
}

.ms-legal-lightbox__close:hover {
  background: #444;
}

.ms-legal-lightbox__content {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  width: 100%;
}

.ms-legal-lightbox__content img {
  display: block;
  width: auto;
  max-width: 100%;
  height: auto;
  max-height: calc(92dvh - 75px);
  object-fit: contain;
  margin: 0 auto;
}

/* MOBILE */
@media (max-width: 749px) {
  .ms-legal-lightbox {
    width: 96vw;
    max-width: 96vw;
    max-height: 94dvh;
    padding: 48px 12px 12px;
    border-radius: 4px;
  }

  .ms-legal-lightbox__content img {
    max-height: calc(94dvh - 65px);
  }
}

/* MOTIONSPORTS: PAYMENT ICONS MOBIL EINZEILIG */
@media (max-width: 749px) {

  #shopify-section-{{ section.id }} .ms-cart-payments {
    display: flex !important;
    flex-wrap: nowrap !important;
    justify-content: space-between !important;
    align-items: center !important;
    gap: 3px !important;
    width: 100%;
    margin-top: 15px;
  }

  #shopify-section-{{ section.id }} .ms-cart-payments svg,
  #shopify-section-{{ section.id }} .ms-cart-payments img {
    display: block;
    width: auto !important;
    height: 17px !important;
    max-width: 100% !important;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .ms-cart-payments__targo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1px 2px !important;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .ms-cart-payments > svg {
    flex-shrink: 1;
    min-width: 0;
  }
}

/* Gewährleistungshinweis mobil zentrieren */
  .ms-legal-guarantee {
    text-align: center !important;
  }

  
/* ==========================================
   MOTIONSPORTS CART DRAWER
   MOBILE COMPACT LAYOUT
   ========================================== */

@media (max-width: 749px) {

  /* 1. Oberen Leerraum reduzieren */
  #cart-modal .modal-header {
    padding-top: 8px !important;
    padding-bottom: 10px !important;
  }

  #cart-modal .modal-header h2 {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  /* 2. Überschriften ausblenden */
  #cart-modal .ms-cart-summary__heading {
    display: none !important;
  }

  /* 3. Bestellübersicht kompakter */
  #cart-modal .ms-cart-summary {
    padding-top: 10px !important;
    padding-bottom: 8px !important;
  }

  /* 4. Rabattcode-Abstände reduzieren */
  #cart-modal .ms-cart-discount {
    margin-top: 0 !important;
    margin-bottom: 12px !important;
  }

  #cart-modal .ms-cart-discount__input {
    padding: 9px 11px !important;
    min-height: 40px !important;
    font-size: 14px !important;
  }

  #cart-modal .ms-cart-discount__apply {
    padding: 0 12px !important;
    min-height: 40px !important;
    font-size: 12px !important;
  }

  /* 5. Gesamtpreis kompakter */
  #cart-modal .ms-cart-summary__line {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    font-size: 13px !important;
  }

  #cart-modal .ms-cart-summary__line strong {
    font-size: 16px !important;
  }

  /* 6. Checkout-Button verkleinern */
  #cart-modal .ms-cart-checkout {
    margin-top: 10px !important;
  }

  #cart-modal .button-checkout {
    min-height: 44px !important;
    padding: 10px 15px !important;
    font-size: 13px !important;
    line-height: 1.2 !important;
  }

  /* 7. Payments dichter an Checkout */
  #cart-modal .ms-cart-payments {
    margin-top: 9px !important;
    margin-bottom: 0 !important;
  }

  /* 8. Gewährleistungslink kompakter */
  #cart-modal .ms-legal-guarantee {
    margin-top: 5px !important;
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
    text-align: center !important;
  }

  #cart-modal .ms-legal-guarantee__link {
    font-size: 10px !important;
    line-height: 1.2 !important;
  }

  /* 9. Unteren Leerraum reduzieren */
  #cart-modal cart-form > .flex.flex-col.h-full {
    padding-bottom: 0 !important;
  }

  /* 10. Artikelliste bekommt verfügbaren Platz */
  #cart-modal #CartModal-ScrollBody {
    min-height: 0 !important;
    flex: 1 1 auto !important;
    padding-bottom: 8px !important;
    overflow-y: auto !important;
    -webkit-overflow-scrolling: touch;
  }

}
/* MOTIONSPORTS – Überschriften auf allen Geräten ausblenden */
#cart-modal .ms-cart-summary__heading {
  display: none !important;
}

</style>

<cart-modal position="right" class="modal modal-drawer modal-drawer--right cart-modal" id="cart-modal">
  <div class="h-full" slot="content" tabindex="-1">
    {% if cart != empty %}
      <cart-form>
        <div class="flex flex-col h-full">
          <div
            class="flex flex-col grow pb-6 overflow-y-auto"
            id="CartModal-ScrollBody"
            data-preserve-scroll
          >
            <div class="modal-header px-[--cart-modal-px]">
              <div class="flex items-center">
                <h2 class="h4">
                  {{ 'sections.cart.title' | t }}
                </h2>

                <button
                  class="modal-close ml-auto relative -right-2"
                  data-button-close
                  aria-label="{{ 'accessibility.close_modal' | t }}"
                >
                  {% render 'icon-times' %}
                </button>
              </div>

              <div class="xbfsbu-cart-shipping">
    <div class="xbfsbu-block" data-id="26e688654070455e9564dd33e20790d4"></div>
  </div>

              {% render 'free-shipping-indicator', class: 'mt-4' %}
            </div>

            <div class="">
              {% for item in cart.items %}
                {% assign index = item.index | plus: 1 %}
                {% render 'cart-modal-item',
                  item: item,
                  class: 'pt-6 px-[--cart-modal-px] mb-6 first:border-t-0 border-t border-separator',
                  index: index
                %}
              {% endfor %}
            </div>

            {% render 'cart-modal-product-recommendations' %}
          </div>
          <div class="ms-cart-summary px-[--cart-modal-px] pb-6 sm:pb-8">
            {% if section.settings.ms_show_discount %}
              <div class="ms-cart-discount">
                <div class="ms-cart-summary__heading">RABATTCODE</div>
                <form class="ms-cart-discount__form" data-ms-discount-form>
                  <div class="ms-cart-discount__row">
                    <input class="ms-cart-discount__input" name="discount" type="text" autocomplete="off" placeholder="Rabattcode eingeben" aria-label="Rabattcode" required>
                    <button class="ms-cart-discount__apply" type="submit">Anwenden</button>
                  </div>
                  <p class="ms-cart-discount__message" data-ms-discount-message role="status" aria-live="polite" hidden></p>
                </form>
              </div>
            {% endif %}

            <div class="ms-cart-summary__heading">BESTELLÜBERSICHT</div>
            <div class="ms-cart-summary__line">
              <span>{{ 'sections.cart.total' | t }}</span>
              <strong class="cart-total">{{ cart.total_price | money_with_currency }}</strong>
            </div>
            {% if cart.cart_level_discount_applications.size > 0 %}
              {% for discount in cart.cart_level_discount_applications %}
                <div class="ms-cart-summary__line" style="margin-top:10px;color:#187044;">
                  <span>{{ discount.title | escape }}</span>
                  <span>-{{ discount.total_allocated_amount | money }}</span>
                </div>
              {% endfor %}
            {% endif %}
            {% if section.settings.show_tax_and_shipping_message %}
              <div class="text-xs md:text-sm text-foreground/75 mt-3">{% render 'cart-policy-text' %}</div>
            {% endif %}
            {% if section.settings.show_cart_note or section.settings.show_shipping_estimator %}
              <div class="flex flex-wrap gap-x-6 gap-y-4 my-4 md:my-6">
                {% if section.settings.show_cart_note %}
                  <modal-trigger class="contents" target="#cart-modal-add-order-note">
                    <button type="button" class="flex gap-3 text-xs md:text-sm hover:underline underline-offset-4">
                      <div class="icon-xs md:icon-sm">{% render 'icon-pencil' %}</div>
                      <span class="order-note-button-label">{% if cart.note != blank %}{{ 'sections.cart.edit_note' | t }}{% else %}{{ 'sections.cart.add_note' | t }}{% endif %}</span>
                    </button>
                  </modal-trigger>
                {% endif %}
                {% if section.settings.show_shipping_estimator %}
                  <modal-trigger class="contents" target="#cart-modal-estimate-shipping">
                    <button type="button" class="flex gap-3 text-xs md:text-sm hover:underline underline-offset-4">
                      <div class="icon-xs md:icon-sm">{% render 'icon-truck' %}</div>
                      <span>{{ 'sections.cart.estimate_shipping' | t }}</span>
                    </button>
                  </modal-trigger>
                {% endif %}
              </div>
            {% endif %}
            <div class="ms-cart-checkout">
              {% form 'cart', cart, data-form-button-loading: true %}
                
<button type="submit" name="checkout" class="button button-primary button-checkout">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    style="display:inline-block;vertical-align:middle;margin-right:9px;"
  >
    <path d="M5 8h14l1 13H4L5 8Z"/>
    <path d="M9 9V6a3 3 0 0 1 6 0v3"/>
  </svg>
  <span style="vertical-align:middle;">
    {{ 'sections.cart.checkout' | t }}
  </span>
</button>

              {% endform %}
            </div>
            
{% if section.settings.ms_show_payments %}
  <div class="ms-cart-payments" aria-label="Akzeptierte Zahlungsarten">

    <!-- TARGOBANK -->
    <span class="ms-cart-payments__targo">
      <img
        src="https://cdn.shopify.com/s/files/1/0823/4896/6217/files/targo-mini.jpg?v=1769417895"
        alt="TARGOBANK"
        width="38"
        height="24"
        loading="lazy"
      >
    </span>

    <!-- Festgelegte Zahlungsarten -->
    {% assign ms_payment_types = 'visa,master,american_express,maestro,apple_pay,google_pay,klarna,paypal' | split: ',' %}

    {% for type in ms_payment_types %}
      {{ type | payment_type_svg_tag: class: 'ms-cart-payment-icon' }}
    {% endfor %}

  </div>
{% endif %}

<!-- GESETZLICHE GEWÄHRLEISTUNG -->
<div class="ms-legal-guarantee">
  <button
    type="button"
    class="ms-legal-guarantee__link"
    onclick="document.getElementById('ms-legal-lightbox').showModal()"
  >
    Deine gesetzliche Gewährleistung
  </button>
</div>

<dialog id="ms-legal-lightbox" class="ms-legal-lightbox" aria-label="Ihre gesetzliche Gewährleistung">
  <button
    type="button"
    class="ms-legal-lightbox__close"
    aria-label="Schließen"
    onclick="document.getElementById('ms-legal-lightbox').close()"
  >
    &times;
  </button>

  <div class="ms-legal-lightbox__content">
    <img
      src="https://cdn.shopify.com/s/files/1/0823/4896/6217/files/Legal_guarantee_notice_DE.webp?v=1792409318"
      alt="Informationen zur gesetzlichen Gewährleistung"
      loading="lazy"
      width="595"
      height="842"
    >
  </div>
</dialog>

            {% render 'ms-marketing-objection-notice' %}
          </div>
        </div>
      </cart-form>

      <order-note-drawer
        class="modal modal--absolute modal-drawer modal-drawer--bottom cart-modal-child"
        position="bottom"
        id="cart-modal-add-order-note"
        animation="fade-in"
      >
        <div slot="content" tabindex="-1" class="px-8 md:px-12 py-8 md:py-10">
          <div class="flex justify-between items-center mb-6 md:mb-8">
            <div class="h5">{{ 'sections.cart.note' | t }}</div>
            <button class="modal-close" data-button-close aria-label="{{ 'accessibility.close_modal' | t }}">
              {% render 'icon-times' %}
            </button>
          </div>
          <form data-form-button-loading>
            <div class="form-floating">
              <textarea
                class="input"
                name="note"
                id="CartModal-Note"
                placeholder="{{ 'sections.cart.note' | t }}"
                rows="4"
              >{{ cart.note }}</textarea>
              <label for="CartModal-Note">{{ 'sections.cart.note' | t }}</label>
            </div>
            <button type="submit" class="button w-full mt-6 md:mt-8">
              {{ 'sections.cart.save_note_button' | t }}
            </button>
            <div class="message message-danger text-danger mt-6 hidden">
              {{ 'sections.cart.save_note_failed' | t }}
            </div>
          </form>
        </div>
      </order-note-drawer>

      <modal-drawer
        class="modal modal--absolute modal-drawer modal-drawer--bottom cart-modal-child"
        position="bottom"
        id="cart-modal-estimate-shipping"
        animation="fade-in"
      >
        <div slot="content" tabindex="-1" class="p-8 md:p-12">
          <div class="flex justify-between items-center mb-6 md:mb-8">
            <div class="heading text-lg md:text-h5">
              {{ 'sections.shipping_estimator.title' | t }}
            </div>
            <button class="modal-close" data-button-close aria-label="{{ 'accessibility.close_modal' | t }}">
              {% render 'icon-times' %}
            </button>
          </div>

          {% render 'shipping-estimator' %}
        </div>
      </modal-drawer>
    {% else %}
      <button
        class="modal-close absolute right-6 top-6 md:right-8 md:top-8"
        data-button-close
        aria-label="{{ 'accessibility.close_modal' | t }}"
      >
        {% render 'icon-times' %}
      </button>

      <div class="text-center h-full flex flex-col items-center justify-center">
        <p class="text-h4">{{ 'sections.cart.empty' | t }}</p>
        <a class="button button-primary mt-8" href="{{ settings.cart_empty_button_link }}">
          {{ 'general.continue_shopping' | t }}
        </a>
      </div>
    {% endif %}
  </div>
</cart-modal>

{% schema %}
{
  "name": "t:sections.cart-modal.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_tax_and_shipping_message",
      "label": "t:sections.cart-modal.settings.show_tax_and_shipping_message.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "t:sections.cart-modal.settings.show_cart_note.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping_estimator",
      "label": "t:sections.cart-modal.settings.show_shipping_estimator.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_cart_button",
      "label": "t:sections.cart-modal.settings.show_view_cart_button.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_checkout_button",
      "label": "t:sections.cart-modal.settings.show_checkout_button.label",
      "default": true
    },
    {
      "type": "header",
      "content": "MotionSports Checkout"
    },
    {
      "type": "checkbox",
      "id": "ms_show_discount",
      "label": "Rabattcode im Drawer anzeigen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "ms_show_payments",
      "label": "Zahlungslogos anzeigen",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "ms_targo_logo",
      "label": "TARGOBANK-Logo (falls nicht automatisch enthalten)"
    },
    {
      "type": "header",
      "content": "t:sections.cart-modal.headers.product_recommendations"
    },
    {
      "type": "text",
      "id": "product_recommendations_heading",
      "label": "t:sections.cart-modal.settings.product_recommendations_heading.label",
      "default": "You may also like"
    },
    {
      "type": "product_list",
      "id": "product_recommendations",
      "label": "t:sections.cart-modal.settings.product_recommendations.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.button_colors"
    },
    {
      "type": "color",
      "id": "view_cart_background_color",
      "label": "t:sections.cart-modal.settings.view_cart_background_color.label"
    },
    {
      "type": "color",
      "id": "view_cart_text_color",
      "label": "t:sections.cart-modal.settings.view_cart_text_color.label"
    },
    {
      "type": "color",
      "id": "checkout_background_color",
      "label": "t:sections.cart-modal.settings.checkout_background_color.label"
    },
    {
      "type": "color",
      "id": "checkout_text_color",
      "label": "t:sections.cart-modal.settings.checkout_text_color.label"
    }
  ]
}
{% endschema %}