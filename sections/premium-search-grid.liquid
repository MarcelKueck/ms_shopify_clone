</premium-search-grid-v2>
<script>
(function(){
class PremiumSearchGridV2 extends HTMLElement {
connectedCallback(){
  if (this._fhInitialized) return;
  this._fhInitialized = true;
  // Filters default to collapsed on mobile, expanded on desktop.
  // Preserve user interaction when the viewport changes.
  const filterDetails = this.querySelector('.ai-{{ ai_gen_id }}__filters-details');
  if (filterDetails) {
    const mobileQuery = window.matchMedia('(max-width:749px)');
    const syncFilterState = () => { filterDetails.open = !mobileQuery.matches; };
    syncFilterState();
    this._fhFilterMedia = mobileQuery;
    this._fhFilterMediaHandler = syncFilterState;
    mobileQuery.addEventListener('change', syncFilterState);
  }

  this._fhRequest = null;
  this._fhSequence = 0;
  this._fhTimer = null;
  this._fhResultsCleanup = null;
  const form = this.querySelector('[data-fh-filter-form]');
  const reset = this.querySelector('[data-fh-filter-reset]');
  const buildURL = () => {
    const params = new URLSearchParams(new FormData(form));
    const clean = new URLSearchParams();
    params.forEach((value, key) => { if (String(value).trim() !== '') clean.append(key, value); });
    const url = new URL(form.action || window.location.href, window.location.origin);
    url.search = clean.toString();
    return url;
  };
  this._fhLoad = async (url, push = true) => {
    const sequence = ++this._fhSequence;
    if (this._fhRequest) this._fhRequest.abort();
    const controller = new AbortController();
    this._fhRequest = controller;
    const results = this.querySelector('.ai-{{ ai_gen_id }}__results');
    if (results) { results.classList.add('is-loading'); results.setAttribute('aria-busy','true'); }
    const status = this.querySelector('[data-fh-live-status]');
    if (status) status.textContent = 'Ergebnisse werden aktualisiert …';
    try {
      const requestURL = new URL(url);
      requestURL.searchParams.delete('page');
      requestURL.searchParams.set('section_id', this.dataset.sectionId);
      const response = await fetch(requestURL.toString(), {signal:controller.signal,credentials:'same-origin',headers:{'Accept':'text/html'},cache:'no-store'});
      if (!response.ok) throw new Error('HTTP '+response.status);
      const doc = new DOMParser().parseFromString(await response.text(),'text/html');
      const incomingRoot = doc.querySelector('premium-search-grid-v2');
      const incoming = incomingRoot && incomingRoot.querySelector('.ai-{{ ai_gen_id }}__results');
      if (!incoming) throw new Error('Suchergebnisse in Section-Antwort fehlen');
      if (sequence !== this._fhSequence) return;
      if (this._fhResultsCleanup) this._fhResultsCleanup();
      const old = this.querySelector('.ai-{{ ai_gen_id }}__results');
      if (old) old.replaceWith(incoming);
      const nextURL = new URL(url);
      nextURL.searchParams.delete('page');
      if (push) history.pushState({fhPremiumSearch:true},'',nextURL.toString());
      this._fhInitResults();
      if (status) status.textContent = '';
    } catch (error) {
      if (error.name === 'AbortError' || sequence !== this._fhSequence) return;
      console.error('[Premium Search Grid] AJAX-Filter:',error);
      if (status) status.textContent = 'Aktualisierung fehlgeschlagen. Seite wird geladen.';
      window.location.assign(url.toString());
    } finally {
      if (sequence === this._fhSequence) {
        const active = this.querySelector('.ai-{{ ai_gen_id }}__results');
        if (active) { active.classList.remove('is-loading'); active.removeAttribute('aria-busy'); }
      }
    }
  };
  if (form) {
    form.addEventListener('submit', e => {e.preventDefault();clearTimeout(this._fhTimer);this._fhLoad(buildURL());});
    form.addEventListener('change', e => {
      if (!e.target.matches('input,select')) return;
      clearTimeout(this._fhTimer);
      this._fhTimer = setTimeout(()=>this._fhLoad(buildURL()), e.target.type === 'number' ? 500 : 0);
    });
    form.addEventListener('input', e => {
      if (e.target.type !== 'number') return;
      clearTimeout(this._fhTimer);
      this._fhTimer = setTimeout(()=>this._fhLoad(buildURL()), 550);
    });
  }
  if (reset) reset.addEventListener('click', e => {
    e.preventDefault();clearTimeout(this._fhTimer);
    if (form) {
      form.querySelectorAll('input[type="radio"]').forEach(input => {input.checked = input.value === '';});
      form.querySelectorAll('input[type="number"]').forEach(input => {input.value = '';});
    }
    this._fhLoad(new URL(reset.href));
  });
  this._fhPopstate = () => {
    const url = new URL(window.location.href);
    if (form) {
      const params = url.searchParams;
      form.querySelectorAll('input[type="radio"]').forEach(input => {
        input.checked = params.get(input.name) === input.value || (!params.has(input.name) && input.value === '');
      });
      form.querySelectorAll('input[type="number"]').forEach(input => {input.value = params.get(input.name) || '';});
    }
    this._fhLoad(url,false);
  };
  window.addEventListener('popstate',this._fhPopstate);
  this._fhInitResults();
}
disconnectedCallback(){
  if (this._fhFilterMedia && this._fhFilterMediaHandler) this._fhFilterMedia.removeEventListener('change', this._fhFilterMediaHandler);
  clearTimeout(this._fhTimer);
  if(this._fhRequest) this._fhRequest.abort();
  if(this._fhResultsCleanup) this._fhResultsCleanup();
  if(this._fhPopstate) window.removeEventListener('popstate',this._fhPopstate);
  this._fhInitialized=false;
}
_fhInitResults(){
/* ============================================================
         QUICK ADD TO CART
      ============================================================ */

      const bindQuickButtons = (scope) => {
        scope.querySelectorAll('button.ai-premiumsearchv2__quick[data-id]').forEach(button => {
          if (button.dataset.quickBound === 'true') return;
          button.dataset.quickBound = 'true';

          button.addEventListener('click', async (event) => {
            event.preventDefault();
            event.stopPropagation();
            if (button.disabled) return;

            const variantId = Number(button.dataset.id);
            if (!variantId) return;

            const root = window.Shopify?.routes?.root || '/';
            button.disabled = true;
            button.setAttribute('aria-busy', 'true');

            let added = false;
            try {
              const response = await fetch(root + 'cart/add.js', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                  'Content-Type': 'application/json',
                  'Accept': 'application/json'
                },
                body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
              });
              const result = await response.json();
              if (!response.ok) {
                throw new Error(result.description || result.message || 'Produkt konnte nicht hinzugefügt werden.');
              }
              added = true;

              // Das Theme nutzt cart-modal, nicht den alten Sidebar-Handle.
              const cartModal = document.querySelector('cart-modal');
              if (!cartModal || typeof cartModal.reloadContent !== 'function' || typeof cartModal.show !== 'function') {
                throw new Error('Das Warenkorb-Modal des Themes ist nicht verfügbar.');
              }
              await cartModal.reloadContent();
              await cartModal.show();

              // Das native Theme-Ereignis für weitere Shop-Integrationen.
              document.dispatchEvent(new CustomEvent('product:added-to-cart', {
                detail: { id: String(variantId), quantity: 1 }
              }));

              // Warenkorbzähler wie in der nativen Theme-Logik aktualisieren.
              const bubble = document.getElementById('CartBubble');
              if (bubble) {
                const cartResponse = await fetch(root + 'cart.js', { credentials: 'same-origin', cache: 'no-store' });
                if (cartResponse.ok) {
                  const cart = await cartResponse.json();
                  bubble.classList.toggle('hidden', !cart.item_count);
                  bubble.textContent = cart.item_count ? String(cart.item_count) : '';
                }
              }
            } catch (error) {
              console.error('[Premium Search Grid] Quick Add:', error);
              if (added) {
                alert('Artikel wurde hinzugefügt, aber der Warenkorb konnte nicht geöffnet werden.');
              } else {
                alert(error.message || 'Produkt konnte nicht hinzugefügt werden.');
              }
            } finally {
              button.disabled = false;
              button.removeAttribute('aria-busy');
            }
          });
        });
      };
      bindQuickButtons(this);

      /* Globale Sortierung: alle gefilterten Ergebnisseiten anhand der
         Shopify-Ergebniszahl laden, danach gestaffelt sichtbar machen. */
      const grid = this.querySelector('.ai-{{ ai_gen_id }}__grid');
      const pager = this.querySelector('[data-infinite-pagination]');
      const sentinel = this.querySelector('[data-infinite-sentinel]');
      const status = this.querySelector('[data-infinite-status]');
      const retry = this.querySelector('[data-infinite-retry]');
      if (!grid || !pager || !sentinel || !status || !retry) return;

      const batchSize = Math.max(1, Number(pager.dataset.pageSize) || 24);
      const totalProducts = Math.max(0, Number(pager.dataset.totalProducts) || 0);
      const firstPageCards = Array.from(grid.querySelectorAll(':scope > [data-product-available]'));
      let allCards = [];
      let shownCount = 0;
      let observer = null;
      let cancelled = false;
      this._fhResultsCleanup = () => {cancelled = true;if(observer)observer.disconnect();};
      let preparing = false;
      let ready = false;

      const showNextBatch = () => {
        if (!ready) return;
        const end = Math.min(shownCount + batchSize, allCards.length);
        for (let i = shownCount; i < end; i++) allCards[i].hidden = false;
        shownCount = end;
        const hasMore = shownCount < allCards.length;
        status.textContent = hasMore ? '' : 'Alle Produkte angezeigt';
        retry.hidden = true;
        if (!hasMore && observer) observer.disconnect();
      };

      const prepareSearch = async () => {
        if (preparing || ready) return;
        preparing = true;
        retry.hidden = true;
        status.textContent = 'Produkte werden nach Verfügbarkeit sortiert …';
        try {
          const pageCount = Math.max(1, Number(pager.dataset.totalPages) || Math.ceil(totalProducts / batchSize));
          if (pageCount > 100) throw new Error('Search zu groß für globale Browser-Sortierung');
          const collected = firstPageCards.slice();
          const currentPage = Number(new URL(window.location.href).searchParams.get('page') || 1);
          const pages = Array.from({ length: pageCount }, (_, i) => i + 1).filter(page => page !== currentPage);

          // Jede Seite separat anfordern. Die URL übernimmt aktive Shopify-Filter.
          for (const page of pages) {
            if (cancelled) return;
            const url = new URL(window.location.href);
            url.searchParams.set('page', String(page));
            const response = await fetch(url.toString(), {
              credentials: 'same-origin',
              headers: { 'Accept': 'text/html' },
              cache: 'no-store'
            });
            if (!response.ok) throw new Error('Shopify Seite ' + page + ': HTTP ' + response.status);
            const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
            const incoming = doc.querySelector('premium-search-grid-v2 .ai-{{ ai_gen_id }}__grid')
              || doc.querySelector('.ai-{{ ai_gen_id }}__grid');
            if (!incoming) throw new Error('Produktgrid auf Seite ' + page + ' nicht gefunden');
            const cards = Array.from(incoming.querySelectorAll(':scope > [data-product-available]'));
            // Suchseiten koennen auch Nicht-Produkt-Treffer enthalten.
             // Eine Seite ohne Produktkarten ist daher erlaubt.
            collected.push(...cards);
          }

          if (cancelled) return;
          // Stable Partition: manuelle Reihenfolge innerhalb der Gruppen erhalten.
          const available = collected.filter(card => card.dataset.productAvailable === 'true');
          const unavailable = collected.filter(card => card.dataset.productAvailable !== 'true');
          allCards = available.concat(unavailable);
          const fragment = document.createDocumentFragment();
          allCards.forEach((card, index) => {
            card.hidden = index >= batchSize;
            fragment.appendChild(card);
          });
          bindQuickButtons(fragment);
          grid.replaceChildren(fragment);
          shownCount = Math.min(batchSize, allCards.length);
          ready = true;
          pager.dataset.nextUrl = '';
          status.textContent = shownCount < allCards.length ? '' : 'Alle Produkte angezeigt';
          if (shownCount < allCards.length) {
            if ('IntersectionObserver' in window) {
              observer = new IntersectionObserver(entries => {
                if (entries.some(entry => entry.isIntersecting)) showNextBatch();
              }, { rootMargin: '450px 0px' });
              observer.observe(sentinel);
            } else {
              retry.hidden = false;
              retry.textContent = 'Weitere Produkte anzeigen';
            }
          }
          console.info('[Premium Search Grid] Sortiert:', available.length, 'verfügbar,', unavailable.length, 'ausverkauft');
        } catch (error) {
          if (cancelled) return;
          console.error('[Premium Search Grid] Sortierung fehlgeschlagen:', error);
          status.textContent = 'Sortierung konnte nicht vollständig geladen werden.';
          retry.hidden = false;
          retry.textContent = 'Erneut versuchen';
        } finally {
          preparing = false;
        }
      };

      retry.addEventListener('click', () => ready ? showNextBatch() : prepareSearch());
      prepareSearch();

}
}
if(!customElements.get('premium-search-grid-v2')) customElements.define('premium-search-grid-v2',PremiumSearchGridV2);
})();
</script>
