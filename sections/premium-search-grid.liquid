{% comment %}Fruits & Harvest | Premium Search Grid | Native Shopify search{% endcomment %}
{% assign ai_gen_id = 'premiumsearchv2' %}
{% style %}
.ai-{{ ai_gen_id }}{display:block;width:100%;padding:24px;background:#F9F9F9;color:#0A0B0C;font-family:Montserrat,sans-serif;}
.ai-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat({{ section.settings.columns }},minmax(0,1fr));gap:{{ section.settings.grid_gap }}px;align-items:stretch;}
.ai-{{ ai_gen_id }}__search-header{text-align:center;padding:4px 0 30px;}
.ai-{{ ai_gen_id }}__search-header h1{font-size:32px;font-weight:400;margin:0 0 28px;}
.ai-{{ ai_gen_id }}__search-form{display:flex;max-width:576px;margin:auto;background:#f0f0f0;border-radius:4px;overflow:hidden;}
.ai-{{ ai_gen_id }}__search-form input{flex:1;min-width:0;border:0;background:transparent;padding:18px;font:inherit;color:inherit;}
.ai-{{ ai_gen_id }}__search-form button{border:0;background:transparent;padding:0 20px;cursor:pointer;}
.ai-{{ ai_gen_id }}__search-form svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:2;}
.ai-{{ ai_gen_id }}__count{font-size:14px;margin:0 0 22px;opacity:.7;}
/* ============================================================
   PRODUCT GRID
============================================================ */

.ai-{{ ai_gen_id }}__grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
  gap: {{ section.settings.grid_gap }}px;
  align-items: stretch;
}

.ai-{{ ai_gen_id }}__card {
  overflow: hidden;
  display: flex;
  flex-direction: column;
  height: 100%;
  background: {{ section.settings.card_background }};
  border-radius: {{ section.settings.card_radius }}px;
  box-shadow: 0 8px 20px #0002;
  transition: transform .2s, box-shadow .2s;
}

.ai-{{ ai_gen_id }}__card:hover {
  transform: translateY(-5px);
  box-shadow: 0 16px 30px #0003;
}

.ai-{{ ai_gen_id }}__media {
  position: relative;
  display: block;
  flex: 0 0 auto;
  aspect-ratio: 1;
  background: #f5f5f5;
}

.ai-{{ ai_gen_id }}__media img,
.ai-{{ ai_gen_id }}__media svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Badges are positioned independently within the product image. */
.ai-{{ ai_gen_id }}__badges {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
}

.ai-{{ ai_gen_id }}__badge {
  display: inline-flex;
  align-items: center;
  min-height: 26px;
  padding: 5px 9px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: .03em;
  text-transform: uppercase;
}

.ai-{{ ai_gen_id }}__badge--sale {
  position: absolute;
  top: 12px;
  right: 12px;
  background: #9A0000;
  color: #ffffff;
}

.ai-{{ ai_gen_id }}__badge--soldout {
  position: absolute;
  bottom: 12px;
  left: 12px;
  background: #eeeeee;
  color: #000000;
  font-size: 10px;
}

.ai-{{ ai_gen_id }}__content {
  display: flex;
  flex-direction: column;
  flex: 1 1 auto;
  padding: {{ section.settings.card_padding }}px;
}

.ai-{{ ai_gen_id }}__title {
  margin: 0 0 {{ section.settings.title_price_gap }}px;
  font-size: {{ section.settings.title_size }}px;
  font-weight: 300;
}

.ai-{{ ai_gen_id }}__title a {
  color: inherit;
  text-decoration: none;
}

.ai-{{ ai_gen_id }}__price {
  margin-bottom: {{ section.settings.price_rating_gap }}px;
  font-size: {{ section.settings.price_size }}px;
  font-weight: {{ section.settings.price_weight }};
}

.ai-{{ ai_gen_id }}__price s {
  margin-left: 5px;
  opacity: .55;
}

.ai-{{ ai_gen_id }}__rating {
  margin-bottom: {{ section.settings.rating_gap }}px;
  color: {{ section.settings.rating_color }};
  font-size: {{ section.settings.rating_size }}px;
}


/* ============================================================
   PRODUCT SWATCHES
============================================================ */

.ai-{{ ai_gen_id }}__product-swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  min-height: 20px;
  margin: 2px 0 12px;
}

.ai-{{ ai_gen_id }}__product-swatch {
  display: block;
  width: 20px;
  height: 20px;
  flex: 0 0 20px;
  border-radius: 50%;
  border: 2px solid #fff;
  box-shadow: 0 0 0 1px rgba(0,0,0,.22);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  cursor: pointer;
  text-decoration: none;
  transition: transform .15s ease, outline .15s ease;
}

.ai-{{ ai_gen_id }}__product-swatch:hover {
  transform: scale(1.12);
  outline: 1px solid rgba(0,0,0,.35);
  outline-offset: 2px;
}


/* ============================================================
   BUTTONS
============================================================ */

.ai-{{ ai_gen_id }}__actions {
  display: flex;
  gap: 8px;
  margin-top: auto;
  padding-top: 4px;
}

.ai-{{ ai_gen_id }}__view,
.ai-{{ ai_gen_id }}__quick {
  position: relative;
  overflow: hidden;
  border: 0;
  border-radius: {{ section.settings.button_radius }}px;
  box-shadow: none;
  font-family: {{ section.settings.button_font.family }};
  cursor: pointer;
}

.ai-{{ ai_gen_id }}__view {
  flex: 1;
  padding: {{ section.settings.button_padding }}px;
  background: {{ section.settings.button_background }};
  color: {{ section.settings.button_text }};
  text-align: center;
  text-decoration: none;
}

.ai-{{ ai_gen_id }}__quick {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  min-width: 40px;
  padding: 0;
  background: {{ section.settings.quick_background }};
  color: #fff;
}

.ai-{{ ai_gen_id }}__quick svg {
  width: 16px;
  height: 16px;
}

.ai-{{ ai_gen_id }}__view:before,
.ai-{{ ai_gen_id }}__quick:before {
  content: '';
  position: absolute;
  inset: 0 auto 0 -120%;
  width: 70%;
  background: linear-gradient(110deg,transparent,#fff8,transparent);
  transform: skewX(-20deg);
  transition: left .5s;
}

.ai-{{ ai_gen_id }}__view:hover:before,
.ai-{{ ai_gen_id }}__quick:hover:before {
  left: 140%;
}

.ai-{{ ai_gen_id }}__quick:disabled {
  opacity: .55;
  cursor: wait;
}


/* ============================================================
   PAGINATION
============================================================ */

.ai-{{ ai_gen_id }}__pagination {
  margin-top: 30px;
}



@media(max-width:749px){.ai-{{ ai_gen_id }}__grid{grid-template-columns:repeat(2,minmax(0,1fr));}}
.ai-{{ ai_gen_id }}__grid > [hidden]{display:none!important;}
.ai-{{ ai_gen_id }}__pagination{display:none;}
.ai-{{ ai_gen_id }}__infinite{display:flex;justify-content:center;align-items:center;min-height:42px;margin-top:18px;font-size:13px;}
.ai-{{ ai_gen_id }}__infinite [data-infinite-retry][hidden]{display:none!important;}

/* Editorial search and filter sidebar */
.ai-{{ ai_gen_id }}__search-header{padding:{{ section.settings.header_top_desktop }}px 0 {{ section.settings.header_bottom_desktop }}px;text-align:center}
.ai-{{ ai_gen_id }}__eyebrow{font-size:10px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#666;margin:0 0 {{ section.settings.eyebrow_gap }}px}
.ai-{{ ai_gen_id }}__search-header h1{font-size:clamp(32px,4vw,{{ section.settings.search_title_size }}px);font-weight:400;letter-spacing:-.045em;margin:0 0 {{ section.settings.heading_gap }}px}
.ai-{{ ai_gen_id }}__description{font-size:14px;color:#666;margin:0 0 {{ section.settings.description_gap }}px}
.ai-{{ ai_gen_id }}__search-form{max-width:680px;background:#fff;border:1px solid #d2d2ce;padding:5px;min-height:{{ section.settings.search_field_height }}px;border-radius:4px;align-items:stretch}
.ai-{{ ai_gen_id }}__search-form input{font-size:15px;outline:0}
.ai-{{ ai_gen_id }}__search-form button{position:relative;overflow:hidden;display:flex;align-items:center;gap:10px;background:{{ section.settings.search_button_color }};color:{{ section.settings.search_button_text_color }};padding:0 24px;border-radius:2px;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;transition:background .2s}
.ai-{{ ai_gen_id }}__search-form button:hover{background:#008CCB}
.ai-{{ ai_gen_id }}__search-form button:before{content:'';position:absolute;left:-90%;top:-50%;width:45%;height:200%;background:linear-gradient(105deg,transparent,#ffffffa0,transparent);transform:skewX(-20deg);transition:left .55s}
.ai-{{ ai_gen_id }}__search-form button:hover:before{left:140%}
.ai-{{ ai_gen_id }}__search-form svg{width:18px;height:18px}
.ai-{{ ai_gen_id }}__layout{display:grid;grid-template-columns:{{ section.settings.sidebar_width }}px minmax(0,1fr);gap:{{ section.settings.sidebar_gap }}px;align-items:start}
.ai-{{ ai_gen_id }}__results{min-width:0;transition:opacity .18s ease}
.ai-{{ ai_gen_id }}__results.is-loading{opacity:.45;pointer-events:none}
.ai-{{ ai_gen_id }}__filter-message{font-size:12px;color:#666;margin:8px 0 0;min-height:16px}
.ai-{{ ai_gen_id }}__sidebar{border:1px solid #e7e7e7;border-radius:6px;padding:22px 18px;background:#fff}
.ai-{{ ai_gen_id }}__filters-details summary{font-size:16px;font-weight:700;cursor:pointer;margin-bottom:20px}
.ai-{{ ai_gen_id }}__filter-group{border:0;border-top:1px solid #eee;margin:0;padding:20px 0}
.ai-{{ ai_gen_id }}__filter-group legend{font-weight:700;font-size:13px;padding-top:15px}
.ai-{{ ai_gen_id }}__check{display:flex;align-items:center;gap:9px;font-size:13px;margin:12px 0;cursor:pointer}
.ai-{{ ai_gen_id }}__check input{accent-color:#008CCB}
.ai-{{ ai_gen_id }}__price-fields{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.ai-{{ ai_gen_id }}__price-fields label{font-size:12px;color:#555}
.ai-{{ ai_gen_id }}__price-fields input{width:100%;min-width:0;border:1px solid #ddd;border-radius:3px;padding:10px 7px;margin-top:6px;font-size:13px}
.ai-{{ ai_gen_id }}__apply{display:block;width:100%;padding:13px 10px;border:0;background:#0A0B0C;color:white;font-size:12px;cursor:pointer}
.ai-{{ ai_gen_id }}__reset{display:block;text-align:center;font-size:12px;margin-top:14px;text-decoration:underline}
{% unless section.settings.show_filters %}.ai-{{ ai_gen_id }}__layout{grid-template-columns:minmax(0,1fr)}{% endunless %}
@media(max-width:900px){.ai-{{ ai_gen_id }}__layout{grid-template-columns:minmax(0,1fr)}.ai-{{ ai_gen_id }}__sidebar{padding:12px 16px}.ai-{{ ai_gen_id }}__filters-details:not([open]) summary{margin-bottom:0}}
@media(max-width:600px){.ai-{{ ai_gen_id }}{padding:16px}.ai-{{ ai_gen_id }}__search-header{padding:{{ section.settings.header_top_mobile }}px 0 {{ section.settings.header_bottom_mobile }}px}.ai-{{ ai_gen_id }}__search-form button{padding:0 14px}.ai-{{ ai_gen_id }}__search-form button span{display:none}}

/* Mobile search field and collapsible filters */
@media (max-width:749px) {
  .ai-{{ ai_gen_id }}__search-form { min-height:42px; height:42px; padding:3px; }
  .ai-{{ ai_gen_id }}__search-form input { padding:7px 10px; font-size:14px; min-height:0; height:100%; }
  .ai-{{ ai_gen_id }}__search-form button { padding:0 12px; min-height:0; }
  .ai-{{ ai_gen_id }}__search-form svg { width:17px; height:17px; }
  .ai-{{ ai_gen_id }}__filters-details summary { margin-bottom:0; }
  .ai-{{ ai_gen_id }}__filters-details[open] summary { margin-bottom:14px; }
}

/* Suchkopf: Ueberschrift immer normal, auch bei Theme-Overrides */
premium-search-grid-v2.ai-{{ ai_gen_id }} .ai-{{ ai_gen_id }}__search-header h1 {
  font-weight: 400 !important;
}

.ai-{{ ai_gen_id }}__title,
.ai-{{ ai_gen_id }}__title a {
  margin: 0 0 8px;
  font-size: 15px;
  font-weight: 300 !important;
}

{% endstyle %}
<premium-search-grid-v2 class="ai-{{ ai_gen_id }}" data-section-id="{{ section.id }}" {{ section.shopify_attributes }}>
<header class="ai-{{ ai_gen_id }}__search-header">
{% if section.settings.eyebrow != blank %}<p class="ai-{{ ai_gen_id }}__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
<h1>{{ section.settings.search_heading | escape }}</h1>
{% if section.settings.search_description != blank %}<p class="ai-{{ ai_gen_id }}__description">{{ section.settings.search_description | escape }}</p>{% endif %}
<form action="{{ routes.search_url }}" method="get" role="search" class="ai-{{ ai_gen_id }}__search-form">
<input type="search" name="q" value="{{ search.terms | escape }}" aria-label="Produkte suchen" placeholder="{{ section.settings.search_placeholder | escape }}" autocomplete="off">
<input type="hidden" name="type" value="product">
<input type="hidden" name="options[prefix]" value="last">
<button type="submit" aria-label="Suchen"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg><span>{{ section.settings.search_button_label | escape }}</span></button>
</form></header>
{% if search.performed %}
<div class="ai-{{ ai_gen_id }}__layout">
{% if section.settings.show_filters %}
<aside class="ai-{{ ai_gen_id }}__sidebar" aria-label="Suchfilter">
<details class="ai-{{ ai_gen_id }}__filters-details" {% comment %}Desktop open; mobile state adjusted below{% endcomment %} open>
<summary>Produkte filtern</summary>
<form action="{{ routes.search_url }}" method="get" class="ai-{{ ai_gen_id }}__filter-form" data-fh-filter-form>
<input type="hidden" name="q" value="{{ search.terms | escape }}">
<input type="hidden" name="type" value="product">
<input type="hidden" name="options[prefix]" value="last">
{% comment %}Verfügbarkeit als eigenständiger Filter, auch wenn search.filters keinen entsprechenden Eintrag liefert.{% endcomment %}
{% assign fh_availability = '' %}
{% for filter in search.filters %}
  {% if filter.param_name == 'filter.v.availability' %}
    {% for value in filter.values %}
      {% if value.active %}
        {% assign fh_availability = value.value | append: '' %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endfor %}
<fieldset class="ai-{{ ai_gen_id }}__filter-group">
  <legend>Verfügbarkeit</legend>
  <label class="ai-{{ ai_gen_id }}__check">
    <input type="radio" name="filter.v.availability" value="" {% if fh_availability == blank %}checked{% endif %}>
    <span>Alle Produkte</span>
  </label>
  <label class="ai-{{ ai_gen_id }}__check">
    <input type="radio" name="filter.v.availability" value="1" {% if fh_availability == '1' or fh_availability == 'true' %}checked{% endif %}>
    <span>Verfügbar</span>
  </label>
  <label class="ai-{{ ai_gen_id }}__check">
    <input type="radio" name="filter.v.availability" value="0" {% if fh_availability == '0' or fh_availability == 'false' %}checked{% endif %}>
    <span>Nicht verfügbar</span>
  </label>
</fieldset>
{% for filter in search.filters %}
{% if filter.type == 'price_range' %}
<fieldset class="ai-{{ ai_gen_id }}__filter-group"><legend>Preis</legend>
<div class="ai-{{ ai_gen_id }}__price-fields">
<label>Von (€)<input type="number" min="0" step="0.01" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100.0 }}{% endif %}" placeholder="0"></label>
<label>Bis (€)<input type="number" min="0" step="0.01" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100.0 }}{% endif %}" placeholder="{{ filter.range_max | money_without_currency }}"></label>
</div>
</fieldset>
{% endif %}
{% endfor %}

<a class="ai-{{ ai_gen_id }}__reset" data-fh-filter-reset href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product&options%5Bprefix%5D=last">Filter zurücksetzen</a>
<p class="ai-{{ ai_gen_id }}__filter-message" data-fh-live-status aria-live="polite"></p>
</form>
</details>
</aside>
{% endif %}
<div class="ai-{{ ai_gen_id }}__results">
<p class="ai-{{ ai_gen_id }}__count">Suchergebnisse für „{{ search.terms | escape }}“</p>
{% paginate search.results by section.settings.products_per_page %}
<div class="ai-{{ ai_gen_id }}__grid">
{% assign availability_passes = 'available,unavailable' | split: ',' %}
{% for availability_pass in availability_passes %}
{% for item in search.results %}
{% unless item.object_type == 'product' %}{% continue %}{% endunless %}
{% assign product = item %}
{% if availability_pass == 'available' %}
{% unless product.available %}{% continue %}{% endunless %}
{% else %}
{% if product.available %}{% continue %}{% endif %}
{% endif %}
<article class="ai-{{ ai_gen_id }}__card" data-product-available="{{ product.available }}">


<a
  class="ai-{{ ai_gen_id }}__media"
  href="{{ product.url }}"
>

{% comment %}
  Rabatt der Haupt-/Preisvariante: Die Variante mit dem Preis,
  der unten in der Produktkarte als product.price ausgegeben wird.
{% endcomment %}
{% assign card_variant = blank %}
{% for variant in product.variants %}
  {% if variant.price == product.price %}
    {% assign card_variant = variant %}
    {% break %}
  {% endif %}
{% endfor %}

{% assign card_saving = 0 %}
{% if card_variant != blank and card_variant.compare_at_price != blank %}
  {% if card_variant.compare_at_price > card_variant.price %}
    {% assign card_saving = card_variant.compare_at_price | minus: card_variant.price %}
  {% endif %}
{% endif %}

<div class="ai-{{ ai_gen_id }}__badges">
  {% if card_saving > 0 %}
    <span class="ai-{{ ai_gen_id }}__badge ai-{{ ai_gen_id }}__badge--sale">%</span>
  {% endif %}
  {% unless product.available %}
    <span class="ai-{{ ai_gen_id }}__badge ai-{{ ai_gen_id }}__badge--soldout">SOLD OUT</span>
  {% endunless %}
</div>

{% if product.featured_image %}

<img
  src="{{ product.featured_image | image_url: width: 800 }}"
  alt="{{ product.featured_image.alt | default: product.title | escape }}"
  width="800"
  height="{{ 800 | divided_by: product.featured_image.aspect_ratio | round }}"
  loading="lazy"
>

{% else %}

{{ 'product-apparel-1' | placeholder_svg_tag }}

{% endif %}

</a>


<div class="ai-{{ ai_gen_id }}__content">


<h2 class="ai-{{ ai_gen_id }}__title">

<a href="{{ product.url }}">
  {{ product.title }}
</a>

</h2>


<div class="ai-{{ ai_gen_id }}__price">

{{ product.price | money }}

{% if card_saving > 0 %}

<s>
  {{ card_variant.compare_at_price | money }}
</s>

{% endif %}

</div>


{% assign rating = product.metafields.loox.avg_rating.value
  | default: product.metafields.loox.rating.value
%}

{% assign reviews = product.metafields.loox.num_reviews.value
  | default: product.metafields.loox.review_count.value
%}


<div class="ai-{{ ai_gen_id }}__rating">

{% if rating != blank %}

★★★★★

{% if reviews != blank %}
  ({{ reviews }})
{% endif %}

{% else %}

☆☆☆☆☆

{% endif %}

</div>


<!-- ============================================================
     PRODUCT SWATCHES
============================================================ -->

{% assign color_option = blank %}

{% for option in product.options_with_values %}

  {% assign option_name_downcase = option.name | downcase | strip %}

  {% if option_name_downcase == 'farbe'
    or option_name_downcase == 'color'
    or option_name_downcase == 'colour'
  %}

    {% assign color_option = option %}
    {% break %}

  {% endif %}

{% endfor %}


{% if color_option != blank %}

<div class="ai-{{ ai_gen_id }}__product-swatches">

{% assign color_index = color_option.position | minus: 1 %}

{% for option_value in color_option.values %}

  {% assign swatch_name = option_value.name | downcase | strip %}
  {% assign swatch_variant = blank %}

  {% for variant in product.variants %}

    {% if variant.options[color_index] == option_value.name %}

      {% assign swatch_variant = variant %}
      {% break %}

    {% endif %}

  {% endfor %}


  <a
    class="ai-{{ ai_gen_id }}__product-swatch"
    href="{% if swatch_variant != blank %}{{ product.url | split: '?' | first }}?variant={{ swatch_variant.id }}{% else %}{{ product.url }}{% endif %}"
    title="{{ option_value.name | escape }}"
    aria-label="{{ option_value.name | escape }}"

    {% if option_value.swatch.image %}

      style="background-image:url('{{ option_value.swatch.image | image_url: width: 60 }}');"

    {% elsif option_value.swatch.color %}

      style="background-color:{{ option_value.swatch.color }};"

    {% else %}

      {% case swatch_name %}

        {% when 'weiß (kl01)' %}style="background:#EEEEEE;"
        {% when 'perle (kl34)' %}style="background:#D6D7D1;"
        {% when 'sand (kl36)' %}style="background:#D9D1BA;"
        {% when 'apricot (kl11)' %}style="background:#F4B575;"
        {% when 'safran (kl06)' %}style="background:#F8AD4C;"
        {% when 'rost (kl30)' %}style="background:#C05742;"
        {% when 'kirsche (kl35)' %}style="background:#B63A42;"
        {% when 'cyclam (kl04)' %}style="background:#944671;"
        {% when 'orchidee (kl03)' %}style="background:#5E4668;"
        {% when 'sky (kl33)' %}style="background:#607A93;"
        {% when 'atoll (kl27)' %}style="background:#24558D;"
        {% when 'royal (kl13)' %}style="background:#324260;"
        {% when 'aqua (kl32)' %}style="background:#6EC5B6;"
        {% when 'basalt' %}style="background:#817260;"
        {% when 'aubergine' %}style="background:#565057;"
        {% when 'misty mountain' %}style="background:#485F77;"
        {% when 'smaragd (kl07)' %}style="background:#008B63;"
        {% when 'limone (kl28)' %}style="background:#A3BE63;"
        {% when 'apfel (kl08)' %}style="background:#79C14F;"
        {% when 'chrom (kl05)' %}style="background:#807F7F;"
        {% when 'anthrazit (kl29)' %}style="background:#4D565A;"
        {% when 'schwarz (kl02)' %}style="background:#3E4043;"

        {% when 'birke (tor01)' %}style="background:#A29C8F;"
        {% when 'mocca (tor02)' %}style="background:#5A4831;"
        {% when 'olive (tor03)' %}style="background:#7D8645;"
        {% when 'limone (tor04)' %}style="background:#9CAE19;"
        {% when 'corn (tor05)' %}style="background:#DDB01E;"
        {% when 'orange (tor06)' %}style="background:#DA9621;"
        {% when 'stone blue (tor07)' %}style="background:#7A8793;"
        {% when 'slate grey (tor08)' %}style="background:#696D6C;"
        {% when 'anthrazit (tor09)' %}style="background:#4B5051;"
        {% when 'schwarz (tor10)' %}style="background:#2C2E2D;"
