e,"use_original_media_size":false,"autoplay":true,"speed":5,"height":700,"controls":"arrows","background_animation":"ZoomOut","content_animation":"AppearLineByLine","background_color":"#262626"}},"featured_collection_hzmn37":{"type":"featured-collection","settings":{"full_width":true,"carousel":true,"products_count":20,"grid_columns":5,"grid_columns_mobile":"2","products":["atx®-trinity-tower-latzugstation-3-in-1","atx®-power-rack-prx-780","concept2-skierg-skitrainer","concept2-rowerg-rudergerat","atx®-beinpresse-hackenschmidt-combo-4inone","atx®-cable-crossover-kabelzugstation","atx®-resistance-power-sled","atx®-hyperextension-ruckentrainer","vision-fitness-u60-fahrradergometer","vision-fitness-t600-laufband","vision-fitness-r60-liegefahrrad","vision-fitness-s600e-crosstrainer","abdominal-lower-back-machine-stack-weight-vision-fitness","abduktoren-adduktoren-maschine-stack-weight-vision-fitness","beinbeuger-liegend-stack-weight-vision-fitness","bench-press-olympic-vision-fitness","brustpresse-stack-weight-vision-fitness","butterfly-reverse-stack-weight-machine-vision-fitness","hip-thruster-machine-plate-load-vision-fitness","leg-extension-curl-machine-stack-weight-vision-fitness","leg-press-stack-weight-vision-fitness","shoulder-press-stack-weight-vision-fitness","wadenmaschine-sitzend-plate-load-vision-fitness"],"collection":"","subheading":"Lass dich von der qualität live inspirieren","heading":"Teste unsere Top-Geräte live im Showroom","heading_size":"h2","text_alignment":"text-center","link_text":"alle ansehen","link_url":"","background_color":"#f9f9f9","text_color":"","heading_color":"","heading_html_tag":"p"}},"custom_liquid_jDpfwb":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"full_width":true,"remove_horizontal_space":false,"remove_vertical_space":false,"custom_liquid":"<section id=\"ms-showroom\">\n  <style>\n    \/* Layout-Basics *\/\n    #ms-showroom .ms-section{padding:60px 20px}\n    #ms-showroom .ms-container{max-width:1100px;margin:0 auto}\n    #ms-showroom .ms-h2{margin:0 0 20px 0 !important;padding:0 !important;font-weight:700;font-size:28px;line-height:1.2}\n\n    \/* Ablauf-Liste *\/\n    #ms-showroom .ms-steps{margin:0;padding:0;list-style:none;display:grid;gap:14px}\n    #ms-showroom .ms-step{display:flex;align-items:flex-start;gap:12px}\n    #ms-showroom .ms-step svg{flex:0 0 22px;margin-top:2px}\n\n    \/* ---------- Animations ---------- *\/\n    @media (prefers-reduced-motion: no-preference){\n      #ms-showroom .reveal{opacity:0;transform:translateY(12px);will-change:opacity,transform;transition:opacity .5s ease, transform .6s cubic-bezier(.22,.61,.36,1)}\n      #ms-showroom .reveal.fade-in{transform:none}\n      #ms-showroom .reveal.is-visible{opacity:1;transform:none}\n      \/* kleine Staffelung für Gruppen (Ablauf-Items) *\/\n      #ms-showroom .stagger > *{opacity:0;transform:translateY(12px);transition:opacity .45s ease, transform .55s ease}\n      #ms-showroom .stagger.is-visible > *{opacity:1;transform:none}\n      #ms-showroom .stagger.is-visible > *:nth-child(1){transition-delay:.05s}\n      #ms-showroom .stagger.is-visible > *:nth-child(2){transition-delay:.12s}\n      #ms-showroom .stagger.is-visible > *:nth-child(3){transition-delay:.19s}\n      #ms-showroom .stagger.is-visible > *:nth-child(4){transition-delay:.26s}\n      #ms-showroom .stagger.is-visible > *:nth-child(5){transition-delay:.33s}\n    }\n  <\/style>\n\n  <!-- HERO -->\n  <div class=\"ms-section\">\n    <div class=\"ms-container\">\n      <p class=\"reveal fade-in\" style=\"background:#f3f4f6; display:inline-block; padding:6px 12px; border-radius:999px; font-size:14px; margin-bottom:16px;\">Showroom München\/Gröbenzell<\/p>\n      <h1 class=\"reveal\" style=\"font-size:36px; font-weight:700; margin-bottom:20px;\">Fitnessgeräte live testen & die perfekte Lösung für dein Gym finden<\/h1>\n      <p class=\"reveal\" style=\"font-size:18px; max-width:720px;\">Im motion sports Showroom erlebst du ausgewählte Geräte aus unserem Sortiment – vom Home Gym bis zum professionellen Studio. Teste Equipment, spüre Qualität und lass dich von unserem Team persönlich beraten.<\/p>\n\n      <ul class=\"reveal fade-in\" style=\"display:flex; flex-wrap:wrap; gap:12px; margin-top:20px; padding:0; list-style:none;\">\n        <li style=\"padding:8px 12px; border:1px solid #e5e7eb; border-radius:999px; background:#fff;\">Persönliche 1:1‑Beratung<\/li>\n        <li style=\"padding:8px 12px; border:1px solid #e5e7eb; border-radius:999px; background:#fff;\">Geräte live testen<\/li>\n        <li style=\"padding:8px 12px; border:1px solid #e5e7eb; border-radius:999px; background:#fff;\">Termin nach Vereinbarung<\/li>\n        <li style=\"padding:8px 12px; border:1px solid #e5e7eb; border-radius:999px; background:#fff;\">Mo–Fr 09–18 Uhr<\/li>\n      <\/ul>\n\n      <div class=\"reveal fade-in\" style=\"margin-top:30px;\">\n        <a href=\"#termin\" style=\"display:inline-block; background:#111827; color:#fff; padding:14px 24px; border-radius:12px; text-decoration:none; font-weight:600; margin-right:12px;\">Termin anfragen<\/a>\n        <a href=\"#anreise\" style=\"display:inline-block; border:1px solid #111827; color:#111827; padding:14px 24px; border-radius:12px; text-decoration:none; font-weight:600;\">Anreise & Kontakt<\/a>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- ABLAUF -->\n  <div class=\"ms-section\" style=\"background:#f9fafb;\">\n    <div class=\"ms-container\">\n      <h2 class=\"ms-h2 reveal\">Ablauf deines Showroom-Termins<\/h2>\n\n      <!-- Stagger-Container sorgt für versetztes Einblenden der Schritte -->\n      <ul class=\"ms-steps stagger\">\n        <li class=\"ms-step\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#111827\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n            <path d=\"M12 22a10 10 0 1 1 10-10\"><\/path><path d=\"M22 12a10 10 0 0 1-10 10\"><\/path><circle cx=\"12\" cy=\"12\" r=\"2\"><\/circle><path d=\"M22 2 12 12\"><\/path>\n          <\/svg>\n          <div>\n            <strong>Ziele & Bedarf klären<\/strong><br>\n            Sag uns kurz, wofür du planst (Home Gym, Studio, Praxis) und welches Budget du hast.\n          <\/div>\n        <\/li>\n        <li class=\"ms-step\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#111827\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n            <path d=\"M21 16v-8a2 2 0 0 0-2-2h-5l-2-2H5a2 2 0 0 0-2 2v12\"><\/path><rect x=\"3\" y=\"8\" width=\"18\" height=\"13\" rx=\"2\"><\/rect><path d=\"m9 13 2 2 4-4\"><\/path>\n          <\/svg>\n          <div>\n            <strong>Geräte für dich bereitstellen<\/strong><br>\n            Wir stellen passende Modelle zusammen, damit du sie vor Ort direkt testen kannst.\n          <\/div>\n        <\/li>\n        <li class=\"ms-step\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#111827\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n            <path d=\"M16 11a4 4 0 1 0-8 0\"><\/path><path d=\"M12 15v6\"><\/path><path d=\"M8 21h8\"><\/path><path d=\"M7 8h10\"><\/path>\n          <\/svg>\n          <div>\n            <strong>Live testen & 1:1‑Beratung<\/strong><br>\n            Du probierst die Geräte aus – wir beraten dich persönlich zu Setup, Platz & Training.\n          <\/div>\n        <\/li>\n        <li class=\"ms-step\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#111827\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n            <path d=\"M20 21V7a2 2 0 0 0-2-2h-4l-2-2h-4a2 2 0 0 0-2 2v16\"><\/path><path d=\"M9 13h6\"><\/path><path d=\"M9 17h6\"><\/path><path d=\"M9 9h2\"><\/path>\n          <\/svg>\n          <div>\n            <strong>Individuelles Angebot<\/strong><br>\n            Auf Wunsch erhältst du ein unverbindliches Angebot mit Liefer‑ & Aufbauservice.\n          <\/div>\n        <\/li>\n      <\/ul>\n    <\/div>\n  <\/div>\n\n  <!-- TERMIN -->\n  <div id=\"termin\" class=\"ms-section\">\n    <div class=\"ms-container\">\n      <h2 class=\"ms-h2 reveal\" style=\"margin-bottom:12px;\">Termin vereinbaren<\/h2>\n      <p class=\"reveal\" style=\"margin-bottom:28px;\">Gib uns ein paar Infos – wir melden uns zur Terminbestätigung bei dir. Alternativ erreichst du uns unter <a href=\"tel:+498142448666\">08142 448666<\/a>.<\/p>\n\n      <div class=\"reveal fade-in\" style=\"max-width:600px; margin:0 auto;\">\n        {% form 'contact', id: 'showroom-form' %}\n          {% if form.posted_successfully? %}\n            <div style=\"padding:16px; background:#d1fae5; border-radius:8px; margin-bottom:24px;\">\n              <strong>Vielen Dank!<\/strong> Wir melden uns zeitnah bei dir.\n            <\/div>\n          {% endif %}\n\n          {% if form.errors %}\n            <div style=\"padding:16px; background:#fee2e2; border-radius:8px; margin-bottom:24px;\">\n              <strong>Ups!<\/strong> Bitte überprüfe deine Angaben.\n              <ul style=\"margin-top:8px;\">\n                {% for field in form.errors %}\n                  <li>{{ form.errors.messages[field] }}<\/li>\n                {% endfor %}\n              <\/ul>\n            <\/div>\n          {% endif %}\n\n          <input type=\"hidden\" name=\"contact[tags]\" value=\"Showroom Anfrage\" \/>\n\n          <div style=\"display:flex; flex-direction:column; gap:16px;\">\n            <div>\n              <label for=\"contact-name\">Name *<\/label><br>\n              <input type=\"text\" id=\"contact-name\" name=\"contact[name]\" required style=\"width:100%; padding:12px; border:1px solid #ccc; border-radius:8px;\">\n            <\/div>\n            <div>\n              <label for=\"contact-email\">E-Mail *<\/label><br>\n              <input type=\"email\" id=\"contact-email\" name=\"contact[email]\" required style=\"width:100%; padding:12px; border:1px solid #ccc; border-radius:8px;\">\n            <\/div>\n            <div>\n              <label for=\"contact-phone\">Telefon (optional)<\/label><br>\n              <input type=\"tel\" id=\"contact-phone\" name=\"contact[phone]\" style=\"width:100%; padding:12px; border:1px solid #ccc; border-radius:8px;\">\n            <\/div>\n            <div>\n              <label for=\"contact-datum\">Wunschtermin (optional)<\/label><br>\n              <input type=\"date\" id=\"contact-datum\" name=\"contact[Wunschtermin]\" style=\"width:100%; padding:12px; border:1px solid #ccc; border-radius:8px;\">\n            <\/div>\n            <div>\n              <label for=\"contact-message\">Nachricht (z. B. gewünschte Geräte, Uhrzeit, Ziele)<\/label><br>\n              <textarea id=\"contact-message\" name=\"contact[body]\" rows=\"5\" style=\"width:100%; padding:12px; border:1px solid #ccc; border-radius:8px;\"><\/textarea>\n            <\/div>\n            <div>\n              <button type=\"submit\" style=\"background:#111827; color:#fff; padding:14px 24px; border:none; border-radius:8px; font-weight:600; width:100%;\">Anfrage senden<\/button>\n            <\/div>\n          <\/div>\n        {% endform %}\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- ANREISE -->\n  <div id=\"anreise\" class=\"ms-section\" style=\"background:#f9fafb;\">\n    <div class=\"ms-container\">\n      <h2 class=\"ms-h2 reveal\" style=\"margin-bottom:12px;\">Anreise & Kontakt<\/h2>\n      <p class=\"reveal\"><strong>Adresse:<\/strong> Am Weidegrund 1, 82194 Gröbenzell<br>\n      <strong>Telefon:<\/strong> <a href=\"tel:+498142448666\">08142 \/ 448666<\/a><br>\n      <strong>E‑Mail:<\/strong> <a href=\"mailto:info@motionsports.de\">info@motionsports.de<\/a><\/p>\n\n      <iframe class=\"reveal fade-in\" style=\"width:100%; height:300px; border-radius:12px; border:none;\" loading=\"lazy\" allowfullscreen src=\"https:\/\/www.google.com\/maps?q=Am%20Weidegrund%201%2C%2082194%20Gr%C3%B6benzell&output=embed\"><\/iframe>\n    <\/div>\n  <\/div>\n\n  <!-- IntersectionObserver -->\n  <script>\n    (function(){\n      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n\n      const revealEls = document.querySelectorAll('#ms-showroom .reveal, #ms-showroom .stagger');\n      const io = new IntersectionObserver((entries)=>{\n        entries.forEach(entry=>{\n          if(entry.isIntersecting){\n            entry.target.classList.add('is-visible');\n            io.unobserve(entry.target);\n          }\n        });\n      }, { root: null, rootMargin: '0px 0px -10% 0px', threshold: 0.1 });\n\n      revealEls.forEach(el=>io.observe(el));\n    })();\n  <\/script>\n<\/section>","background_color":"","text_color":""}},"image_with_text_4MYtJz":{"type":"image-with-text","blocks":{"heading_y8EfMG":{"type":"heading","settings":{"heading":"Unsere Excellence-Bodenschutzmatte","heading_size":"h2","heading_html_tag":"p"}},"text_bDXjPC":{"type":"text","settings":{"text":"<p><br\/>Stabilität trifft Komfort: dein Gym verdient exzellenten Bodenschutz - <strong>verfügbar in unserem Showroom!<\/strong><br\/><br\/><\/p>"}},"button_xQLF6D":{"type":"button","settings":{"button_text":"Jetzt entdecken!","button_link":"https:\/\/motionsports.de\/products\/bodenschutzmatte-excellence-1000-x-1000-x-15-mm?variant=52164487020873","button_style":"","button_size":"text-sm md:text-base","button_background_color":"","button_text_color":""}}},"block_order":["heading_y8EfMG","text_bDXjPC","button_xQLF6D"],"name":"t:sections.image-with-text.presets__0.name","settings":{"full_width":false,"remove_bottom_spacing":false,"image":"shopify:\/\/shop_images\/Rubtiler-RRT_mate_premium_1010x1010x15mm_front_cc741510-ae97-4b56-9a55-f06c74e0d7cd.jpg","image_size":"","image_position":"right","image_width":50,"text_alignment":"text-right","background_color":"#f9f9f9",