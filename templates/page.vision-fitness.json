link_text":"View all","link_url":"","background_color":"#f4f4f4","text_color":"#ffffff","heading_color":"#000000"}},"slideshow_mCyLPy":{"type":"slideshow","blocks":{"slide_hYYTBw":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/Stack-Weight-Machines-Vision-Fitness.jpg","content_width_maximum":640,"desktop_content_position":"bottom-right","mobile_content_position":"middle-center","desktop_text_alignment":"default","subheading":"Precision in Every Rep.","heading":"Stack Weight Machines","heading_size":"h2","text":"","hide_text_on_mobile":false,"button_link":"shopify:\/\/collections\/stack-weight-machines","button_text":"Jetzt entdecken!","button_style":"","button_background_color":"","button_text_color":"","background_color":"","color_text":"#FFFFFF","overlay_color":"#000000","overlay_opacity":30,"overlay_type":"solid"}}},"block_order":["slide_hYYTBw"],"name":"t:sections.slideshow.presets__0.name","settings":{"full_width":true,"enable_transparent_header":false,"use_original_media_size":false,"autoplay":true,"speed":5,"height":700,"controls":"arrows","background_animation":"ZoomOut","content_animation":"AppearLineByLine","background_color":"#262626"}},"featured_collection_KMTbNV":{"type":"featured-collection","settings":{"full_width":false,"carousel":true,"products_count":20,"grid_columns":5,"grid_columns_mobile":"2","products":["leg-extension-curl-machine-stack-weight-vision-fitness","butterfly-reverse-stack-weight-machine-vision-fitness","abduktoren-adduktoren-maschine-stack-weight-vision-fitness","beinbeuger-liegend-stack-weight-vision-fitness","leg-press-stack-weight-vision-fitness","brustpresse-stack-weight-vision-fitness","shoulder-press-stack-weight-vision-fitness","dip-klimmzug-maschine-stack-weight-vision-fitness","abdominal-lower-back-machine-stack-weight-vision-fitness","rotary-torso-machine-stack-weight-vision-fitness","multi-hip-trainer-stack-weight-vision-fitness","lateral-raise-machine-stack-weight-vision-fitness","lat-pull-down-stack-weight-vision-fitness","bizeps-trizeps-maschine-stehend-vision-fitness"],"collection":"","subheading":"","heading":"STACK WEIGHT MACHINES.","heading_size":"h2","text_alignment":"text-left","link_text":"View all","link_url":"","background_color":"#f4f4f4","text_color":"#ffffff","heading_color":"#000000"}},"image_with_text_69CkTB":{"type":"image-with-text","blocks":{"heading_7JyNzc":{"type":"heading","settings":{"heading":"Vision Fitness – Hochwertige Fitnessgeräte","heading_size":"h3"}},"text_XD9Gff":{"type":"text","settings":{"text":"<p>Wenn es um die Ausstattung moderner Fitnessräume geht, steht ein Name weltweit für Qualität, Innovation und Zuverlässigkeit: Vision Fitness. Mit über 25 Jahren Erfahrung in der Entwicklung und Herstellung professioneller Fitnessgeräte bietet Vision Fitness durchdachte Lösungen, die perfekt auf die Anforderungen von Studios, Hotels, Firmenfitness, Gesundheitseinrichtungen oder privaten Trainingsräumen abgestimmt sind. <\/p><h4><strong>Warum Vision Fitness?<\/strong><\/h4><p>Vision Fitness kombiniert technisches Know-how mit einem tiefen Verständnis für die Bedürfnisse verschiedener Zielgruppen. Ob ambitionierter Hobbysportler oder gesundheitsbewusster Einsteiger – die Geräte sind so konzipiert, dass sie intuitiv, effektiv und sicher nutzbar sind. Dabei legt Vision Fitness besonderen Wert auf:<\/p><ol><li>Ergonomisches Design für gesundes und gelenkschonendes Training<\/li><li>Hohe Langlebigkeit durch robuste Materialien und präzise Verarbeitung<\/li><li>Einfache Bedienbarkeit für Nutzer jeden Erfahrungsstands<\/li><li>Modulares Gerätekonzept, das sich flexibel an Raum und Budget anpasst<\/li><\/ol><h4><strong>Plate Loaded & Free Weights<\/strong><\/h4><p>Die Plate Loaded-Serie von Vision Fitness bietet kraftvolle Geräte für funktionelles Krafttraining mit Hantelscheiben. Dank offener Bauweise, rutschfester Griffe und stabiler Rahmenkonstruktionen erhalten Nutzer ein sicheres, effektives Trainingserlebnis. Ideal für:<\/p><ul><li>Fortgeschrittene Kraftsportler<\/li><li>Performance-Training im Studio<\/li><li>Ergänzung zum Freihantelbereich<\/li><\/ul><p>Ergänzend dazu bietet Vision Fitness hochwertige Free Weight-Geräte wie Langhantelstationen, Hantelbänke und Racks, die maximale Trainingsfreiheit ermöglichen – bei minimalem Wartungsaufwand.<\/p><h4><strong>Stack Weight Machines<\/strong><\/h4><p>Die geführten Kraftgeräte mit Steckgewichten punkten durch einfache Handhabung, leise Bewegungsabläufe und sichere Trainingsführung. Besonders im betreuten Bereich – etwa in Hotels, Reha-Zentren oder Unternehmensfitness – sind diese Geräte unverzichtbar. Sie bieten:<\/p><ol><li>Intuitive Einstellungsmöglichkeiten<\/li><li>Geräuscharmen Lauf<\/li><li>Kompakte Maße für platzsparende Integration<\/li><li>Hohe Sicherheit bei maximaler Trainingswirkung<\/li><\/ol><h4><strong>Cardiogeräte<\/strong><\/h4><p>Neben Kraftgeräten überzeugt Vision Fitness auch mit innovativen Cardiogeräten:<\/p><ul><li>Laufbänder mit stoßdämpfender Oberfläche<\/li><li>Ergometer mit individuell einstellbaren Sitzpositionen<\/li><li>Crosstrainer mit natürlicher Bewegung<\/li><\/ul><p>Alle Geräte verfügen über benutzerfreundliche Konsolen, moderne Schnittstellen (z. B. Bluetooth, WiFi, Apps) und leistungsfähige Antriebe für dauerhaft reibungslosen Betrieb.<\/p><h4><strong>Vorteile für Betreiber<\/strong><\/h4><p>Wer auf Vision Fitness setzt, profitiert nicht nur von hochwertigen Geräten, sondern auch von wirtschaftlicher Effizienz und hoher Kundenzufriedenheit:<\/p><ul><li>Wartungsarme Technik reduziert Ausfallzeiten<\/li><li>Einheitliches Design für ein professionelles Erscheinungsbild<\/li><li>Skalierbare Ausstattung passend zum Budget und Raumkonzept<\/li><li>Langfristige Ersatzteilverfügbarkeit<\/li><\/ul><p>Ob <strong>Fitnessstudio, Hotelanlage, Unternehmen <\/strong>oder <strong>öffentliche Einrichtung<\/strong> – Vision Fitness bietet individuelle Lösungen für jeden Anspruch. Alle Geräte durchlaufen strenge Qualitäts- und Belastungstests, bevor sie in den Markt gelangen. Das Ziel: Höchste Sicherheit, maximale Trainingswirksamkeit und eine lange Lebensdauer – auch bei täglichem Einsatz unter hoher Belastung.<\/p>"}}},"block_order":["heading_7JyNzc","text_XD9Gff"],"name":"t:sections.image-with-text.presets__0.name","settings":{"full_width":false,"image":"shopify:\/\/shop_images\/Vision-Fitness.jpg","image_size":"","image_position":"right","image_width":25,"text_alignment":"text-left","background_color":"#f4f4f4","text_color":"","heading_color":""}},"featured_collection_f8nLPb":{"type":"featured-collection","disabled":true,"settings":{"full_width":true,"carousel":true,"products_count":8,"grid_columns":4,"grid_columns_mobile":"2","products":[],"collection":"","subheading":"","heading":"Zu den Power-Racks","heading_size":"h2","text_alignment":"text-center","link_text":"View all","link_url":"","background_color":"#f4f4f4","text_color":"","heading_color":""}},"171860865104cc7a9e":{"type":"apps","disabled":true,"settings":{"full_width":true,"remove_horizontal_space":false,"remove_vertical_space":false,"background_color":"","text_color":""}},"shoppable_image_3cefjt":{"type":"shoppable-image","blocks":{"product_wMzyjr":{"type":"product","settings":{"x":25,"y":25,"x_mobile":50,"y_mobile":50,"product":""}},"product_epHyA3":{"type":"product","settings":{"x":80,"y":60,"x_mobile":50,"y_mobile":50,"product":""}}},"block_order":["product_wMzyjr","product_epHyA3"],"disabled":true,"settings":{"full_width":true,"image":"shopify:\/\/shop_images\/atx-prx-710-kamera_2.webp","image_mobile":"shopify:\/\/shop_images\/atx-prx-710_anwendung-kamera_1.webp","subheading":"","heading":"Shop the look","heading_size":"h2","content":"","text_alignment":"text-left","background_color":"","text_color":"","heading_color":"","dot_background_color":""}}},"order":["main","slideshow_77HndR","featured_collection_NDYqEt","slideshow_QidEHW","featured_collection_aTBKYL","slideshow_mCyLPy","featured_collection_KMTbNV","image_with_text_69CkTB"