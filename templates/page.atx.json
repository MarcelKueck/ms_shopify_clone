lection","name":"t:sections.featured-collection.name","settings":{"full_width":true,"carousel":true,"products_count":20,"grid_columns":5,"grid_columns_mobile":"2","products":[],"collection":"neuheiten","subheading":"Jetzt entdecken!","heading":"Neuheiten.","heading_size":"h2","text_alignment":"text-left","link_text":"View all","link_url":"","background_color":"","text_color":"","heading_color":"","heading_html_tag":"p"}},"image_with_text_fMgmNr":{"type":"image-with-text","blocks":{"heading_QGmByG":{"type":"heading","settings":{"heading":"ATX® Fitness Equipment","heading_size":"h3","heading_html_tag":"p"}},"text_hBkVFJ":{"type":"text","settings":{"text":"<p><strong>ATX-Fitness: <\/strong>Wenn Leidenschaft auf Präzision trifft.<br\/><br\/>ATX steht für kompromisslose Qualität, durchdachtes Design und maximale Funktionalität – entwickelt mit deutscher Ingenieurskunst für höchste Ansprüche.<\/p><p>Unsere Philosophie: <strong>„Strength Meets Excellence“<\/strong> – ein Versprechen, das wir mit jedem einzelnen Produkt einlösen. Ob im Profisport, im ambitionierten Home Gym oder im Studioeinsatz: ATX liefert Equipment, das Maßstäbe setzt.<\/p><h3><strong>Warum ATX?<\/strong><\/h3><ol><li>Präzision, auf die Sie sich verlassen können: Von der ersten Skizze bis zum letzten Fertigungsschritt steht bei uns Qualität an oberster Stelle – für maximale Sicherheit, Stabilität und Langlebigkeit.<\/li><li>Jedes Produkt ist so konzipiert, dass es Ihr Training auf das nächste Level hebt – mit intuitiver Handhabung, durchdachten Features und einem Design, das überzeugt.<\/li><li>Egal ob Home-Gym, leistungsstarkes Studio-Setup oder professionelle Wettkampfvorbereitung: ATX bietet modulare und skalierbare Systeme für jedes Trainingsziel.<br\/><\/li><\/ol><h3><strong>Unsere Produkte – Ihre Performance<\/strong><\/h3><p>Ob Power Racks, <a href=\"\/collections\/hantelbank\" target=\"_blank\" title=\"Hantelbank kaufen – Top-Modelle für dein Fitnessstudio\">Hantelbänke<\/a>, <a href=\"\/collections\/kabelzug-cross-over\" target=\"_blank\" title=\"Kabelzug - Cross Over\">Kabelzugstationen <\/a>oder <a href=\"\/collections\/hantelscheiben\" target=\"_blank\" title=\"Hantelscheiben 30 und 50 mm\">Hantelscheiben<\/a>: Unsere breite Produktpalette liefert alles, was Sie für effektives, sicheres und nachhaltiges Training benötigen. Dabei setzen wir konsequent auf geprüfte Qualität, robuste Materialien und modernste Fertigungsstandards.<\/p><p><strong>Stärke beginnt mit dem richtigen Equipment.<\/strong><\/p><p>Entdecken Sie die Welt von <strong>ATX Fitness<\/strong> – und erleben Sie, wie aus „Strength Meets Excellence“ Ihr persönlicher Trainingserfolg wird.<\/p>"}}},"block_order":["heading_QGmByG","text_hBkVFJ"],"settings":{"full_width":false,"remove_bottom_spacing":false,"image":"shopify:\/\/shop_images\/WhatsApp_Bild_2024-11-13_um_13.56.36_9fbea5e5.jpg","image_size":"media--ratio-3-4","image_position":"right","image_width":25,"text_alignment":"text-left","background_color":"#f4f4f4","text_color":"#000000","heading_color":"#000000"}},"171860865104cc7a9e":{"type":"apps","disabled":true,"settings":{"full_width":true,"remove_horizontal_space":false,"remove_vertical_space":false,"background_color":"","text_color":""}},"shoppable_image_3cefjt":{"type":"shoppable-image","blocks":{"product_wMzyjr":{"type":"product","settings":{"x":25,"y":25,"x_mobile":50,"y_mobile":50,"product":""}},"product_epHyA3":{"type":"product","settings":{"x":80,"y":60,"x_mobile":50,"y_mobile":50,"product":""}}},"block_order":["product_wMzyjr","product_epHyA3"],"disabled":true,"settings":{"full_width":true,"image":"shopify:\/\/shop_images\/atx-prx-710-kamera_2.webp","image_mobile":"shopify:\/\/shop_images\/atx-prx-710_anwendung-kamera_1.webp","subheading":"","heading":"Shop the look","heading_size":"h2","content":"","text_alignment":"text-left","background_color":"","text_color":"","heading_color":"","dot_background_color":"","heading_html_tag":"p"}}},"order":["main","slideshow_77HndR","featur